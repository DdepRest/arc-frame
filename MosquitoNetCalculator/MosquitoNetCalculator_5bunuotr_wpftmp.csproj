<Project>
  <PropertyGroup>
    <AssemblyName>MosquitoNetCalculator</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\Asus\Desktop\A.R.C. Frame\gwga\MosquitoNetCalculator\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>MosquitoNetCalculator</_TargetAssemblyProjectName>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Windows.Media.Ocr (System.WindowsRuntime) needs explicit TFM. Pin to
         the 17763 SDK that ships with .NET 8; the project compiles clean. -->
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
    <Version>3.47.4</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Treat every compiler / NuGet warning as an error so the build fails
         closed if any future change reintroduces a warning. The current
         source tree compiles clean (verified after the CS8618 suppress-scope
         fix and UnifyTitle refactor), so enabling this is a zero-cost
         safety net. NU*** package warnings can be silenced per-id via
         <NoWarn> if they ever surface. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- QuestPDF — native PDF generation for КП export. -->
    <PackageReference Include="QuestPDF" Version="2024.7.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>
  <!-- ═══════════════════════════════════════════════════════════════
       Админ-панель: build-time инъекция токена gist (OfficeReportService).

       Репозиторий ПУБЛИЧНЫЙ — токен НЕ может лежать в коде/истории.
       Токен берётся при сборке из:
         1) env var OFFICE_REPORT_TOKEN, либо
         2) локального файла MosquitoNetCalculator/.office-report-token
            (в .gitignore; владелец кладёт туда токен один раз).

       Результат — obj/OfficeReportToken.g.cs (в git не попадает):
         internal static class OfficeReportTokenSource { public const string Token = "..."; }

       Без токена генерируется пустая строка — приложение собирается,
       но отчёты не отправляются (панель показывает «токен не настроен»).
       ═══════════════════════════════════════════════════════════════ -->
  <Target Name="GenerateOfficeReportToken" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <OfficeReportToken>$(OFFICE_REPORT_TOKEN)</OfficeReportToken>
      <OfficeReportToken Condition="'$(OfficeReportToken)' == '' and Exists('$(MSBuildProjectDirectory)\.office-report-token')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\.office-report-token').Trim())</OfficeReportToken>
    </PropertyGroup>
    <ItemGroup>
      <_TokenSourceLines Include="// GENERATED by GenerateOfficeReportToken (csproj). Токен подставляется при сборке из env OFFICE_REPORT_TOKEN или файла .office-report-token (не в git). Не редактировать." />
      <_TokenSourceLines Include="internal static class OfficeReportTokenSource { public const string Token = &quot;$(OfficeReportToken)&quot;%3B }" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)OfficeReportToken.g.cs" Lines="@(_TokenSourceLines)" Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)OfficeReportToken.g.cs" />
    </ItemGroup>
  </Target>
  <!-- Expose `internal` members to the test project so regression tests
       can verify private implementation details (InternalsVisibleTo). -->
  <ItemGroup>
    <InternalsVisibleTo Include="MosquitoNetCalculator.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="prices.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Bundled OCR language data (rus/eng, tessdata_fast). Flattened to
         <output>/tessdata/ so AttachmentOcrService finds it next to the exe;
         the ZIP and the installer ship the same folder. -->
    <Content Include="Resources\tessdata\**" Link="tessdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\update-log.json" />
    <!-- Stage 2 hardening: AiPromptBuilder reads the canonical system
         prompt from an embedded Markdown resource so the prompt body
         is data, not code, and updates/changes review cleanly. -->
    <EmbeddedResource Include="Resources\ai-system-prompt.md" />
  </ItemGroup>
