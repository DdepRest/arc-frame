<Window x:Class="MosquitoNetCalculator.MainWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MosquitoNetCalculator.Controls"
        Title="A.R.C. Frame"
        Width="1200" Height="760"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Closing="MainWindow_Closing"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="{DynamicResource Radius.None}"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- ГОРЯЧИЕ КЛАВИШИ                                          -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Window.InputBindings>
        <!-- Ctrl+S — сохранить заказ -->
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
        <!-- Ctrl+1..5 — навигация -->
        <KeyBinding Key="D1" Modifiers="Control" Command="NavigationCommands.BrowseBack"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="NavigationCommands.BrowseForward"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="NavigationCommands.Search"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="NavigationCommands.Favorites"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="NavigationCommands.GoToPage"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="BtnSaveOrder_Click"/>
        <CommandBinding Command="NavigationCommands.BrowseBack"  Executed="NavCalculation_Click"/>
        <CommandBinding Command="NavigationCommands.BrowseForward" Executed="NavOrders_Click"/>
        <CommandBinding Command="NavigationCommands.Search"      Executed="NavPrices_Click"/>
        <CommandBinding Command="NavigationCommands.Favorites"   Executed="NavUpdates_Click"/>
        <CommandBinding Command="NavigationCommands.GoToPage"    Executed="NavPrint_Click"/>
    </Window.CommandBindings>

    <Window.Resources>
        <!-- Fade-in / fade-out storyboards for UpdateDownloadBar -->
        <Storyboard x:Key="UpdateBarFadeIn">
            <DoubleAnimation Storyboard.TargetName="UpdateDownloadBar"
                             Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="{StaticResource Motion.Slow}">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="UpdateBarFadeOut">
            <DoubleAnimation Storyboard.TargetName="UpdateDownloadBar"
                             Storyboard.TargetProperty="Opacity"
                             To="0.0"
                             Duration="{StaticResource Motion.Slow}">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- NavigationView button style (slide-out labels) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Title}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.Md}" BorderThickness="0"
                                Height="40">
                            <Grid>
                                <!-- Active indicator pill (left edge) -->
                                <Border x:Name="ActivePill" Width="3" Height="16"
                                        Background="{DynamicResource Accent}"
                                        CornerRadius="{DynamicResource Radius.CapsuleSm}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="{DynamicResource Gap.None}" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center"
                                                  Margin="{DynamicResource Gap.None}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay close button style -->
        <Style x:Key="OverlayCloseButton" TargetType="Button">
            <!-- Иконочная кнопка без текста: диктор читал бы только глиф, а UIA-харнесс
                 не мог найти её иначе как по координатам (и промахивался). Один
                 сеттер закрывает все slide-over'ы сразу. -->
            <Setter Property="AutomationProperties.AutomationId" Value="OverlayClose"/>
            <Setter Property="AutomationProperties.Name" Value="Закрыть панель"/>
            <Setter Property="AutomationProperties.HelpText" Value="Закрыть панель без изменений (Escape)"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="Content" Value="&#xE8BB;"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.Md}" BorderThickness="0"
                                Width="32" Height="32">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CUSTOM TITLE BAR                                       -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <controls:TitleBarControl x:Name="TitleBarControl" Grid.Row="0"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- UPDATE DOWNLOAD PROGRESS BAR                             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ProgressBar x:Name="UpdateDownloadBar"
                     Grid.Row="1"
                     Height="3"
                     Minimum="0" Maximum="100"
                     Value="0"
                     Visibility="Collapsed"
                     Opacity="0"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource Accent}"
                     VerticalAlignment="Top"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- MAIN LAYOUT: NAVIGATION VIEW + CONTENT                 -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <!-- ── Content area (Расчёт + overlays) ── -->
            <Grid>
                <!-- ═══════════════════════════════════════ -->
                <!-- PRIMARY: РАСЧЁТ view                    -->
                <!-- ═══════════════════════════════════════ -->
                <Grid x:Name="CalculationView" Background="{DynamicResource AppBg}" Margin="{DynamicResource Gap.CalculationView}">
                    <Grid Margin="{DynamicResource Gap.Window}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- Action bar -->
                            <RowDefinition Height="Auto"/>  <!-- Quick-Add -->
                            <RowDefinition Height="*"/>     <!-- Table -->
                            <RowDefinition Height="Auto"/>  <!-- ИТОГО -->
                            <RowDefinition Height="Auto"/>  <!-- Status bar -->
                        </Grid.RowDefinitions>

                        <!-- ACTION BAR -->
                        <controls:ActionBarControl x:Name="ActionBarControl" Grid.Row="0"/>

                        <!-- QUICK-ADD -->
                        <controls:QuickAddControl x:Name="QuickAddControl" Grid.Row="1"/>

                        <!-- TABLE + EMPTY STATE -->
                        <controls:OrderItemsControl x:Name="OrderItemsControl" Grid.Row="2"/>

                        <!-- ИТОГО -->
                        <controls:TotalCardControl x:Name="TotalCardControl" Grid.Row="3"/>

                        <!-- Status bar: compact order info + dirty indicator -->
                        <Border Grid.Row="4" Margin="{DynamicResource Gap.BlockTop}" Padding="{DynamicResource Pad.ControlSm}"
                                HorizontalAlignment="Stretch" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusOrderInfo" Text="Новый заказ"
                                           FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"/>
                                <Border x:Name="StatusDirtyIndicator" Visibility="Collapsed"
                                        Background="{DynamicResource BadgeWarningBg}"
                                        CornerRadius="{DynamicResource Radius.Capsule}" Padding="{DynamicResource Pad.Pill}" Margin="{DynamicResource Gap.Left}"
                                        ToolTip="Несохранённые изменения (Ctrl+S)">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource BadgeWarningFg}"
                                                 VerticalAlignment="Center" Margin="{DynamicResource Gap.InlineSm}"/>
                                        <TextBlock Text="Есть изменения" FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BadgeWarningFg}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Undo/Redo hint -->
                                <TextBlock x:Name="UndoRedoHint" Visibility="Collapsed"
                                           FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center" Margin="{DynamicResource Gap.LeftLg}"
                                           ToolTip="Ctrl+Z — отменить последнее действие, Ctrl+Y — повторить"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- OVERLAY: ЗАКАЗЫ                         -->
                <!-- ═══════════════════════════════════════ -->
                <Grid x:Name="OrdersOverlay" Visibility="Collapsed" Panel.ZIndex="15">
                    <!-- Backdrop -->
                    <Border x:Name="OrdersBackdrop" Background="{DynamicResource Scrim}" Opacity="0"
                            MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" Cursor="Hand"/>
                    <!-- Content panel (slides from right) -->
                    <!-- Ширина: НЕ жёсткая (Width=800 обрезала «Обновлено» краем
                         экрана на узких окнах) — до 800 с ужатием вниз. MinWidth
                         страхует от сжатия в ноль на маленьких мониторах. -->
                    <Border x:Name="OrdersPanel"
                            Background="{DynamicResource Surface}"
                            HorizontalAlignment="Right" MaxWidth="800" MinWidth="360"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="OrdersSlideTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header -->
                            <!-- UX-15: shared OverlayHeader style (was 5 inline attributes × 8 copies) -->
                            <Border Grid.Row="0" Style="{StaticResource OverlayHeader}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE71D;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="Заказы" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <!-- Orders-count badge: chip-style tag next to «Заказы» title.
                                             Previously a flat gray TextBlock on gray header background —
                                             near-invisible ("плохо отображается"). Now an actual chip with
                                             ChipBg (light blue) + Accent bold text + CornerRadius 10, so
                                             the count stands out visually, exactly as the user expects. -->
                                        <Border x:Name="OrdersCountBadge"
                                                Background="{DynamicResource ChipBg}" CornerRadius="{DynamicResource Radius.Capsule}"
                                                Padding="{DynamicResource Pad.Pill}" Margin="{DynamicResource Gap.Left}"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="OrdersCountText" Text=""
                                                       FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Style="{StaticResource OverlayCloseButton}"
                                            HorizontalAlignment="Right" Click="CloseOverlay_Click"/>
                                </Grid>
                            </Border>
                            <!-- Content -->
                            <controls:OrdersHistoryControl x:Name="OrdersHistoryControl" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- OVERLAY: ЦЕНЫ                           -->
                <!-- ═══════════════════════════════════════ -->
                <Grid x:Name="PricesOverlay" Visibility="Collapsed" Panel.ZIndex="15">
                    <Border x:Name="PricesBackdrop" Background="{DynamicResource Scrim}" Opacity="0"
                            MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" Cursor="Hand"/>
                    <Border x:Name="PricesPanel"
                            Background="{DynamicResource Surface}"
                            HorizontalAlignment="Right" MaxWidth="800" MinWidth="360"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PricesSlideTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- UX-15: shared OverlayHeader style (was 5 inline attributes × 8 copies) -->
                            <Border Grid.Row="0" Style="{StaticResource OverlayHeader}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8C7;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="Цены" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource OverlayCloseButton}"
                                             HorizontalAlignment="Right" Click="CloseOverlay_Click"/>
                                </Grid>
                            </Border>
                            <controls:PricesControl x:Name="PricesControl" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- OVERLAY: ОБНОВЛЕНИЯ                     -->
                <!-- ═══════════════════════════════════════ -->
                <Grid x:Name="UpdatesOverlay" Visibility="Collapsed" Panel.ZIndex="15">
                    <Border x:Name="UpdatesBackdrop" Background="{DynamicResource Scrim}" Opacity="0"
                            MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" Cursor="Hand"/>
                    <Border x:Name="UpdatesPanel"
                            Background="{DynamicResource Surface}"
                            HorizontalAlignment="Right" MaxWidth="800" MinWidth="360"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="UpdatesSlideTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- UX-15: shared OverlayHeader style (was 5 inline attributes × 8 copies) -->
                            <Border Grid.Row="0" Style="{StaticResource OverlayHeader}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE81C;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="Обновления" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource OverlayCloseButton}"
                                            HorizontalAlignment="Right" Click="CloseOverlay_Click"/>
                                </Grid>
                            </Border>
                            <controls:UpdatesTabControl Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- OVERLAY: АДМИН-ПАНЕЛЬ                  -->
                <!-- ═══════════════════════════════════════ -->
                <Grid x:Name="AdminOverlay" Visibility="Collapsed" Panel.ZIndex="15">
                    <Border x:Name="AdminBackdrop" Background="{DynamicResource Scrim}" Opacity="0"
                            MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" Cursor="Hand"/>
                    <Border x:Name="AdminPanel"
                            Background="{DynamicResource Surface}"
                            HorizontalAlignment="Right" Width="760"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="AdminSlideTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- UX-15: shared OverlayHeader style (was 5 inline attributes × 8 copies) -->
                            <Border Grid.Row="0" Style="{StaticResource OverlayHeader}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="Админ-панель" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource OverlayCloseButton}"
                                             HorizontalAlignment="Right" Click="CloseOverlay_Click"/>
                                </Grid>
                            </Border>
                            <controls:AdminPanelControl x:Name="AdminPanelControl" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- OVERLAY: ОТКОСЫ                        -->
                <!-- ═══════════════════════════════════════ -->
                <Grid x:Name="SlopeOverlay" Visibility="Collapsed" Panel.ZIndex="15">
                    <Border x:Name="SlopeBackdrop" Background="{DynamicResource Scrim}" Opacity="0"
                            MouseLeftButtonDown="BackdropSlope_MouseLeftButtonDown" Cursor="Hand"/>
                    <Border x:Name="SlopePanel"
                            Background="{DynamicResource Surface}"
                            HorizontalAlignment="Right" Width="860" MaxWidth="920" MinWidth="720"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SlopeSlideTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header -->
                            <!-- UX-15: shared OverlayHeader style (was 5 inline attributes × 8 copies) -->
                            <Border Grid.Row="0" Style="{StaticResource OverlayHeader}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE91B;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="Откосы из сэндвича" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource OverlayCloseButton}"
                                            HorizontalAlignment="Right" Click="CloseOverlay_Click"/>
                                </Grid>
                            </Border>
                            <!-- Content -->
                            <controls:SlopePanelControl x:Name="SlopePanelControl" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- OVERLAY: AI ASSISTANT                  -->
                <!-- ══════════════════════════════════════════════════ -->
                <Grid x:Name="AiOverlay" Visibility="Collapsed" Panel.ZIndex="15"
                      HorizontalAlignment="Right" Width="480">
                    <Border x:Name="AiPanel"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="AiSlideTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- UX-15: shared OverlayHeader style (was 5 inline attributes × 8 copies) -->
                            <Border Grid.Row="0" Style="{StaticResource OverlayHeader}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE99A;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="AI Ассистент" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                        <Border CornerRadius="{DynamicResource Radius.Capsule}" Padding="{DynamicResource Pad.ControlSm}" Margin="{DynamicResource Gap.Left}"
                                                Background="{DynamicResource BadgeWarningBg}"
                                                BorderBrush="{DynamicResource BadgeWarningFg}" BorderThickness="1"
                                                ToolTip="AI-функции находятся в стадии тестирования">
                                            <TextBlock Text="BETA" FontSize="{StaticResource Type.Monogram}" FontWeight="Bold"
                                                       Foreground="{DynamicResource BadgeWarningFg}"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource OverlayCloseButton}"
                                            HorizontalAlignment="Right" Click="CloseAiOverlay_Click"/>
                                </Grid>
                            </Border>
                            <controls:AiAssistantControl x:Name="AiAssistantControl" Grid.Row="1"
                                                         DataContext="{Binding AiVm}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- OVERLAY: ДАННЫЕ ЗАКАЗА (sidebar)        -->
                <!-- ═══════════════════════════════════════ -->
                <Grid x:Name="SidebarOverlay" Visibility="Collapsed" Panel.ZIndex="15">
                    <Border x:Name="SidebarBackdrop" Background="{DynamicResource Scrim}" Opacity="0"
                            MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" Cursor="Hand"/>
                    <Border x:Name="SidebarPanel"
                            Background="{DynamicResource Surface}"
                            HorizontalAlignment="Right" Width="340"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SidebarSlideTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- UX-15: shared OverlayHeader style (was 5 inline attributes × 8 copies) -->
                            <Border Grid.Row="0" Style="{StaticResource OverlayHeader}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE77B;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="Заказчик" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource OverlayCloseButton}"
                                            HorizontalAlignment="Right" Click="CloseOverlay_Click"/>
                                </Grid>
                            </Border>
                            <controls:SidebarControl x:Name="SidebarControl" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════ -->
                <!-- OVERLAY: ПЕЧАТЬ                        -->
                <!-- ═══════════════════════════════════════ -->
                <Grid x:Name="PrintOverlay" Visibility="Collapsed" Panel.ZIndex="15">
                    <Border x:Name="PrintBackdrop" Background="{DynamicResource Scrim}" Opacity="0"
                            MouseLeftButtonDown="Backdrop_MouseLeftButtonDown" Cursor="Hand"/>
                    <Border x:Name="PrintPanel"
                            Background="{DynamicResource Surface}"
                            HorizontalAlignment="Right"
                            BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PrintSlideTransform" X="0"/>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header -->
                            <!-- UX-15: shared OverlayHeader style (was 5 inline attributes × 8 copies) -->
                            <Border Grid.Row="0" Style="{StaticResource OverlayHeader}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7B3;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="Печать КП" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource OverlayCloseButton}"
                                            HorizontalAlignment="Right" Click="CloseOverlay_Click"/>
                                </Grid>
                            </Border>
                            <!-- Content: PrintPreviewControl -->
                            <controls:PrintPreviewControl x:Name="PrintPreviewControl" Grid.Row="1"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── NavigationView (fixed expanded panel; optionally collapsible) ── -->
                <Border x:Name="NavPanel"
                        HorizontalAlignment="Left" Width="160"
                        Panel.ZIndex="16"
                        Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                        ClipToBounds="True"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel VerticalAlignment="Top" Margin="{DynamicResource Gap.NavCluster}">
                        <!-- Explicit toggle: the panel stays expanded until the user collapses it. -->
                        <Button x:Name="BtnToggleNav" Style="{StaticResource NavButton}"
                                ToolTip="Свернуть панель навигации" Click="BtnToggleNav_Click"
                                Margin="{DynamicResource Gap.Block}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Segoe MDL2 Assets: GlobalNavigationButton. The literal ☰
                                         rendered as a missing-glyph square on some Windows font setups. -->
                                    <TextBlock Text="&#xE700;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Subtitle}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"/>
                                </Grid>
                                <TextBlock x:Name="NavToggleLabel" Grid.Column="1" Text="Свернуть" Margin="{DynamicResource Gap.LeftSm}"
                                           FontSize="{StaticResource Type.Body}" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Text}"/>
                            </Grid>
                        </Button>
                        <!-- v3.50: navigation groups (prototype sidebar) -->
                        <TextBlock x:Name="NavGroupMain" Text="ОСНОВНОЕ"
                                   FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold" FontFamily="{DynamicResource Font.Text}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="{DynamicResource Gap.NavSection}"/>
                        <!-- Расчёт -->
                        <Button x:Name="NavBtnCalc" Style="{StaticResource NavButton}"
                                ToolTip="Расчёт (Ctrl+1)" Click="NavButton_Click" Tag="Calc">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavIconCalc" Text="&#xE1D0;"
                                               FontSize="{StaticResource Type.TitleLg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="NavLabelCalc" Grid.Column="1" Text="Расчёт" Opacity="1"
                                           Margin="{DynamicResource Gap.LeftSm}" FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Text}"/>
                            </Grid>
                        </Button>
                        <!-- Заказы -->
                        <Button x:Name="NavBtnOrders" Style="{StaticResource NavButton}"
                                ToolTip="Заказы (Ctrl+2)" Click="NavButton_Click" Tag="Orders" Margin="{DynamicResource Gap.BlockTop}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavIconOrders" Text="&#xE71D;"
                                               FontSize="{StaticResource Type.TitleLg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="NavLabelOrders" Grid.Column="1" Text="Заказы" Opacity="1"
                                           Margin="{DynamicResource Gap.LeftSm}" FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Text}"/>
                            </Grid>
                        </Button>
                        <!-- Цены -->
                        <Button x:Name="NavBtnPrices" Style="{StaticResource NavButton}"
                                ToolTip="Цены (Ctrl+3)" Click="NavButton_Click" Tag="Prices" Margin="{DynamicResource Gap.BlockTop}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavIconPrices" Text="&#xE8C7;"
                                               FontSize="{StaticResource Type.TitleLg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="NavLabelPrices" Grid.Column="1" Text="Цены" Opacity="1"
                                           Margin="{DynamicResource Gap.LeftSm}" FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Text}"/>
                            </Grid>
                        </Button>
                        <!-- Откосы (v3.50: в группе «Основное» — пользовательское требование) -->
                        <Button x:Name="NavBtnSlope" Style="{StaticResource NavButton}"
                                ToolTip="Откосы из сэндвича — калькулятор" Click="NavSlope_Click" Tag="Slope" Margin="{DynamicResource Gap.BlockTop}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavIconSlope" Text="&#xE91B;"
                                               FontSize="{StaticResource Type.TitleLg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Автоматический просчёт откосов. -->
                                <TextBlock x:Name="NavLabelSlope" Grid.Column="1" Text="Авто · Откосы" Opacity="1"
                                           Margin="{DynamicResource Gap.LeftSm}" FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Text}"/>
                            </Grid>
                        </Button>
                        <!-- Печать -->
                        <Button x:Name="NavBtnPrint" Style="{StaticResource NavButton}"
                                ToolTip="Печать (Ctrl+5)" Click="NavButton_Click" Tag="Print" Margin="{DynamicResource Gap.BlockTop}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavIconPrint" Text="&#xE7B3;"
                                               FontSize="{StaticResource Type.TitleLg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="NavLabelPrint" Grid.Column="1" Text="Печать" Opacity="1"
                                           Margin="{DynamicResource Gap.LeftSm}" FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Text}"/>
                            </Grid>
                        </Button>
                        <!-- Служебное -->
                        <TextBlock x:Name="NavGroupService" Text="СЛУЖЕБНОЕ"
                                   FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold" FontFamily="{DynamicResource Font.Text}"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="{DynamicResource Gap.NavSectionLg}"/>
                        <!-- Обновления -->
                        <Button x:Name="NavBtnUpdates" Style="{StaticResource NavButton}"
                                ToolTip="Обновления (Ctrl+4)" Click="NavButton_Click" Tag="Updates" Margin="{DynamicResource Gap.BlockTop}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavIconUpdates" Text="&#xE81C;"
                                               FontSize="{StaticResource Type.TitleLg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="NavUpdatesDot" Width="8" Height="8" Fill="{DynamicResource NotificationDot}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="{DynamicResource Gap.BadgeOffset}" Visibility="Collapsed"
                                             ToolTip="Доступна новая версия!"/>
                                </Grid>
                                <TextBlock x:Name="NavLabelUpdates" Grid.Column="1" Text="Обновления" Opacity="1"
                                           Margin="{DynamicResource Gap.LeftSm}" FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Text}"/>
                            </Grid>
                        </Button>
                        <!-- AI Ассистент -->
                        <Button x:Name="NavBtnAi" Style="{StaticResource NavButton}"
                                ToolTip="AI Ассистент" Click="NavAi_Click" Tag="AI" Margin="{DynamicResource Gap.BlockTop}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="NavIconAi" Text="&#xE99A;"
                                               FontSize="{StaticResource Type.TitleLg}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{DynamicResource Gap.BlockSm}"/>
                                    <TextBlock Text="AI" FontSize="{StaticResource Type.Monogram}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                               Foreground="{DynamicResource Accent}"/>
                                </Grid>
                                <TextBlock x:Name="NavLabelAi" Grid.Column="1" Opacity="1"
                                           Margin="{DynamicResource Gap.LeftSm}" FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource Font.Text}">
                                    <Run Text="AI"/>
                                    <Run Text="  BETA" FontSize="{StaticResource Type.Monogram}" FontWeight="Bold"
                                         Foreground="{DynamicResource BadgeWarningFg}"/>
                                </TextBlock>
                            </Grid>
                        </Button>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Toast notification container — overlays on top of everything.
             No IsHitTestVisible=False: WPF hit-testing prunes the whole subtree at
             this level, breaking every toast button (persistent update toast with
             «Обновить»/«Позже» is the most visible victim). Background is null, so
             empty-canvas click-through still works. -->
        <Grid x:Name="ToastCanvas" Grid.Row="2" Panel.ZIndex="20"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              ClipToBounds="True"/>
    </Grid>
</Window>
