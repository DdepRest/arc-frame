<Application x:Class="MosquitoNetCalculator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MosquitoNetCalculator.Converters"
             ShutdownMode="OnExplicitShutdown"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Brushes first: styles reference brushes via DynamicResource —
                     they must be loaded before styles. -->
                <ResourceDictionary Source="Themes/Brushes.xaml"/>
                <!-- Focus visual: loaded early so all subsequent style dictionaries
                     can reference FluentFocusVisual via StaticResource. -->
                <ResourceDictionary Source="Themes/FocusVisualStyles.xaml"/>
                <!-- Design tokens v3.53.0: шкалы отступов, радиусов, типографики
                     и движения. Грузятся ДО стилей: стили и разметка берут их
                     через DynamicResource. Контракт и правила — в
                     docs/specs/design-system-v3.53.md; расхождения ловят тесты
                     DesignTokenGuardTests. -->
                <ResourceDictionary Source="Themes/Tokens.Spacing.xaml"/>
                <ResourceDictionary Source="Themes/Tokens.Radius.xaml"/>
                <ResourceDictionary Source="Themes/Tokens.Typography.xaml"/>
                <ResourceDictionary Source="Themes/Tokens.Motion.xaml"/>
                <!-- Base/dependency-free styles -->
                <ResourceDictionary Source="Themes/CardStyles.xaml"/>
                <ResourceDictionary Source="Themes/FontStyles.xaml"/>
                <ResourceDictionary Source="Themes/TabStyles.xaml"/>
                <ResourceDictionary Source="Themes/ButtonStyles.xaml"/>
                <ResourceDictionary Source="Themes/InputStyles.xaml"/>
                <ResourceDictionary Source="Themes/DataGridStyles.xaml"/>
                <!-- п.2: Fluent RadioButton style (implicit, без x:Key → подхватывается глобально). -->
                <ResourceDictionary Source="Themes/InputStyles.RadioButton.xaml"/>
                <ResourceDictionary Source="Themes/ScrollViewerStyles.xaml"/>
                <ResourceDictionary Source="Themes/ContextMenuStyles.xaml"/>
                <!-- После ButtonStyles: EmptyState.Action наследует GhostButton
                     через BasedOn StaticResource. -->
                <ResourceDictionary Source="Themes/EmptyStateStyles.xaml"/>
                <ResourceDictionary Source="Themes/MiscStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!-- CONVERTERS — used via StaticResource, never change     -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <conv:DimensionConverter x:Key="DimConv"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:StatusToBadgeBackgroundConverter x:Key="StatusToBadgeBg"/>
            <conv:StatusToBadgeForegroundConverter x:Key="StatusToBadgeFg"/>
            <conv:MoneyConverter x:Key="MoneyConv"/>
            <conv:QuantityConverter x:Key="QtyConv"/>
            <conv:RussianDateConverter x:Key="RussianDateConv"/>
            <conv:UpdateTypeToBrushConverter x:Key="UpdateTypeBrush"/>
            <conv:UpdateTypeToIconConverter x:Key="UpdateTypeIcon"/>
            <conv:IsMyVersionConverter x:Key="IsMyVersion"/>
            <conv:OfficeStatusToBadgeBackgroundConverter x:Key="OfficeStatusBadgeBg"/>
            <conv:OfficeStatusToBadgeForegroundConverter x:Key="OfficeStatusBadgeFg"/>
            <conv:OfficeStatusToStripeBrushConverter x:Key="OfficeStatusStripeBrush"/>
            <conv:UnbindModeToVisibilityConverter x:Key="UnbindModeToVisibility"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:BoolVisibilityConverter x:Key="BoolVisibility"/>
            <conv:InverseBoolVisibilityConverter x:Key="InverseBoolVisibility"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
