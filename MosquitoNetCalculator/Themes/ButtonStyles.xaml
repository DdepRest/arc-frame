<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- BUTTONS — all calm, proportional                        -->
        <!-- ═══════════════════════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ACTION BUTTONS — единый стеклянный хром                 -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Все action-кнопки делят ОДИН шаблон: различаются только
             цветами, поэтому hover/press/disabled/focus не расходятся
             между вариантами. «Стекло» здесь — 1px спекулярная кромка
             (GlassSpecularBorder) + тематическая плашка, без белой
             плёнки поверх текста: белый 15% на Accent #3574C3 давал
             ≈3.6:1 с белым текстом (AA — 4.5:1). -->
        <ControlTemplate x:Key="GlassButtonTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="False">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- База: метрики, курсор, клавиатурный фокус и общий шаблон. -->
        <Style x:Key="ActionButtonBase" TargetType="Button">
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="Template" Value="{StaticResource GlassButtonTemplate}"/>
        </Style>

        <!-- Primary — Windows 11 Fluent blue -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPress}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success — Fluent green -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource Success}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnSuccess}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Danger — Fluent red -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource Danger}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CompactAdd — «Добавить» в Quick-Add -->
        <Style x:Key="CompactAddButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentPrimary}"/>
            <Setter Property="Padding" Value="16,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPress}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost — Fluent secondary, neutral -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource GhostBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GhostBorder}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowAltHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- SubtleActionButton — Fluent subtle button -->
        <Style x:Key="SubtleActionButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowAltHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DangerSubtleButton — спокойная кнопка, опасность включается на hover -->
        <Style x:Key="DangerSubtleButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerLight}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerGhostBorder}"/>
                    <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DangerGhostButton — деструктивное вторичное действие в диалогах -->
        <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerGhostBorder}"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerLight}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Danger}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DangerLight}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- AccentBorderButton — outlined accent (админ-панель) -->
        <Style x:Key="AccentBorderButton" TargetType="Button" BasedOn="{StaticResource ActionButtonBase}">
            <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentPrimary}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPress}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPress}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- x row delete — Fluent -->
        <Style x:Key="DeleteRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BorderHover}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.BodyLg}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}}" CornerRadius="{DynamicResource Radius.Sm}"
                                SnapsToDevicePixels="False">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DialogOutlineButton — outlined dialog action button (Отмена/Сброс).
             Shared: used by AiApiKeyDialog AND the AI plan card in
             AiAssistantControl, so it must live in the app theme dictionary,
             not in any single window's local resources. -->
        <Style x:Key="DialogOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GhostBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GhostBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                SnapsToDevicePixels="False">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RowHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource RowAltHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DialogPrimaryButton — accent action button (Сохранить), based on
             DialogOutlineButton. Must stay AFTER DialogOutlineButton in this
             dictionary: StaticResource BasedOn needs the base defined first. -->
        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogOutlineButton}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                SnapsToDevicePixels="False">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="{DynamicResource AccentPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FlatIconButton — utility style for icon-only buttons that should
          render with NO chrome whatsoever (no border, no background pill,
          no light-blue button fill that the default WPF Button template
          shows through in dark / Win10 themes).

          Default padding is 0 so the icon sits flush with the bounds the
          consumer sets via Width/Height. Foreground is NOT preset — callers
          bind or set it directly (e.g. {Binding InstallationForegroundColor}).

          Hover dim (Opacity 0.65) and disabled dim (Opacity 0.35) replace
          the chrome-based hover/disabled visuals; the icon stays the only
          thing the user sees.

          v3.47.1: вынесен из inline-стиля колонки «Монтаж» в OrderItemsControl.
          Применять там, где кнопка должна показывать только глиф/иконку/символ
          без рамки или подсветки фона (V/X/B в «Монтаж», и любые будущие
          иконочные кнопки в гриде).
        -->
        <Style x:Key="FlatIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.65"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- DIALOG CLOSE BUTTON — shared chrome for all custom windows   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- UX-14: previously ~10 windows each carried a private copy of this
             60-line template (some with animated hover, some with instant —
             visually inconsistent). One keyed style is now the single source;
             dialogs reference it via Style="{StaticResource DialogCloseButton}".
             Size stays consumer-set (Width/Height), Foreground follows the
             window's TextPrimary and turns white over the red hover overlay. -->
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="ToolTip" Value="Закрыть (Escape)"/>
            <!-- Один сеттер закрывает доступность сразу у ~10 диалогов: раньше
                 у кнопки-крестика не было ни имени для экранного диктора, ни
                 стабильного имени для UIA-харнесса (он ищет элементы по имени). -->
            <Setter Property="AutomationProperties.Name" Value="Закрыть"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                SnapsToDevicePixels="False">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
                                <Setter TargetName="CloseBd" Property="Background" Value="{DynamicResource Danger}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource OnDanger}"/>
                                <Setter TargetName="CloseBd" Property="Background" Value="{DynamicResource DangerHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CloseBd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- TOAST ACTION & CLOSE BUTTONS                             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Style x:Key="ToastActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="{DynamicResource Pad.ControlSmH}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="False">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToastCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="Закрыть"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                SnapsToDevicePixels="False">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerLight}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
