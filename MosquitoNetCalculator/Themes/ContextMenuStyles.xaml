<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- CONTEXT MENU — Fluent Design                            -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Шрифт задаётся ЗДЕСЬ, а не наследуется от окна: контекстное
             меню живёт в отдельном Popup-дереве, до него не достаёт ни
             стиль Window.Shared (MiscStyles), ни семантические стили
             FontStyles. Без этого срабатывает умолчание Control.FontFamily
             = SystemFonts.MessageFontFamily, и меню рисуется системным
             Segoe UI, пока весь остальной интерфейс — вшитым Inter
             (замер: строка «Открыть заказ» 78px вместо 87px). Разбор —
             GOTCHAS §29, страж — PopupTypographyTests. -->
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Text}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{DynamicResource Pad.ControlSm}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                SnapsToDevicePixels="True"
                                Margin="{DynamicResource Gap.BlockTopSm}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="True"
                                          Padding="{DynamicResource Pad.None}">
                                <StackPanel IsItemsHost="True"
                                            Grid.IsSharedSizeScope="True"
                                            ClipToBounds="True"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FontFamily и здесь: пункты подменю (MenuItem внутри MenuItem)
             получают контейнеры в своём ItemsHost, и опираться только на
             наследование от корня меню нельзя. -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="Padding" Value="{DynamicResource Pad.Row}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent"
                                CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.SeparatorH}"
                                Padding="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGesture"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <TextBlock x:Name="GestureText"
                                           Grid.Column="1"
                                           Text="{TemplateBinding InputGestureText}"
                                           Margin="{DynamicResource Gap.LeftXl}"
                                           VerticalAlignment="Center"
                                           FontSize="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource TextMuted}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MenuItemPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                            <Trigger Property="InputGestureText" Value="">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="InputGestureText" Value="{x:Null}">
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- TEXTBOX CONTEXT MENU — Cut, Copy, Paste                 -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ContextMenu x:Key="FluentTextBoxContextMenu">
            <MenuItem Command="ApplicationCommands.Cut"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Вырезать" InputGestureText="Ctrl+X"/>
            <MenuItem Command="ApplicationCommands.Copy"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Копировать" InputGestureText="Ctrl+C"/>
            <MenuItem Command="ApplicationCommands.Paste"
                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      Header="Вставить" InputGestureText="Ctrl+V"/>
        </ContextMenu>
</ResourceDictionary>
