<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ICONS — Segoe Fluent Icons typography                    -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Style x:Key="FluentIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FluentIconTab" TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <Style x:Key="FluentIconSection" TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>

        <Style x:Key="FluentIconButton" TargetType="TextBlock" BasedOn="{StaticResource FluentIcon}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- TEXT STYLES — Fluent                                    -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- TYPOGRAPHY SCALE — UX-16                                -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Minimum readable sizes: WPF renders at 96 DPI logical px; 10px
             regular text is the practical floor for the audience (mostly
             40+ installers). Use these tokens instead of raw FontSize
             numbers so future screens stay consistent.

             Floor rules (UX-16):
             - 11px  — smallest allowed for real text (captions, hints)
             - 10px  — allowed ONLY for ALL-CAPS section labels (SectionLabel
                       above) and icon glyphs, never for sentences
             - <10px — banned for text; badge letters (BETA/OR/NV/USER) keep
                       their sizes as intentional monogram styling -->
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
</ResourceDictionary>
