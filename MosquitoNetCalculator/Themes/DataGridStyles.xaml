<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ROW HOVER EASING — shared by all DataGridRow animations   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <CubicEase x:Key="RowEase" EasingMode="EaseOut"/>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- DATA GRID — Windows 11 Fluent Design                    -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- ── Плотность (v3.53.1, замеры — GOTCHAS §25) ────────────────
                 Строка держится НЕ текстом: 12px Inter даёт строку текста
                 14,4px, а пол строки задают элементы управления — включаемый
                 тумблер 20px и кнопка «Вкл» 20px в клетке «Монтаж». 32px были
                 произволом: 55% строки — пустота. 26px = содержимое 21px +
                 5px воздуха, и это ровно высота шапки (симметрия полос). -->
            <Setter Property="MinRowHeight" Value="26"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource RowAlt}"/>
            <Setter Property="RowBackground" Value="{DynamicResource Surface}"/>
            <!-- Шапка НЕ ВЫШЕ строк: 36px против 32px давали перевёрнутую
                 иерархию — самая «жирная» полоса несла самую мелкую подпись.
                 26px = подпись 11px (Type.Caption, пол шкалы) + 8px паддинга. -->
            <Setter Property="ColumnHeaderHeight" Value="26"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="ScrollViewer.Padding" Value="0"/>
            <!-- UX-04 fix: Auto instead of Hidden — the scrollbar thumb is
                 now always faintly visible (see ScrollViewerStyles.xaml), so
                 users can tell when a grid has more rows below. Layout cost
                 is zero: the ultra-thin 6px overlay style doesn't reserve a
                 gutter column. -->
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <!-- v3.53.1: 10.5px был ниже пола шкалы (11px) и тянул долг
                 дробных размеров; Type.Caption — тот же вид, но законно. -->
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HeaderBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border x:Name="Bd"
                                Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{Binding Padding, RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{DynamicResource Radius.Element}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                                  VerticalAlignment="Center"/>
                                <!-- UX-11: explicit sort indicator — the old template had
                                     no glyph at all, so a sorted column was indistinguishable
                                     from an unsorted one. Shown only while SortDirection > None. -->
                                <TextBlock x:Name="SortGlyph" Grid.Column="1"
                                           FontFamily="{DynamicResource Font.Icon}"
                                           FontSize="11"
                                           Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,0,0"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HeaderPress}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortGlyph" Property="Text" Value="&#xE70E;"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="SortGlyph" Property="Text" Value="&#xE70D;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <!--
          OrderRow — animated hover/select style for the OrderGrid in the
          "Расчёт" tab. Subtle ColorAnimation on the row background, no glow,
          no transform. Apply via DataGrid.RowStyle="{StaticResource OrderRow}".

          INVARIANT: the OrderGrid must keep RowBackground="Transparent" (and
          AlternatingRowBackground="Transparent"), because the ColorAnimation
          targets (Background).(SolidColorBrush.Color) and only works when no
          higher-priority brush overrides the row's Background.
        -->
        <Style x:Key="OrderRow" TargetType="DataGridRow">
            <!-- No Background setter here on purpose: WPF auto-freezes every
                 Freezable set via a Style.Setter, so a SolidColorBrush from
                 here would be frozen and the ColorAnimation in the triggers
                 below would crash with "Cannot animate on a freezable".
                 The brush is set per-row in MainWindow.OrderGrid_LoadingRow,
                 which gives a fresh, mutable SolidColorBrush per row instance
                 and beats the style's frozen brush (local value > style).

                 IsSelected visual: the WPF default DataGridRow ControlTemplate
                 paints selected rows with SystemColors.HighlightBrush — in
                 dark theme that resolves to a near-white bar that wipes out
                 the row content. Template triggers beat style triggers in
                 WPF's trigger precedence, so a plain Style.Trigger for
                 IsSelected would NOT override it — hence the custom Template.

                 UX-01 fix: the template now DOES render selection, but with
                 the design token RowAltSelected (muted blue tint) instead of
                 SystemColors — visible in both themes, no white bar. The
                 setter targets the Border's Background, NOT the row's
                 Background property, so the code-behind hover animation
                 (which animates the row's own mutable brush) keeps working:
                 while selected the Border ignores the animated brush, and on
                 deselect the TemplateBinding resumes. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                <Border x:Name="DGR_RowBorder" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Element}">
                    <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_RowBorder" Property="Background" Value="{DynamicResource RowAltSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Inactive rows stay at 0.45 opacity, just like before. -->
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </DataTrigger>
                <!--
                  Hover animation is handled in CODE-BEHIND
                  (MainWindow.OrderRow_MouseEnter / _MouseLeave), not here.

                  Why not in XAML: a ColorAnimation's `To` property is a CLR
                  property, not a DependencyProperty, so {StaticResource
                  RowHoverColor} is resolved ONCE at XAML parse time and
                  baked into the animation. ThemeService updates the
                  RowHoverColor Color resource at runtime, but the animation
                  never re-reads it — so after a theme switch, hovering a
                  row animates to whatever the light-theme RowHoverColor was
                  at app startup, producing a "white bar on dark theme" bug.

                  The code-behind handlers read the current resource value
                  at trigger time, so the animation always uses the
                  current theme's hover color. The per-row brush from
                  OrderGrid_LoadingRow is still the mutable target.
                -->
            </Style.Triggers>
        </Style>

        <!--
          OrdersRow — animated hover style for the OrdersList in the
          "Заказы" tab. Same approach as OrderRow (custom Template + code- behind
          Opacity fade), but the per-row brush starts invisible so the
          alternating RowBackground / AlternatingRowBackground from the
          DataGrid shows through when not hovered. The WPF default Template's
          IsSelected trigger (SystemColors.HighlightBrush — "white bar" in
          dark theme) is replaced by a RowAltSelected tint (UX-01), same
          pattern as OrderRow.
        -->
        <Style x:Key="OrdersRow" TargetType="DataGridRow">
            <!-- Same frozen-brush rationale as OrderRow: the per-row brush
                 comes from MainWindow.OrdersList_LoadingRow, not from here. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                <Border x:Name="DGR_RowBorder" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Element}">
                    <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_RowBorder" Property="Background" Value="{DynamicResource RowAltSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
          PriceRow — animated hover style for the PriceGrid in the
          "Цены" tab. Same approach as OrdersRow: custom Template whose
          IsSelected trigger paints RowAltSelected instead of
          SystemColors.HighlightBrush (no "white bar" in dark theme),
          code-behind Opacity fade via PriceGrid_LoadingRow / OrderRow_MouseEnter/
          _MouseLeave. The per-row brush starts at Opacity=0 (invisible) so
          the DataGrid's RowBackground / AlternatingRowBackground shows through.
        -->
        <Style x:Key="PriceRow" TargetType="DataGridRow">
            <!-- Same frozen-brush rationale as OrderRow: the per-row brush
                 comes from MainWindow.PriceGrid_LoadingRow, not from here. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                <Border x:Name="DGR_RowBorder" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Element}">
                    <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_RowBorder" Property="Background" Value="{DynamicResource RowAltSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Default DataGridRow: plain, no animation. Used by PriceGrid, etc.
             No Background setter — WPF would freeze any Freezable set here.
             The DataGrid's own RowBackground + AlternatingRowBackground are
             what actually paint these rows, so this style is intentionally
             empty. -->
        <Style TargetType="DataGridRow"/>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0"
                                CornerRadius="{DynamicResource Radius.Element}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                              VerticalAlignment="{Binding VerticalContentAlignment, RelativeSource={RelativeSource TemplatedParent}}"
                                              Margin="2,0"
                                              SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
</ResourceDictionary>
