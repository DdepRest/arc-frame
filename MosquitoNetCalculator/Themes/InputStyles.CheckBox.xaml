<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- CHECKBOX — Windows 11 Toggle Switch                     -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Frosted glass capsule track -->
                        <Border x:Name="SwitchTrack" Width="40" Height="20"
                                CornerRadius="{DynamicResource Radius.Capsule}" Margin="{DynamicResource Gap.None}"
                                Background="{DynamicResource Border}"
                                BorderBrush="{DynamicResource GhostBorder}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Specular top glass sheen -->
                                <Border x:Name="TrackSheen"
                                        CornerRadius="{DynamicResource Radius.Capsule}"
                                        Background="{DynamicResource GlassSheen}"
                                        IsHitTestVisible="False"/>
                                <!-- Frosted glass thumb (pearl) -->
                                <Border x:Name="SwitchThumb" Width="14" Height="14"
                                        CornerRadius="{DynamicResource Radius.Pill}"
                                        Background="{DynamicResource GlassThumb}"
                                        BorderBrush="{DynamicResource GlassThumbBorder}" BorderThickness="1"
                                        HorizontalAlignment="Left" Margin="{DynamicResource Gap.LeftHair}"
                                        VerticalAlignment="Center">
                                    <Border Width="14" Height="14"
                                            CornerRadius="{DynamicResource Radius.Pill}"
                                            Background="{DynamicResource GlassSheen}"
                                            IsHitTestVisible="False"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ContentPresenter x:Name="ContentPresenter" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="{DynamicResource Gap.None}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Margin" Value="{DynamicResource Gap.Left}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource GlassThumbActive}"/>
                            <Setter TargetName="SwitchThumb" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="{DynamicResource Gap.RightHair}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource BorderHover}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentHover}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource GlassThumbActive}"/>
                            <Setter TargetName="SwitchThumb" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- SignToggleCheckBox — large +/- toggle for installation sum -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="SignToggleCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="SwitchTrack" Width="48" Height="26"
                            CornerRadius="{DynamicResource Radius.CapsuleLg}"
                            Background="{DynamicResource Border}"
                            BorderBrush="{DynamicResource GhostBorder}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Frosted track sheen -->
                            <Border CornerRadius="{DynamicResource Radius.CapsuleLg}"
                                    Background="{DynamicResource GlassSheen}"
                                    IsHitTestVisible="False"/>

                            <!-- Background signs -->
                            <TextBlock Text="−" Foreground="{DynamicResource OnDanger}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="{DynamicResource Gap.ToggleSignRight}" FontSize="{StaticResource Type.BodyLg}" FontWeight="Bold"/>
                            <TextBlock Text="+" Foreground="{DynamicResource OnSuccess}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{DynamicResource Gap.ToggleSignLeft}" FontSize="{StaticResource Type.BodyLg}" FontWeight="Bold"/>

                            <!-- Thumb: frosted glass pearl -->
                            <Border x:Name="SwitchThumb" Width="22" Height="22"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Background="{DynamicResource GlassThumbActive}"
                                    BorderBrush="{DynamicResource GlassThumbBorder}" BorderThickness="1"
                                    HorizontalAlignment="Left" Margin="{DynamicResource Gap.LeftHair}"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <Grid>
                                    <Border Width="22" Height="22"
                                            CornerRadius="{DynamicResource Radius.Pill}"
                                            Background="{DynamicResource GlassSheen}"
                                            IsHitTestVisible="False"/>
                                    <TextBlock x:Name="ThumbText" Text="−"
                                               Foreground="{DynamicResource Danger}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Subtitle}" FontWeight="Bold" Margin="{DynamicResource Gap.MicroV}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Success}"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="{DynamicResource Gap.RightHair}"/>
                            <Setter TargetName="ThumbText" Property="Text" Value="+"/>
                            <Setter TargetName="ThumbText" Property="Foreground" Value="{DynamicResource Success}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SwitchThumb" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
