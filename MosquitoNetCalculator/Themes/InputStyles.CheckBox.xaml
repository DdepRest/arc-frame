<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- CHECKBOX — Windows 11 Fluent Capsule Toggle Switch      -->
    <!-- Default for all CheckBoxes in the application           -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Fluent capsule track: 40x20, CornerRadius 10 -->
                        <Border x:Name="SwitchTrack" Width="40" Height="20"
                                CornerRadius="{DynamicResource Radius.Capsule}"
                                Margin="{DynamicResource Gap.None}"
                                Background="{DynamicResource GhostBg}"
                                BorderBrush="{DynamicResource GhostBorder}" BorderThickness="1"
                                SnapsToDevicePixels="False">
                            <!-- Circular thumb: 14x14, pill radius -->
                            <Border x:Name="SwitchThumb" Width="14" Height="14"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Background="{DynamicResource TextSecondary}"
                                    BorderThickness="0" BorderBrush="Transparent"
                                    HorizontalAlignment="Left" Margin="{DynamicResource Gap.LeftHair}"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="False"/>
                        </Border>
                        <ContentPresenter x:Name="ContentPresenter" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="{DynamicResource Gap.None}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Margin" Value="{DynamicResource Gap.Left}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource RowHover}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource OnAccentPrimary}"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="{DynamicResource Gap.RightHair}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentHover}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource OnAccentPrimary}"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="{DynamicResource Gap.RightHair}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentPress}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="SwitchTrack" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource OnAccentPrimary}"/>
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="{DynamicResource Gap.RightHair}"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource RowHover}"/>
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource TextPrimary}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- FluentToggleSwitch — explicit key alias for the toggle  -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="FluentToggleSwitch" TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- SquareCheckBox — Optional Windows 11 Square CheckBox    -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="SquareCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Fluent square box: 18x18, CornerRadius 4 -->
                        <Border x:Name="CheckBorder" Width="18" Height="18"
                                CornerRadius="{DynamicResource Radius.Sm}"
                                Margin="{DynamicResource Gap.None}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource GhostBorder}" BorderThickness="1"
                                SnapsToDevicePixels="False">
                            <Path x:Name="CheckGlyph"
                                  Data="M 3.5,8.5 L 7,12 L 13.5,5"
                                  Stroke="{DynamicResource OnAccentPrimary}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter x:Name="ContentPresenter" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Margin="{DynamicResource Gap.None}"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="True">
                            <Setter TargetName="ContentPresenter" Property="Margin" Value="{DynamicResource Gap.Left}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource RowHover}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentHover}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentPress}"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentPress}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- SignToggleCheckBox — large +/- toggle for installation sum -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Style x:Key="SignToggleCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Fluent capsule track: 44x24, dark segmented pill -->
                    <Border x:Name="SwitchTrack" Width="44" Height="24"
                            CornerRadius="{DynamicResource Radius.CapsuleLg}"
                            Background="{DynamicResource ChipBg}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            SnapsToDevicePixels="False">
                        <Grid>
                            <!-- Background signs: Left is minus, Right is plus -->
                            <TextBlock x:Name="TrackMinus" Text="−" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Margin="{DynamicResource Gap.ToggleSignLeft}"
                                       FontSize="{StaticResource Type.Body}" FontWeight="Bold"
                                       Opacity="0.7"/>
                            <TextBlock x:Name="TrackPlus" Text="+" Foreground="{DynamicResource TextMuted}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="{DynamicResource Gap.ToggleSignRight}"
                                       FontSize="{StaticResource Type.Body}" FontWeight="Bold"
                                       Opacity="0.7"/>

                            <!-- Thumb: solid accent pill with active sign -->
                            <Border x:Name="SwitchThumb" Width="18" Height="18"
                                    CornerRadius="{DynamicResource Radius.Pill}"
                                    Background="{DynamicResource Danger}"
                                    BorderThickness="0" BorderBrush="Transparent"
                                    HorizontalAlignment="Left" Margin="{DynamicResource Gap.LeftHair}"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="False"
                                    RenderTransformOrigin="0.5,0.5">
                                <TextBlock x:Name="ThumbText" Text="−"
                                           Foreground="{DynamicResource OnDanger}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{StaticResource Type.Caption}" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Checked = Plus (+) / Success -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="SwitchThumb" Property="Margin" Value="{DynamicResource Gap.RightHair}"/>
                            <Setter TargetName="SwitchThumb" Property="Background" Value="{DynamicResource Success}"/>
                            <Setter TargetName="ThumbText" Property="Text" Value="+"/>
                            <Setter TargetName="ThumbText" Property="Foreground" Value="{DynamicResource OnSuccess}"/>
                        </Trigger>
                        <!-- Hover states -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                        </Trigger>
                        <!-- Pressed states -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SwitchThumb" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
