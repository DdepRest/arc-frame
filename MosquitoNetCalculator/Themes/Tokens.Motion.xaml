<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- MOTION SCALE — v3.53.0 (см. docs/specs/design-system-v3.53.md)  -->
    <!--                                                                 -->
    <!-- До этой версии длительности брались из воздуха: 0.08 / 0.12 /   -->
    <!-- 0.15 / 0.2 / 0.25 / 0.35 / 0.4 / 0.6 с — четыре «почти 150 мс»   -->
    <!-- и три «почти 400 мс». Шкала: 120 · 180 · 240 · 320 мс.           -->
    <!--                                                                 -->
    <!-- ПРАВИЛА ДВИЖЕНИЯ:                                                -->
    <!-- 1. Ни одна анимация не длится дольше 320 мс — дольше ощущается   -->
    <!--    как «тормоз», а не как отзывчивость.                          -->
    <!-- 2. Никаких живых DropShadowEffect/BlurEffect в триггерах и       -->
    <!--    шаблонах: размытие считается на CPU каждый кадр и уже было    -->
    <!--    выпилено в v3.52.0 (регрессивный тест в Themes). Анимируем     -->
    <!--    Opacity, Background, RenderTransform — они идут по GPU.        -->
    <!-- 3. Уважаем системную настройку «отключить анимации»: движение      -->
    <!--    СЖИМАЕТСЯ в ноль, а не отменяется. Токены ниже читает код       -->
    <!--    (Helpers/Motion): при выключенных анимациях он возвращает       -->
    <!--    TimeSpan.Zero, а Storyboard проигрывается со сжатым временем    -->
    <!--    (SetSpeedRatio ×1000). Конечное состояние применяется и         -->
    <!--    Completed срабатывает — на нём висит очистка (убрать тост,      -->
    <!--    свернуть оверлей), поэтому отменить анимацию нельзя: тост       -->
    <!--    остался бы навсегда (разбор — GOTCHAS §23).                     -->
    <!--    Анимации XAML-триггеров (hover/pressed в стилях контролов)      -->
    <!--    запускает WPF, а не код — они гейтом НЕ покрыты (см. специфику).-->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- ── Длительности ─────────────────────────────────────────────── -->
    <!-- Мгновенный отклик: hover, pressed, фокус -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <!-- Базовый переход: появление чипа, раскрытие карточки, смена цвета -->
    <Duration x:Key="Motion.Base">0:0:0.18</Duration>
    <!-- Смена темы, swap содержимого панели -->
    <Duration x:Key="Motion.Slow">0:0:0.24</Duration>
    <!-- Выезд оверлея/панели целиком (единственный длинный шаг) -->
    <Duration x:Key="Motion.Emphasized">0:0:0.32</Duration>

    <!-- ── Кривые ───────────────────────────────────────────────────── -->
    <!-- Стандарт: быстрый старт, мягкое торможение (всё, что «появляется») -->
    <CubicEase x:Key="Ease.Standard" EasingMode="EaseOut"/>
    <!-- Симметричная: движение из A в B (сдвиги, сворачивание) -->
    <CubicEase x:Key="Ease.Move" EasingMode="EaseInOut"/>
    <!-- Вход: разгон в конце (исчезновение) -->
    <CubicEase x:Key="Ease.Exit" EasingMode="EaseIn"/>

</ResourceDictionary>
