<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- БАЗА ОКНА — единый рендер текста и типографика             -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Общий стиль окна. Имя обязательно: НЕЯВНЫЙ стиль (TargetType без
             x:Key) WPF применяет только к ТОЧНОМУ типу Window, а все окна
             приложения — наследники (MainWindow + 12 вторичных), поэтому
             неявный стиль не доставал ни до одного из них: замер v3.53.0
             давал Style=null, Segoe UI 12, TextFormattingMode=Ideal,
             UseLayoutRounding=false. До v3.53.0 шрифт и режим рендера
             задавались только в MainWindow, а 12 вторичных окон (Welcome,
             Import, PrintPreview, SendToFactory, ChangeOrderStatus, WhatsNew,
             UpdateAvailable, SlopeEconomy, AdminPassword, AiApiKey, AiAssistant,
             MessageDialog) рисовали текст иначе — другой способ сглаживания
             и «рваные» hairline-границы на 150% DPI.
             Отсюда правило: КАЖДОЕ окно объявляет
             Style="{DynamicResource Window.Shared}", и это стережёт
             Design/WindowChromeAndDpiTests — наличие стиля в словаре ничего не
             доказывает (неявный стиль лежал там и не работал).
             TextFormattingMode=Display выбран осознанно: интерфейсные размеры
             11-14px на нём читаются резче. Предпросмотр печати СОЗНАТЕЛЬНО
             переопределяет режим на Ideal в PrintPreviewControl — там важно
             совпадение разбиения на страницы с выводом на печать. -->
        <Style x:Key="Window.Shared" TargetType="Window">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Text}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.BodyMd}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource AppBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- TOAST NOTIFICATION STYLE                                 -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Style x:Key="ToastBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- OVERLAY HEADER — shared chrome for all slide-over panels -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- UX-15: every MainWindow overlay (Заказы/Цены/Обновления/Админ/
             Откосы/AI/Заказчик/Печать) used the same Border header with the
             same five attributes copied inline. One keyed style keeps them
             consistent; the title/icon/close button stay per-overlay. -->
        <Style x:Key="OverlayHeader" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SEPARATOR — subtle, modern                              -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Background" Value="{DynamicResource SubtleBorder}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                                Height="{Binding Height, RelativeSource={RelativeSource TemplatedParent}}"
                                Margin="{Binding Margin, RelativeSource={RelativeSource TemplatedParent}}"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- LISTVIEW — Orders tab                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{StaticResource Type.BodyMd}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- GridViewColumnHeader — Fluent -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
            <Setter Property="FontWeight" Value="{StaticResource Weight.SemiBold}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HeaderBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Style.Triggers>                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HeaderBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource HeaderText}"/>
                            </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HeaderPress}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListViewItem — Fluent alternating rows -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource RowAlt}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHover}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                        <Condition Property="IsMouseOver" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource RowAltHover}"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="ItemsControl.AlternationIndex" Value="1"/>
                        <Condition Property="IsSelected" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource RowAltSelected}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
</ResourceDictionary>
