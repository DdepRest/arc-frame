<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- COLOR PALETTE — dynamically updated by ThemeService      -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AppBg"        Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Surface"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Accent"        Color="#005FB8"/>
    <SolidColorBrush x:Key="AccentHover"   Color="#004E99"/>
    <SolidColorBrush x:Key="AccentPress"   Color="#003E7A"/>
    <SolidColorBrush x:Key="AccentLight"   Color="#EBF3FD"/>
    <SolidColorBrush x:Key="OnAccent"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnSuccess"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnDanger"      Color="#FFFFFF"/>
    <!-- v3.50.1: prototype .btn.blue — dark text on the accent fill (#06121F);
         white in light theme. Separate from OnAccent, which sits on
         checkboxes/badges over non-accent fills. -->
    <SolidColorBrush x:Key="OnAccentPrimary" Color="#06121F"/>
    <!-- v3.50.1: nav rail background — prototype .sidebar (bg2) #17181C -->
    <SolidColorBrush x:Key="SidebarBg"     Color="#17181C"/>
    <SolidColorBrush x:Key="GhostBg"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GhostBorder"   Color="#D0D0D0"/>
    <SolidColorBrush x:Key="SectionBg"     Color="#F8F9FB"/>
    <SolidColorBrush x:Key="SectionAccent" Color="#005FB8"/>
    <SolidColorBrush x:Key="TextPrimary"   Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5D5D5D"/>
    <!-- UX-07: contrast-safe muted text (≈5.0:1 on white; ThemeService
         overrides per theme at runtime). -->
    <SolidColorBrush x:Key="TextMuted"     Color="#6E6E7A"/>
    <SolidColorBrush x:Key="Border"        Color="#D9D9D9"/>
    <SolidColorBrush x:Key="BorderHover"   Color="#B8B8B8"/>
    <SolidColorBrush x:Key="RowHover"      Color="#F5F5F5"/>
    <SolidColorBrush x:Key="RowAlt"        Color="#FAFAFA"/>
    <SolidColorBrush x:Key="RowAltHover"   Color="#F0F0F0"/>
    <SolidColorBrush x:Key="RowAltSelected" Color="#EBF3FD"/>
    <SolidColorBrush x:Key="Success"       Color="#0F7B3F"/>
    <SolidColorBrush x:Key="EconomyGreen"  Color="#4CAF50"/>
    <SolidColorBrush x:Key="EconomyGreenLight" Color="#0D4CAF50"/>
    <SolidColorBrush x:Key="SuccessHover"  Color="#0A6333"/>
    <SolidColorBrush x:Key="Danger"        Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerHover"   Color="#A61B10"/>
    <SolidColorBrush x:Key="TotalBg"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="QuickBg"       Color="#F9F9F9"/>
    <SolidColorBrush x:Key="ChipBg"        Color="#EFF4FB"/>
    <SolidColorBrush x:Key="Warning"       Color="#D48C00"/>
    <SolidColorBrush x:Key="DangerLight"   Color="#FDE7E9"/>
    <SolidColorBrush x:Key="HeaderBg"      Color="#F9F9F9"/>
    <SolidColorBrush x:Key="HeaderBorder"  Color="#E8E8E8"/>
    <SolidColorBrush x:Key="HeaderText"    Color="#424242"/>
    <SolidColorBrush x:Key="HeaderHover"   Color="#F0F0F4"/>
    <SolidColorBrush x:Key="HeaderPress"   Color="#E0E0E0"/>
    <SolidColorBrush x:Key="GridLine"      Color="#F0F0F5"/>
    <SolidColorBrush x:Key="TrackBg"       Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ScrollBarThumb" Color="#B0B0B0"/>
    <SolidColorBrush x:Key="SubtleBorder"  Color="#EBEBEB"/>
    <SolidColorBrush x:Key="DangerGhostBorder" Color="#F0C6CA"/>
    <SolidColorBrush x:Key="MenuItemPressed"   Color="#E8EDF5"/>
    <Color x:Key="ShadowColor">#1A1A1A</Color>
    <!--
      Animation-target colors (mirror the corresponding SolidColorBrush above).
      Existed as Brushes only before, but ColorAnimation needs plain Color values
      to animate DataGridRow.Background smoothly. ThemeService updates both the
      Brush and the Color in lockstep on theme switch.
    -->
    <Color x:Key="RowHoverColor">#F5F5F5</Color>
    <Color x:Key="AccentLightColor">#EBF3FD</Color>
    <!--
      AccentShadowColor — legacy accent Color (kept: ThemeService mirrors it on
      every theme switch; no live consumer since v3.52.0 removed the last
      DropShadowEffect that used it).
    -->
    <Color x:Key="AccentShadowColor">#005FB8</Color>
    <SolidColorBrush x:Key="InstallGreen" Color="#0F7B3F"/>
    <SolidColorBrush x:Key="InstallRed" Color="#C42B1C"/>
    <SolidColorBrush x:Key="InstallGray" Color="#8A8A8A"/>
    <SolidColorBrush x:Key="BadgeDefaultBg" Color="#EFF4FB"/>
    <SolidColorBrush x:Key="BadgeDefaultFg" Color="#005FB8"/>
    <SolidColorBrush x:Key="BadgeSuccessBg" Color="#E6F5EC"/>
    <SolidColorBrush x:Key="BadgeSuccessFg" Color="#0F7B3F"/>
    <SolidColorBrush x:Key="BadgeWarningBg" Color="#FFF4CE"/>
    <SolidColorBrush x:Key="BadgeWarningFg" Color="#D48C00"/>
    <SolidColorBrush x:Key="BadgeDangerBg" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="BadgeDangerFg" Color="#C42B1C"/>
    <SolidColorBrush x:Key="BadgeVisionBg" Color="#F0ECFA"/>
    <SolidColorBrush x:Key="BadgeVisionFg" Color="#7A5AF8"/>
    <SolidColorBrush x:Key="TotalText" Color="#1A1A24"/>
    <SolidColorBrush x:Key="TotalTextMuted" Color="#6E6E7A"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- СЛУЖЕБНЫЕ ТОКЕНЫ (не переключаются темой)              -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Раньше эти значения жили hex-литералами прямо в разметке
         (8 скримов в MainWindow, красные точки, серая бумага в предпросмотре). -->
    <!-- Скрим подложки оверлеев. Значение ОБНОВЛЯЕТ ThemeService при смене
         темы (в тёмной он глубже), поэтому потребители берут его через
         DynamicResource. -->
    <SolidColorBrush x:Key="Scrim" Color="#80000000"/>
    <!-- Красная точка «доступно обновление» (нав-рельс, шестерёнка титульной) -->
    <SolidColorBrush x:Key="NotificationDot" Color="#E81123"/>
    <!-- Кнопка закрытия окна: фон при hover и глиф на нём — стандарт Windows -->
    <SolidColorBrush x:Key="WindowCloseHover" Color="#E81123"/>
    <SolidColorBrush x:Key="OnWindowClose" Color="#FFFFFF"/>
    <!-- Блеск карточки ИТОГО под курсором (тёмная подложка в обеих темах) -->
    <SolidColorBrush x:Key="TotalSheen" Color="#33FFFFFF"/>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- ЖИДКОЕ СТЕКЛО (LIQUID GLASS OPTICS)                      -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- КОНТРАКТ: полупрозрачная накладка не лежит под текстом.
         «Стекло» создаётся оптическим хромом по периметру:
           • GlassSpecularBorder — диагональная спекулярная кромка (135°)
             с ярким бликом сверху-слева и мягким контуром снизу-справа;
           • GlassInnerRim — внутренняя фаска рефракции (толщина стекла);
           • GlassSpecularArc — верхний световой мениск;
           • GlassAmbientShadow — мягкая контактная тень без CPU-blur;
           • GlassHoverBloom — мягкое наполнение светом при наведении;
           • GlassPressVeil — общая вуаль нажатия (12% чёрного). -->
    <LinearGradientBrush x:Key="GlassSpecularBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9FFFFFF" Offset="0"/>
        <GradientStop Color="#4DFFFFFF" Offset="0.35"/>
        <GradientStop Color="#14FFFFFF" Offset="0.75"/>
        <GradientStop Color="#2EFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Внешняя спекулярная кромка под курсором (усиленный блик) -->
    <LinearGradientBrush x:Key="GlassSpecularBorderHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#80FFFFFF" Offset="0.35"/>
        <GradientStop Color="#26FFFFFF" Offset="0.75"/>
        <GradientStop Color="#4DFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Внутренняя оптическая фаска рефракции (толщина стекла по референсу) -->
    <LinearGradientBrush x:Key="GlassInnerRim" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#73FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.4"/>
        <GradientStop Color="#00FFFFFF" Offset="0.8"/>
        <GradientStop Color="#14000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Верхний мениск (контурный блик верхней кромки) -->
    <LinearGradientBrush x:Key="GlassSpecularArc" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.6"/>
    </LinearGradientBrush>

    <!-- Мягкая контактная тень стекла (без CPU Blur) -->
    <LinearGradientBrush x:Key="GlassAmbientShadow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#08000000" Offset="0.5"/>
        <GradientStop Color="#2B000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Подсветка стекла при наведении (bloom) -->
    <LinearGradientBrush x:Key="GlassHoverBloom" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#24FFFFFF" Offset="0"/>
        <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- Внешняя спекулярная кромка для вторичных (Ghost) кнопок -->
    <LinearGradientBrush x:Key="GlassGhostSpecularBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B3FFFFFF" Offset="0"/>
        <GradientStop Color="#33FFFFFF" Offset="0.3"/>
        <GradientStop Color="#26000000" Offset="0.8"/>
        <GradientStop Color="#38000000" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassGhostSpecularBorderHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#66FFFFFF" Offset="0.3"/>
        <GradientStop Color="#33000000" Offset="0.8"/>
        <GradientStop Color="#4D000000" Offset="1"/>
    </LinearGradientBrush>

    <!-- Вуаль нажатия: затемняет заливку ЛЮБОГО варианта одинаково,
         поэтому нажатие всегда сильнее ховера (раньше Success/Danger
         на нажатии возвращались к базовому цвету). -->
    <SolidColorBrush x:Key="GlassPressVeil" Color="#1F000000"/>

    <!-- Мягкий глянец тумблера: живёт на треке и бегунке, текста под ним нет. -->
    <LinearGradientBrush x:Key="GlassSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>

    <!-- Стеклянный бегунок тумблера (SwitchThumb) -->
    <LinearGradientBrush x:Key="GlassThumb" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F4F4F8" Offset="0"/>
        <GradientStop Color="#C0C0C8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassThumbActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#E0ECF8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassThumbBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#80FFFFFF" Offset="0"/>
        <GradientStop Color="#33000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- Предпросмотр печати: лист ВСЕГДА белый (это бумага), поэтому его
         кромка и подложка приглушения не зависят от темы. -->
    <SolidColorBrush x:Key="PreviewPageBorder" Color="#777777"/>
    <SolidColorBrush x:Key="PreviewDimOverlay" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="PreviewDimText" Color="#666666"/>

    <!-- ── Палитра заметок (данные пользователя, не тема) ───── -->
    <!-- Цвета текста в примечаниях: пользователь выбирает из набора,
         поэтому это фиксированные значения в обеих темах. -->
    <SolidColorBrush x:Key="NotesColor.Red" Color="#FF0000"/>
    <SolidColorBrush x:Key="NotesColor.Orange" Color="#F57C00"/>
    <SolidColorBrush x:Key="NotesColor.Amber" Color="#FFA000"/>
    <SolidColorBrush x:Key="NotesColor.Green" Color="#388E3C"/>
    <SolidColorBrush x:Key="NotesColor.Teal" Color="#00897B"/>
    <SolidColorBrush x:Key="NotesColor.Blue" Color="#1976D2"/>
    <SolidColorBrush x:Key="NotesColor.Indigo" Color="#303F9F"/>
    <SolidColorBrush x:Key="NotesColor.Purple" Color="#7B1FA2"/>
    <SolidColorBrush x:Key="NotesColor.Pink" Color="#C2185B"/>
    <SolidColorBrush x:Key="NotesColor.Brown" Color="#5D4037"/>
    <SolidColorBrush x:Key="NotesColor.Gray" Color="#757575"/>
    <SolidColorBrush x:Key="NotesColor.Dark" Color="#212121"/>
    <!-- «Белый» свободного цвета: глиф на белом листе, ему нужна рамка -->
    <SolidColorBrush x:Key="NotesColor.White" Color="#FFFFFF"/>
    <!-- Color-двойники только для свотча «любой цвет»: градиенту
         (GradientStop.Color) нужен Color, а не Brush. Значения держим рядом,
         чтобы пара не разъезжалась. -->
    <Color x:Key="NotesColor.Crimson.Color">#D32F2F</Color>
    <Color x:Key="NotesColor.Orange.Color">#F57C00</Color>
    <Color x:Key="NotesColor.Blue.Color">#1976D2</Color>
    <Color x:Key="NotesColor.Green.Color">#388E3C</Color>
    <Color x:Key="NotesColor.Purple.Color">#7B1FA2</Color>

</ResourceDictionary>
