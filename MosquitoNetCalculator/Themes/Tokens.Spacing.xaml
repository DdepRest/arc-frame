<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SPACING SCALE — v3.53.0 (см. docs/specs/design-system-v3.53.md) -->
    <!--                                                                 -->
    <!-- Правило: в разметке не должно быть «свободных» чисел отступов.   -->
    <!-- Шкала: 4 · 8 · 12 · 16 · 24 · 32 · 48. Значения 5, 6, 7, 10, 14, -->
    <!-- 18, 22 больше не добавляются — они и были источником «почти     -->
    <!-- одинаковых» отступов (в v3.52.0 в разметке жило 573 Margin=      -->
    <!-- с шестью разными «почти 8»).                                     -->
    <!--                                                                 -->
    <!-- Здесь лежат примитивы (Space.*), каждый — sys:Double, чтобы его   -->
    <!-- можно было использовать и в Margin/Padding через конвертер        -->
    <!-- Thickness, и в вычислениях. Готовые Thickness-токены (Gap.*,      -->
    <!-- Pad.*) собраны на этих примитивах и покрывают типовые случаи.     -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Примитивы шкалы -->
    <sys:Double x:Key="Space.Xs">4</sys:Double>
    <sys:Double x:Key="Space.Sm">8</sys:Double>
    <sys:Double x:Key="Space.Md">12</sys:Double>
    <sys:Double x:Key="Space.Lg">16</sys:Double>
    <sys:Double x:Key="Space.Xl">24</sys:Double>
    <sys:Double x:Key="Space.2Xl">32</sys:Double>
    <sys:Double x:Key="Space.3Xl">48</sys:Double>

    <!-- Микро-зазор для иконочных пар (иконка + подпись внутри одного чипа):
         2px — единственное исключение ниже шкалы, только для глифов. -->
    <sys:Double x:Key="Space.Hair">2</sys:Double>

    <!-- ── Готовые отступы: вертикальный поток (Stack) ──────────────── -->
    <!-- Между блоками одного уровня (карточка → карточка) -->
    <Thickness x:Key="Gap.Block">0,0,0,8</Thickness>
    <!-- Между плотными строками внутри блока -->
    <Thickness x:Key="Gap.BlockSm">0,0,0,4</Thickness>
    <!-- Над блоком -->
    <Thickness x:Key="Gap.BlockTop">0,4,0,0</Thickness>
    <!-- Шаг 6 (v3.53.0): крупный вертикальный зазор 12 — между секциями панели -->
    <Thickness x:Key="Gap.BlockLg">0,0,0,12</Thickness>
    <Thickness x:Key="Gap.BlockTopLg">0,12,0,0</Thickness>

    <!-- Пустые/загрузочные состояния: поля внутри карточки состояния -->
    <Thickness x:Key="Pad.EmptyPanel">24,32</Thickness>
    <!-- Между блоком состояния и заголовком/подсказкой/действием -->
    <Thickness x:Key="Gap.EmptyIcon">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.EmptyHint">0,4,0,0</Thickness>
    <Thickness x:Key="Gap.EmptyAction">0,12,0,0</Thickness>

    <!-- ── Готовые отступы: горизонтальный поток (Inline) ───────────── -->
    <!-- Иконка → подпись, кнопка → кнопка -->
    <Thickness x:Key="Gap.Inline">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.InlineSm">0,0,4,0</Thickness>
    <!-- Шаг 6 (v3.53.0): горизонтальные 12 — после иконки секции, перед чипом -->
    <Thickness x:Key="Gap.InlineLg">0,0,12,0</Thickness>
    <Thickness x:Key="Gap.LeftLg">12,0,0,0</Thickness>
    <!-- Отступ слева от предыдущего элемента (чекбокс, второй столбец) -->
    <Thickness x:Key="Gap.Left">8,0,0,0</Thickness>
    <Thickness x:Key="Gap.LeftSm">4,0,0,0</Thickness>

    <!-- ── Внутренние поля (Padding) контейнеров ────────────────────── -->
    <!-- Панель/карточка. ВАЖНО: левый инсет 12 согласован с полосой
         статуса (1px рамка + 4px полоса + 12 = 17px), см. Radius.StripeInner. -->
    <Thickness x:Key="Pad.Card">12,10,14,10</Thickness>
    <!-- Плотная строка (меню, чипы, элементы списка) -->
    <Thickness x:Key="Pad.Row">10,6</Thickness>
    <!-- Шапка панели/оверлея -->
    <Thickness x:Key="Pad.Header">16,10</Thickness>
    <!-- Компактная кнопка/пилюля -->
    <Thickness x:Key="Pad.Pill">10,4</Thickness>
    <!-- Контейнер секции (группа полей) -->
    <Thickness x:Key="Pad.Section">12</Thickness>

</ResourceDictionary>
