<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="MosquitoNetCalculator.app"/>

  <!-- ═══════════════════════════════════════════════════════════════
       DPI: PerMonitorV2 (v3.53.0).

       До этой версии манифеста не было вообще, то есть процесс оставался
       System-DPI-aware: при переносе окна между мониторами с разным
       масштабом (ноутбук 150% + внешний 100% — типовая конфигурация у
       замерщика) Windows растягивала уже отрисованное окно, и текст
       становился мыльным.

       PerMonitorV2 + WPF даёт пересчёт на каждый монитор (WPF умеет это с
       .NET Framework 4.6.2/.NET Core), а `true/pm` оставлен первым —
       для систем, которые не знают PerMonitorV2.

       longPathAware нужен потому, что заказы и вложения OCR лежат в
       %AppData%\MosquitoNetCalculator и пути легко перерастают MAX_PATH.
       ═══════════════════════════════════════════════════════════════ -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compat.v1">
    <application>
      <!-- Windows 10 / Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 / 8 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
    </application>
  </compatibility>
</assembly>
