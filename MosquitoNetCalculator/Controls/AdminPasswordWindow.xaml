<Window x:Class="MosquitoNetCalculator.Controls.AdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        FocusManager.FocusedElement="{Binding ElementName=PasswordBox}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <!-- PasswordBox does not inherit the global TextBox template by default. Keep
             the field readable in both themes and make focus unmistakable. -->
        <Style x:Key="AdminPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource SectionBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="12,0,42,0"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdminPasswordTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0,42,0"/>
            <Setter Property="Background" Value="{DynamicResource SectionBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="VisiblePasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="12,0,42,0"
                                          VerticalAlignment="Center"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="VisiblePasswordBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="VisiblePasswordBorder" Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="14"
            Margin="10"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="3"
                              Opacity="0.35"
                              Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ Заголовок: иконка + название + закрыть ═══ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="14,14,0,0"
                    Padding="18,0"
                    Height="50"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Иконка замка — закрыта, чтобы считывалось «безопасный вход» -->
                        <Border Width="24" Height="24" CornerRadius="6"
                                Background="{DynamicResource AccentLight}"
                                Margin="0,0,10,0">
                            <TextBlock Text="&#xE1F6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"
                                   Text="Ввод пароля"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="40" Height="40"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Foreground="{DynamicResource TextPrimary}"
                            ToolTip="Закрыть (Escape)"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8" ClipToBounds="True">
                                    <Grid>
                                        <Border x:Name="HoverOverlay" Background="{DynamicResource Danger}" Opacity="0" CornerRadius="8"/>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter TargetName="HoverOverlay" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ Поле пароля и только необходимые состояния ═══ -->
            <StackPanel Grid.Row="1" Margin="24,24,24,0">
                <Grid>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource AdminPasswordBox}"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 PreviewKeyDown="PasswordBox_PreviewKeyDown"/>
                    <!-- TextBox нужен только в режиме просмотра пароля. -->
                    <TextBox x:Name="PasswordVisibleTextBox"
                             Style="{StaticResource AdminPasswordTextBox}"
                             VerticalContentAlignment="Center"
                             Visibility="Collapsed"
                             TextChanged="PasswordVisibleTextBox_TextChanged"
                             PreviewKeyDown="PasswordVisibleTextBox_PreviewKeyDown"/>
                    <Button x:Name="BtnToggleVisibility"
                            Width="36" Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            AutomationProperties.Name="Показать или скрыть пароль"
                            ToolTip="Показать или скрыть пароль"
                            Click="BtnToggleVisibility_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="EyeButtonBorder"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="7"
                                        Padding="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="EyeButtonBorder" Property="Background" Value="{DynamicResource AccentLight}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="EyeButtonBorder" Property="Background" Value="{DynamicResource AccentLight}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="BtnToggleVisibilityIcon"
                                   Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
                    </Button>
                </Grid>

                <!-- Показываем только действительно полезные состояния: Caps Lock и ошибку. -->
                <StackPanel x:Name="CapsLockWarning"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            Margin="0,8,0,0">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" Foreground="{DynamicResource BadgeWarningFg}"
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Включён Caps Lock"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource BadgeWarningFg}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="InlineError"
                           Visibility="Collapsed"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource BadgeDangerFg}"
                           Margin="0,8,0,0"
                           Text="Неверный пароль"/>
            </StackPanel>

            <!-- ═══ Кнопки ═══ -->
            <Grid Grid.Row="2"
                  Margin="24,18,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Отмена"
                            Style="{DynamicResource GhostButton}"
                            MinWidth="92"
                            Padding="16,8"
                            FontSize="13"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button Content="Войти"
                            x:Name="OkButton"
                            IsDefault="True"
                            Style="{DynamicResource PrimaryButton}"
                            MinWidth="92"
                            Padding="16,8"
                            FontSize="13"
                            Margin="8,0,0,0"
                            Click="OkButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
