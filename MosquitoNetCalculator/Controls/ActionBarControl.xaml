<UserControl x:Class="MosquitoNetCalculator.Controls.ActionBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation/navigation">
    <UserControl.Resources>
        <!-- UX-07: «Заказчик» — accent outline while client data is missing,
             filled accent once name/phone/address/contract are complete.
             At-a-glance readiness without opening the sidebar. -->
        <Style x:Key="ClientInfoButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ClientInfo.IsClientInfoFilled}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter Property="Foreground" Value="{DynamicResource OnAccentPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- v3.50 split-button: caret segment glued to the main print button.
             No hover animation so the pair reads as ONE control (the main
             segment keeps PrimaryButton's own hover). -->
        <Style x:Key="PrintCaretButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="0,7,7,0" Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Menu items inside the caret popup -->
        <Style x:Key="PrintMenuItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- v3.50.1: prototype .actionbar — flat strip on the page background with a
         bottom hairline, not a floating card. -->
    <Border x:Name="CardActionBar" Background="{DynamicResource AppBg}" CornerRadius="0"
            Padding="12,10" Margin="0"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Opacity="0">
        <Grid>
            <!-- Cluster 1+2: Primary + Secondary (left) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Cluster 1: Primary — v3.50 split-button «Печать КП»:
                     main = PDF export in one click, caret = variants menu
                     (PDF / preview / printer). All routes reuse existing paths. -->
                <Grid Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnPrintKpMain" Grid.Column="0"
                            Style="{DynamicResource PrimaryButton}"
                            Click="BtnPrintPdf_Click"
                            ToolTip="Экспорт PDF в один клик">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE896;"/>
                            <TextBlock Text="Печать КП"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPrintCaret" Grid.Column="1"
                            Style="{DynamicResource PrintCaretButton}"
                            Height="{Binding ActualHeight, ElementName=BtnPrintKpMain}"
                            Click="BtnPrintCaret_Click"
                            ToolTip="Другие варианты печати"
                            AutomationProperties.Name="Другие варианты печати"
                            AutomationProperties.AutomationId="BtnPrintCaret">
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Popup x:Name="PrintMenuPopup" AllowsTransparency="True" IsOpen="False"
                           Placement="Bottom" PlacementTarget="{Binding ElementName=BtnPrintCaret}"
                           PopupAnimation="Fade" StaysOpen="False">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,4,8,8"
                                SnapsToDevicePixels="True" MinWidth="230">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.3"/>
                            </Border.Effect>
                            <StackPanel>
                                <Button Style="{DynamicResource PrintMenuItem}" Click="BtnPrintPdf_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Экспорт PDF" VerticalAlignment="Center"/>
                                        <TextBlock Text="1 клик" FontSize="10.5" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource PrintMenuItem}" Click="BtnPrintPreview_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Предпросмотр и печать" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource PrintMenuItem}" Click="BtnPrinterDirect_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Печать на принтере" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Button Style="{DynamicResource SuccessButton}"
                        Click="BtnSaveOrder_Click" Margin="0,0,6,0"
                        ToolTip="Сохранить заказ (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE74E;"/>
                        <TextBlock Text="Сохранить"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource ClientInfoButton}"
                        Click="BtnOrderInfo_Click" Margin="0,0,6,0"
                        ToolTip="Заполните: имя, телефон, адрес, номер договора, примечания">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE77B;"/>
                        <TextBlock Text="Заказчик"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="{DynamicResource Border}" Margin="8,0"/>

                <!-- UX-12: Undo/Redo — discoverable buttons for the existing Ctrl+Z/Y flow;
                     disabled state mirrors the undo/redo stacks via MainWindow.CanUndo/CanRedo. -->
                <Button Style="{DynamicResource GhostButton}"
                        Click="BtnUndo_Click" Margin="0,0,4,0"
                        IsEnabled="{Binding CanUndo, FallbackValue=False}"
                        ToolTip="Отменить последнее действие (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE7A7;"/>
                        <TextBlock Text="Отменить"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource GhostButton}"
                        Click="BtnRedo_Click" Margin="0,0,6,0"
                        IsEnabled="{Binding CanRedo, FallbackValue=False}"
                        ToolTip="Повторить отменённое действие (Ctrl+Y)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE7A6;"/>
                        <TextBlock Text="Повторить"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="{DynamicResource Border}" Margin="8,0"/>

                <!-- Cluster 2: Secondary -->
                <Button Style="{DynamicResource GhostButton}"
                        Click="BtnNewOrder_Click" Margin="0,0,6,0"
                        ToolTip="Создать новый заказ (сначала сохраните текущий)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE710;"/>
                        <TextBlock Text="Новый заказ"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource GhostButton}"
                        Click="BtnSendToFactory_Click" Margin="0,0,6,0"
                        ToolTip="Сформировать текст для отправки на завод / копирования">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE7B3;"/>
                        <TextBlock Text="На завод"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Cluster 3: Danger/Tertiary (right) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- UX-12: dirty chip — mirrors StatusDirtyIndicator; click = save (Ctrl+S path). -->
                <Border x:Name="DirtyChip"
                        Background="{DynamicResource BadgeWarningBg}"
                        CornerRadius="7" Padding="8,4" Margin="0,0,8,0"
                        Cursor="Hand" MouseLeftButtonUp="DirtyChip_Click"
                        ToolTip="Несохранённые изменения — нажмите, чтобы сохранить (Ctrl+S)">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource BadgeWarningFg}"
                                 VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Есть изменения" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BadgeWarningFg}"/>
                    </StackPanel>
                </Border>
                <Button Style="{DynamicResource DangerGhostButton}"
                        Click="BtnClearAll_Click"
                        ToolTip="Очистить все позиции из текущего расчёта">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE75C;"/>
                        <TextBlock Text="Очистить всё"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
