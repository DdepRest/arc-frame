<UserControl x:Class="MosquitoNetCalculator.Controls.ActionBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation/navigation">
    <UserControl.Resources>
        <!-- UX-07 (v3.50.2, owner request): «Заказчик» — always the same solid
             accent blue as «Печать КП» (PrimaryButton), matching the prototype's
             .btn.blue. No separate unfilled/filled states: the client-readiness
             signal is carried by the client panel itself, not by button color. -->
        <Style x:Key="ClientInfoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"/>

        <!-- v3.50 split-button: caret segment glued to the main print button.
             No hover animation so the pair reads as ONE control (the main
             segment keeps PrimaryButton's own hover). -->
        <Style x:Key="PrintCaretButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccentPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.StripeRight}" Padding="7,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Menu items inside the caret popup -->
        <Style x:Key="PrintMenuItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- v3.50.1: prototype .actionbar — flat strip on the page background with a
         bottom hairline, not a floating card. -->
    <Border x:Name="CardActionBar" Background="{DynamicResource AppBg}" CornerRadius="{DynamicResource Radius.None}"
            Padding="12,10" Margin="0"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Opacity="0">
        <Grid>
            <!-- Cluster 1+2: Primary + Secondary (left) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Cluster 1: Primary — v3.50 split-button «Печать КП»:
                     main = PDF export in one click, caret = variants menu
                     (PDF / preview / printer). All routes reuse existing paths. -->
                <Grid Margin="0,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnPrintKpMain" Grid.Column="0"
                            Style="{DynamicResource PrimaryButton}"
                            Click="BtnPrintPreview_Click"
                            ToolTip="Предпросмотр и печать">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE896;"/>
                            <TextBlock Text="Печать КП"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnPrintCaret" Grid.Column="1"
                            Style="{DynamicResource PrintCaretButton}"
                            Height="{Binding ActualHeight, ElementName=BtnPrintKpMain}"
                            Click="BtnPrintCaret_Click"
                            ToolTip="Другие варианты печати"
                            AutomationProperties.Name="Другие варианты печати"
                            AutomationProperties.AutomationId="BtnPrintCaret">
                        <TextBlock Text="&#xE70D;" FontFamily="{DynamicResource Font.Icon}" FontSize="11"/>
                    </Button>                    <Popup x:Name="PrintMenuPopup" AllowsTransparency="True" IsOpen="False"
                           Placement="Bottom" PlacementTarget="{Binding ElementName=BtnPrintCaret}"
                           PopupAnimation="Fade" StaysOpen="False">
                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" Padding="5" Margin="0,4,8,8"
                                SnapsToDevicePixels="True" MinWidth="270">
                            <StackPanel>
                                <!-- v3.50.3: меню каретки — БЕЗ предпросмотра; предпросмотр
                                     теперь главный сегмент кнопки. Каждый пункт — прямой
                                     вызов существующего пайплайна печати. -->
                                <Button Style="{DynamicResource PrintMenuItem}" Click="BtnPrinterDirect_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" FontFamily="{DynamicResource Font.Icon}"
                                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Печать без предпросмотра" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource PrintMenuItem}" Click="BtnPrinterProduction_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}"
                                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Печать «Чистая» + «В производство»" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{DynamicResource PrintMenuItem}" Click="BtnPrintPdf_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource Font.Icon}"
                                                   FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Сохранить в PDF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Button Style="{DynamicResource SuccessButton}"
                        Click="BtnSaveOrder_Click" Margin="0,0,6,0"
                        ToolTip="Сохранить заказ (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE74E;"/>
                        <TextBlock Text="Сохранить"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource ClientInfoButton}"
                        Click="BtnOrderInfo_Click" Margin="0,0,6,0"
                        ToolTip="Заполните: имя, телефон, адрес, номер договора, примечания">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE77B;"/>
                        <TextBlock Text="Заказчик"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="{DynamicResource Border}" Margin="8,0"/>

                <!-- UX-12: Undo/Redo — discoverable buttons for the existing Ctrl+Z/Y flow;
                     disabled state mirrors the undo/redo stacks via MainWindow.CanUndo/CanRedo. -->
                <Button Style="{DynamicResource GhostButton}"
                        Click="BtnUndo_Click" Margin="{DynamicResource Gap.InlineSm}"
                        IsEnabled="{Binding CanUndo, FallbackValue=False}"
                        ToolTip="Отменить последнее действие (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE7A7;"/>
                        <TextBlock Text="Отменить"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource GhostButton}"
                        Click="BtnRedo_Click" Margin="0,0,6,0"
                        IsEnabled="{Binding CanRedo, FallbackValue=False}"
                        ToolTip="Повторить отменённое действие (Ctrl+Y)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE7A6;"/>
                        <TextBlock Text="Повторить"/>
                    </StackPanel>
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="20" Fill="{DynamicResource Border}" Margin="8,0"/>

                <!-- Cluster 2: Secondary -->
                <Button Style="{DynamicResource GhostButton}"
                        Click="BtnNewOrder_Click" Margin="0,0,6,0"
                        ToolTip="Создать новый заказ (сначала сохраните текущий)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE710;"/>
                        <TextBlock Text="Новый заказ"/>
                    </StackPanel>
                </Button>
                <Button Style="{DynamicResource GhostButton}"
                        Click="BtnSendToFactory_Click" Margin="0,0,6,0"
                        ToolTip="Сформировать текст для отправки на завод / копирования">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE7B3;"/>
                        <TextBlock Text="На завод"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Cluster 3: Danger/Tertiary (right) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{DynamicResource DangerGhostButton}"
                        Click="BtnClearAll_Click"
                        ToolTip="Очистить все позиции из текущего расчёта">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE75C;"/>
                        <TextBlock Text="Очистить всё"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
