<UserControl x:Class="MosquitoNetCalculator.Controls.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MosquitoNetCalculator.Controls">
    <Border Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Radius.Lg}"
            Margin="{DynamicResource Gap.Sidebar}" Padding="{DynamicResource Pad.None}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            Style="{DynamicResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{DynamicResource Pad.None}">
            <StackPanel Margin="{DynamicResource Pad.Card}">
                <!-- ЗАКАЗЧИК Card -->
                <Border x:Name="CardClient" Background="{DynamicResource SectionBg}" CornerRadius="{DynamicResource Radius.Md}" Padding="{DynamicResource Pad.Section}" Margin="{DynamicResource Gap.Block}" Opacity="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.Block}">
                            <TextBlock Style="{DynamicResource FluentIconSection}" Text="&#xE77B;"/>
                            <TextBlock Text="ЗАКАЗЧИК" Style="{DynamicResource SectionLabel}" Margin="{DynamicResource Gap.None}"/>
                        </StackPanel>
                        <StackPanel x:Name="ContentClient" Visibility="Visible">
                            <TextBlock Text="Телефон" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="TxtClientPhone" Margin="{DynamicResource Gap.BlockLg}"
                                     Text="{Binding ClientInfo.ClientPhone, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="False"
                                     GotFocus="SelectAll_OnFocus"/>
                            <TextBlock Text="Адрес" Style="{DynamicResource FieldLabel}"/>
                            <TextBox x:Name="TxtClientAddress" Margin="{DynamicResource Gap.None}"
                                     Text="{Binding ClientInfo.ClientAddress, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="False"
                                     GotFocus="SelectAll_OnFocus"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ДОГОВОР Card -->
                <Border x:Name="CardContract" Background="{DynamicResource SectionBg}" CornerRadius="{DynamicResource Radius.Md}" Padding="{DynamicResource Pad.Section}" Margin="{DynamicResource Gap.Block}" Opacity="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.Block}">
                            <TextBlock Style="{DynamicResource FluentIconSection}" Text="&#xE8A5;"/>
                            <TextBlock Text="ДОГОВОР" Style="{DynamicResource SectionLabel}" Margin="{DynamicResource Gap.None}"/>
                        </StackPanel>
                        <StackPanel x:Name="ContentContract" Visibility="Visible">
                        <TextBlock Text="Номер" Style="{DynamicResource FieldLabel}"/>
                        <Grid Margin="{DynamicResource Gap.BlockLg}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtContractPrefix" Text="1"
                                     TextChanged="TxtContractPrefix_TextChanged"
                                     LostFocus="TxtContractPrefix_LostFocus"
                                     HorizontalContentAlignment="Center" Padding="{DynamicResource Pad.ControlSm}"
                                     GotFocus="SelectAll_OnFocus"/>
                            <TextBlock Grid.Column="1" Text="&#x2014;" VerticalAlignment="Center" Margin="{DynamicResource Gap.InlineSm}" Foreground="{DynamicResource TextMuted}" FontWeight="Medium"/>
                            <TextBox x:Name="TxtContractNumber" Grid.Column="2"
                                     Text="{Binding ClientInfo.ContractNumber, Mode=OneWay}"
                                     IsReadOnly="True" HorizontalContentAlignment="Center"
                                     IsTabStop="False"
                                     Style="{DynamicResource ReadOnlyTextBox}" Padding="{DynamicResource Pad.ControlSm}"/>
                        </Grid>
                        <TextBlock Text="Дата" Style="{DynamicResource FieldLabel}"/>
                        <DatePicker x:Name="DpContractDate" Margin="{DynamicResource Gap.BlockLg}"
                                    SelectedDate="{Binding ClientInfo.ContractDate}"/>
                        <TextBlock Text="Статус" Style="{DynamicResource FieldLabel}"/>
                        <!-- v3.50: status pill — colored dot + existing ComboBox
                             (same ItemsSource/handling in MainWindow; only visuals).
                             Dot color mirrors the badge colors of the chosen status. -->
                        <Border Background="{DynamicResource SectionBg}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Md}" Padding="{DynamicResource Pad.InputH}" Height="34">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Grid.Column="0"
                                         Width="9" Height="9" VerticalAlignment="Center"
                                         Margin="{DynamicResource Gap.Inline}"
                                         Fill="{DynamicResource Accent}"/>
                                <ComboBox x:Name="CmbStatus" Grid.Column="1"
                                          IsEditable="False"
                                          Background="Transparent" BorderThickness="0"
                                          VerticalContentAlignment="Center"
                                          SelectionChanged="CmbStatus_SelectionChanged"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Статус не блокирует редактирование заказа — справочная метка для менеджера и истории."
                                   FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TextMuted}"
                                   TextWrapping="Wrap" Margin="{DynamicResource Gap.BlockTop}"/>
                        </StackPanel>
                </StackPanel>
                </Border>

                <!-- ДОПОЛНИТЕЛЬНОЕ КП (UserControl) -->
                <controls:AdditionalKpsControl x:Name="CardAdditionalKp" Margin="{DynamicResource Gap.Block}"/>

                <!-- ПРИМЕЧАНИЯ Card -->
                <Border x:Name="CardNotes" Background="{DynamicResource SectionBg}" CornerRadius="{DynamicResource Radius.Md}" Padding="{DynamicResource Pad.Section}" Margin="{DynamicResource Gap.None}" Opacity="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.Block}">
                            <TextBlock Style="{DynamicResource FluentIconSection}" Text="&#xE70B;"/>
                            <TextBlock Text="ПРИМЕЧАНИЯ" Style="{DynamicResource SectionLabel}" Margin="{DynamicResource Gap.None}"/>
                        </StackPanel>
                        <StackPanel x:Name="ContentNotes" Visibility="Visible">
                            <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.Block}">
                                <Button x:Name="BtnBold" AutomationProperties.Name="Жирный" Content="Ж" FontWeight="Bold" Width="28" Height="24" Margin="{DynamicResource Gap.InlineSm}" Padding="{DynamicResource Pad.None}" Click="BtnBold_Click" Style="{DynamicResource GhostButton}" FontSize="{StaticResource Type.Body}" ToolTip="Жирный (выделите текст)"/>
                                <Button x:Name="BtnItalic" AutomationProperties.Name="Курсив" Content="К" FontStyle="Italic" Width="28" Height="24" Margin="{DynamicResource Gap.InlineSm}" Padding="{DynamicResource Pad.None}" Click="BtnItalic_Click" Style="{DynamicResource GhostButton}" FontSize="{StaticResource Type.Body}" ToolTip="Курсив (выделите текст)"/>
                                <Button x:Name="BtnColor" AutomationProperties.Name="Цвет текста" Content="A" Foreground="{DynamicResource Accent}" Width="28" Height="24" Margin="{DynamicResource Gap.InlineSm}" Padding="{DynamicResource Pad.None}" Click="BtnColor_Click" Style="{DynamicResource GhostButton}" FontSize="{StaticResource Type.Body}" FontWeight="Bold" ToolTip="Цвет текста (выделите текст)"/>
                                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=BtnColor}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <!-- Тень на пустой подложке (без контента): Effect на
                                         Border с контентом растрирует попап в текстуру и мылит
                                         текст (ClearType-фикс v3.53.1). Цвет захардкожен:
                                         DynamicResource не пробрасывается в Effect на Popup. -->
                                    <Grid>
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" Margin="{DynamicResource Gap.Window}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="{StaticResource ShadowColor}"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" Padding="{DynamicResource Pad.Section}">
                                            <UniformGrid Columns="5" Rows="3" >
                                            <!-- Row 1: classic colors -->
                                            <Border x:Name="SwatchRed" Background="{DynamicResource NotesColor.Red}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Красный"/>
                                            <Border x:Name="SwatchOrange" Background="{DynamicResource NotesColor.Orange}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Оранжевый"/>
                                            <Border x:Name="SwatchAmber" Background="{DynamicResource NotesColor.Amber}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Янтарный"/>
                                            <Border x:Name="SwatchGreen" Background="{DynamicResource NotesColor.Green}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Зелёный"/>
                                            <Border x:Name="SwatchTeal" Background="{DynamicResource NotesColor.Teal}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Бирюзовый"/>
                                            <!-- Row 2: blues & purples -->
                                            <Border x:Name="SwatchBlue" Background="{DynamicResource NotesColor.Blue}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Синий"/>
                                            <Border x:Name="SwatchIndigo" Background="{DynamicResource NotesColor.Indigo}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Индиго"/>
                                            <Border x:Name="SwatchPurple" Background="{DynamicResource NotesColor.Purple}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Фиолетовый"/>
                                            <Border x:Name="SwatchPink" Background="{DynamicResource NotesColor.Pink}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Розовый"/>
                                            <Border x:Name="SwatchBrown" Background="{DynamicResource NotesColor.Brown}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Коричневый"/>
                                            <!-- Row 3: dark & neutrals -->
                                            <Border x:Name="SwatchGray" Background="{DynamicResource NotesColor.Gray}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Серый"/>
                                            <Border x:Name="SwatchDark" Background="{DynamicResource NotesColor.Dark}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Тёмный"/>
                                            <Border x:Name="SwatchWhite" Background="{DynamicResource NotesColor.White}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Белый" BorderBrush="{DynamicResource Border}" BorderThickness="1"/>
                                            <Border x:Name="SwatchAccent" Background="{DynamicResource Accent}" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_Click" ToolTip="Акцентный"/>
                                            <!-- v3.55: свотч висел на ColorSwatch_Click, который читает
                                                 SolidColorBrush, а здесь фон — градиент, поэтому «любой
                                                 цвет» не срабатывал вовсе. Теперь у него свой обработчик. -->
                                            <Border x:Name="SwatchCustom" Width="24" Height="24" CornerRadius="{DynamicResource Radius.Sm}" Margin="{DynamicResource Gap.Swatch}" Cursor="Hand" MouseLeftButtonDown="ColorSwatch_CustomClick" ToolTip="Любой цвет...">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{StaticResource NotesColor.Crimson.Color}" Offset="0"/>
                                                        <GradientStop Color="{StaticResource NotesColor.Orange.Color}" Offset="0.25"/>
                                                        <GradientStop Color="{StaticResource NotesColor.Blue.Color}" Offset="0.5"/>
                                                        <GradientStop Color="{StaticResource NotesColor.Green.Color}" Offset="0.75"/>
                                                        <GradientStop Color="{StaticResource NotesColor.Purple.Color}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            </UniformGrid>
                                        </Border>
                                    </Grid>
                                </Popup>
                                <Button x:Name="BtnList" AutomationProperties.Name="Список" Content="• Список" Width="60" Height="24" Margin="{DynamicResource Gap.InlineSm}" Padding="{DynamicResource Pad.None}" Click="BtnList_Click" Style="{DynamicResource GhostButton}" FontSize="{StaticResource Type.Caption}" ToolTip="Список"/>
                                <Button x:Name="BtnClear" AutomationProperties.Name="Очистить форматирование" Content="✕" Width="28" Height="24" Margin="{DynamicResource Gap.None}" Padding="{DynamicResource Pad.None}" Click="BtnClear_Click" Style="{DynamicResource DangerGhostButton}" FontSize="{StaticResource Type.Body}" ToolTip="Очистить форматирование"/>
                            </StackPanel>
                            <!-- v3.55: поле примечаний — редактор с форматированием.
                                 Кнопки тулбара применяют формат к выделению, поэтому
                                 пользователь видит результат, а не «код» разметки, и
                                 отдельный предпросмотр больше не нужен: этот же
                                 редактор и есть предпросмотр. Хранимая строка
                                 (ClientInfo.Notes) осталась прежней разметкой —
                                 её читают печать КП, PDF и сохранённый заказ. -->
                            <RichTextBox x:Name="RtfNotes" Margin="{DynamicResource Gap.Block}"
                                         Height="150"
                                         AcceptsReturn="True"
                                         AutomationProperties.Name="Примечания"
                                         TextChanged="RtfNotes_TextChanged"
                                         LostFocus="RtfNotes_LostFocus"
                                         PreviewKeyDown="RtfNotes_PreviewKeyDown"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
    </ScrollViewer>
</Border>
</UserControl>
