<UserControl x:Class="MosquitoNetCalculator.Controls.TotalCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="CardTotal" CornerRadius="{DynamicResource Radius.Card}" Padding="{DynamicResource Pad.TotalCard}"
            Background="{DynamicResource TotalBg}" Margin="{DynamicResource Gap.BlockTopLg}"
            Style="{DynamicResource Card}" Opacity="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline2Xl}">
                <TextBlock FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource TotalTextMuted}" Text="ИТОГО"/>
                <TextBlock x:Name="TxtTotalSub" FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TotalTextMuted}" Margin="{DynamicResource Gap.BlockTopSm}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="{StaticResource Type.Display}" FontWeight="SemiBold" Foreground="{DynamicResource TotalText}" Margin="{DynamicResource Gap.Inline}"
                           Typography.NumeralAlignment="Tabular">
                    <Run x:Name="RunTotalAmount" Text="0.00"/>
                </TextBlock>
                <TextBlock FontSize="{StaticResource Type.Body}" Foreground="{DynamicResource TotalTextMuted}" VerticalAlignment="Center" Margin="{DynamicResource Gap.CurrencyUnit}">
                    <Run Text="руб."/>
                </TextBlock>
                <!-- Copy total to clipboard button -->
                <Button x:Name="BtnCopyTotal" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="{DynamicResource TotalTextMuted}"
                        Click="BtnCopyTotal_Click"
                        ToolTip="Копировать сумму в буфер обмена">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource Radius.Md}" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TotalSheen}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TotalText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock x:Name="TxtCopyIcon" Text="&#xE8C8;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Body}"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="TxtAmountInWords" FontSize="{StaticResource Type.Caption}"
                           Foreground="{DynamicResource TotalTextMuted}"
                           TextWrapping="Wrap" MaxWidth="380" TextAlignment="Right"/>
                <!-- v3.50: right-side meta line (prototype totals .right):
                     «Позиций: N» + undo hint -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Gap.BlockTop}">
                    <TextBlock x:Name="TxtPositionsMeta" FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TotalTextMuted}"/>
                    <TextBlock FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TotalTextMuted}"
                               Margin="{DynamicResource Gap.LeftLg}"
                               ToolTip="Ctrl+Z — отменить последнее действие">
                        <Run Text="Ctrl+Z" FontFamily="{DynamicResource Font.Mono}" FontSize="{StaticResource Type.Caption}"/>
                        <Run Text="— отменить удаление"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
