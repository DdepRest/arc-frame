<UserControl x:Class="MosquitoNetCalculator.Controls.AdminPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Чекбокс отвязки на чипе устройства (компактный, в стиле DialogCheckBox
             из AiApiKeyDialog — общий стиль не выносим, тут он один). -->
        <Style x:Key="AdminDeviceCheckBox" TargetType="CheckBox">
            <!-- UX-10: focusable so the unbind checkbox is reachable by keyboard
                 (Tab + Space); the focus ring is drawn by FluentFocusVisual. -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="CheckBorder" Width="16" Height="16" CornerRadius="{DynamicResource Radius.Sm}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource TextMuted}" BorderThickness="1.5">
                            <TextBlock x:Name="CheckMark" Text="✓" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource OnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
</Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ШАПКА РАЗДЕЛА                                           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="20,16,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Состояние офисов"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="TxtLatestVersion"
                           Text="Последняя версия: …"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,4,0,0"/>
                <!-- Тонкая строка «обновлено X · авто через Y» -->
                <TextBlock x:Name="TxtRefreshStatus"
                           Text=""
                           FontSize="11"
                           Foreground="{DynamicResource TextMuted}"
                           Opacity="0.7"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Кнопки: обновить + очистить дубли -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRefresh"
                        Style="{StaticResource AccentBorderButton}"
                        Margin="12,0,0,0"
                        Padding="14,6"
                        FontSize="12"
                        ToolTip="Проверить отчёты офисов и последнюю версию"
                        Click="BtnRefresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="BtnRefreshIcon" Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="BtnRefreshLabel" Text="Обновить" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- UX-13: rare maintenance action moved into a ⋯ overflow menu —
                     the header keeps only the frequent «Обновить» primary. -->
                <Button x:Name="BtnMoreActions"
                        Style="{StaticResource AccentBorderButton}"
                        Margin="8,0,0,0"
                        Padding="10,6"
                        FontSize="12"
                        ToolTip="Дополнительные действия"
                        Click="BtnMoreActions_Click">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- БАННЕРЫ                                                 -->
        <!-- ═══════════════════════════════════════════ легаси -->
        <StackPanel Grid.Row="1" Margin="20,0,20,6">
            <Border x:Name="BannerNotConfigured"
                    Background="{DynamicResource BadgeWarningBg}"
                    CornerRadius="{DynamicResource Radius.Lg}"
                    Padding="12,9"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" Foreground="{DynamicResource BadgeWarningFg}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtBanner"
                               FontSize="12.5"
                               Foreground="{DynamicResource BadgeWarningFg}"
                               TextWrapping="Wrap"
                               Text="Токен хранилища отчётов не настроен: отчёты не отправляются, панель недоступна. Владельцу нужно встроить токен в сборку (env OFFICE_REPORT_TOKEN или файл .office-report-token — см. csproj)."/>
                </StackPanel>
            </Border>

            <Border x:Name="BannerNoConnection"
                    Background="{DynamicResource BadgeDangerBg}"
                    CornerRadius="{DynamicResource Radius.Lg}"
                    Padding="12,9"
                    Margin="0,0,0,8"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" Foreground="{DynamicResource BadgeDangerFg}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Не удалось получить свежие данные — показаны последние известные результаты. Проверьте подключение к интернету и попробуйте «Обновить»."
                               FontSize="12.5"
                               Foreground="{DynamicResource BadgeDangerFg}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ВКЛАДКИ                                                 -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <TabControl Grid.Row="2" Margin="16,0,16,16">
            <!-- ─── Обновления ─── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" Style="{StaticResource FluentIconTab}" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="Обновления"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- сводка + быстрые действия -->
                        <RowDefinition Height="Auto"/>   <!-- поиск + фильтры -->
                        <RowDefinition Height="*"/>      <!-- список -->
                    </Grid.RowDefinitions>

                    <!-- Большая сводная карточка + быстрые действия -->
                    <Border Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Lg}"
                            Padding="16,12"
                            Margin="4,8,4,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22"
                                           Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSummary" Text="— из — актуальны"
                                               FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <!-- Текст подсказки — единственный владелец: RefreshAsync -->
                                    <TextBlock x:Name="TxtSummaryHint"
                                               Text=""
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           x:Name="TxtSummaryBadge"
                                           Text=""
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Прогресс обновлений: тонкая полоса под сводкой
                                 (ширина заливки задаётся кодом — UpdateSummaryProgress). -->
                            <Grid Grid.Row="1" x:Name="ProgressSummaryHost" Margin="0,10,0,0" Visibility="Collapsed"
                                  SizeChanged="ProgressSummaryHost_SizeChanged">
                                <Border Background="{DynamicResource ChipBg}" CornerRadius="{DynamicResource Radius.Sm}" Height="6">
                                    <Border x:Name="ProgressSummaryFill" CornerRadius="{DynamicResource Radius.Sm}" HorizontalAlignment="Left" Width="0"
                                            Background="{DynamicResource Success}"/>
                                </Border>
                            </Grid>

                            <!-- Быстрые действия -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BtnRemindAll"
                                        Style="{StaticResource AccentBorderButton}"
                                        Padding="12,5"
                                        FontSize="11.5"
                                        ToolTip="Скопировать одно общее напоминание об обновлении для всех устаревших офисов"
                                        Click="BtnRemindAll_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE789;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Отправить напоминание" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnUnbindMode"
                                        Style="{StaticResource AccentBorderButton}"
                                        Padding="12,5"
                                        FontSize="11.5"
                                        Margin="8,0,0,0"
                                        ToolTip="Отметить устройства и удалить их привязки из хранилища. Устройство само вернётся со своим следующим отчётом — уже под актуальным офисом."
                                        Click="BtnUnbindMode_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8EE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="TxtUnbindModeLabel" Text="Отвязать выбранные" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Плашка режима отвязки -->
                                <Border x:Name="UnbindModeBanner" Visibility="Collapsed"
                                        Background="{DynamicResource BadgeWarningBg}"
                                        CornerRadius="{DynamicResource Radius.Md}" Padding="10,5" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtUnbindBanner" Text="Отметьте устройства для отвязки"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BadgeWarningFg}"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- Недавно отвязанные (сессия): gist после удаления
                                     ничего о них не несёт — честный in-session маркер,
                                     живёт до первого отчёта устройства (PruneJustUnbound). -->
                                <TextBlock x:Name="TxtJustUnbound" Visibility="Collapsed"
                                           FontSize="10.5" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Поиск + фильтры по статусу -->
                    <StackPanel Grid.Row="1" Margin="4,2,4,8">
                        <Grid>
                            <TextBox x:Name="TxtSearch" Height="32" Padding="30,5,30,5" FontSize="12"
                                     BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                     Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <Button x:Name="BtnClearSearch" Visibility="Collapsed" Content="✕" Width="22" Height="22"
                                    Click="BtnClearSearch_Click" Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextMuted}" Cursor="Hand" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Очистить поиск"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <!-- Чипы-фильтры: ToggleButton-подобные кнопки с Checked-состоянием.
                                 Один фильтр активен (радио-поведение в code-behind). -->
                            <Border x:Name="ChipFilterAll" CornerRadius="{DynamicResource Radius.Md}" Padding="11,5" Margin="0,0,6,0"
                                    Cursor="Hand" MouseLeftButtonUp="ChipFilter_Click" KeyDown="ChipFilter_KeyDown"
                                    Focusable="True" FocusVisualStyle="{StaticResource FluentFocusVisual}"
                                    Tag="All"
                                    Background="{DynamicResource Accent}" ToolTip="Показать все офисы">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="All">
                                                <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ChipAllText" Text="Все" FontSize="11.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, ElementName=ChipFilterAll}" Value="All">
                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ChipFilterOutdated" CornerRadius="{DynamicResource Radius.Md}" Padding="11,5" Margin="0,0,6,0"
                                    Cursor="Hand" MouseLeftButtonUp="ChipFilter_Click" KeyDown="ChipFilter_KeyDown"
                                    Focusable="True" FocusVisualStyle="{StaticResource FluentFocusVisual}"
                                    Tag="Outdated"
                                    ToolTip="Только офисы с устаревшими устройствами">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="Outdated">
                                                <Setter Property="Background" Value="{DynamicResource BadgeWarningBg}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BadgeWarningFg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, ElementName=ChipFilterOutdated}" Value="Outdated">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Устаревшие" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, ElementName=ChipFilterOutdated}" Value="Outdated">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ChipFilterUpToDate" CornerRadius="{DynamicResource Radius.Md}" Padding="11,5" Margin="0,0,6,0"
                                    Cursor="Hand" MouseLeftButtonUp="ChipFilter_Click" KeyDown="ChipFilter_KeyDown"
                                    Focusable="True" FocusVisualStyle="{StaticResource FluentFocusVisual}"
                                    Tag="UpToDate">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="UpToDate">
                                                <Setter Property="Background" Value="{DynamicResource BadgeSuccessBg}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BadgeSuccessFg}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, ElementName=ChipFilterUpToDate}" Value="UpToDate">
                                                        <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Актуальные" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, ElementName=ChipFilterUpToDate}" Value="UpToDate">
                                                        <Setter Property="Foreground" Value="{DynamicResource Success}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ChipFilterNoData" CornerRadius="{DynamicResource Radius.Md}" Padding="11,5"
                                    Cursor="Hand" MouseLeftButtonUp="ChipFilter_Click" KeyDown="ChipFilter_KeyDown"
                                    Focusable="True" FocusVisualStyle="{StaticResource FluentFocusVisual}"
                                    Tag="NoData">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="NoData">
                                                <Setter Property="Background" Value="{DynamicResource BadgeDangerBg}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9CE;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11.5" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource BadgeDangerFg}"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Нет данных" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Tag, ElementName=ChipFilterNoData}" Value="NoData">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="4,0,4,8">
                        <Grid>
                            <!-- Список карточек с группировкой по статусу -->
                            <ItemsControl x:Name="OfficesList" ItemsSource="{Binding GroupedRows}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2,2,0,7">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextMuted}"/>
                                                    <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}" Opacity="0.7"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="{DynamicResource Radius.Lg}" Margin="0,0,0,10" Padding="0"
                                                Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Outdated">
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="ToolTip" Value="Нажмите, чтобы скопировать напоминание об обновлении"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <!-- Цветная полоса статуса слева (v3.52.0): ЛЕВАЯ ГРАНИЦА
                                                 внутреннего Border — рамка Border обводит скруглённый контур,
                                                 поэтому полоса повторяет радиус карточки (11 = 12 радиус
                                                 карточки минус 1px её рамки). Квадратный прямоугольник Width=4
                                                 торчал в скруглённом углу карточки — та же правка, что и в
                                                 карточках «Истории обновлений» (CardStripeCornerTests). -->
                                            <Border BorderThickness="4,0,0,0"
                                                    CornerRadius="{DynamicResource Radius.StripeInner}"
                                                    BorderBrush="{Binding Status, Converter={StaticResource OfficeStatusStripeBrush}}">
                                                <StackPanel Margin="12,10,14,10">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LocationName}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource ChipBg}"
                                                                CornerRadius="{DynamicResource Radius.Md}" Padding="7,2"
                                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Prefix, StringFormat=Офис {0}}"
                                                                       FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AccentLight}"
                                                                CornerRadius="{DynamicResource Radius.Md}" Padding="7,2"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="Collapsed">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrentOffice}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="этот офис"
                                                                       FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Accent}"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <!-- Кол-во устройств офиса -->
                                                        <Border Background="{DynamicResource ChipBg}"
                                                                CornerRadius="{DynamicResource Radius.Md}" Padding="7,2"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="Visible">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DeviceCount}" Value="0">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding DeviceCountDisplay}"
                                                                       FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <!-- Бейдж статуса справа от заголовка -->
                                                        <Border VerticalAlignment="Center" Margin="10,0,0,0"
                                                                CornerRadius="{DynamicResource Radius.Md}" Padding="10,5"
                                                                Background="{Binding Status, Converter={StaticResource OfficeStatusBadgeBg}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding StatusGlyph}"
                                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           FontSize="12" FontWeight="Bold"
                                                                           Foreground="{Binding Status, Converter={StaticResource OfficeStatusBadgeFg}}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="{Binding Status, Converter={StaticResource OfficeStatusBadgeFg}}"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <TextBlock Text="Отчёт:"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LastReportDisplay}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                        <!-- Мини-прогресс «2/3» с тонкой полосой -->
                                                        <Border Background="{DynamicResource ChipBg}" CornerRadius="{DynamicResource Radius.Md}" Padding="8,3"
                                                                Margin="12,0,0,0" VerticalAlignment="Center"
                                                                ToolTip="Сколько устройств офиса в актуальной версии">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="34" Height="5" CornerRadius="2.5"
                                                                        Background="{DynamicResource Border}" VerticalAlignment="Center">
                                                                    <Border Width="{Binding ProgressWidth}"
                                                                            HorizontalAlignment="Left" CornerRadius="2.5"
                                                                            Background="{DynamicResource Success}"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding ProgressText}"
                                                                           FontSize="10.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondary}"
                                                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                    <!-- Устройства офиса: версия и статус каждого ПК -->
                                                    <WrapPanel Margin="0,6,0,0" Visibility="Visible">
                                                        <WrapPanel.Style>
                                                            <Style TargetType="WrapPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </WrapPanel.Style>
                                                        <TextBlock Text="Устройства:"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,4"/>
                                                        <ItemsControl ItemsSource="{Binding Devices}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <!-- Чип устройства: имя · версия · статус,
                                                                         в режиме отвязки — с чекбоксом. -->
                                                                    <Border Background="{Binding Status, Converter={StaticResource OfficeStatusBadgeBg}}"
                                                                            CornerRadius="{DynamicResource Radius.Md}"
                                                                            Padding="7,3"
                                                                            Margin="0,0,6,4"
                                                                            ToolTip="{Binding ToolTipText}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <CheckBox x:Name="DeviceUnbindCheck" Margin="0,0,6,0"
                                                                                      Style="{StaticResource AdminDeviceCheckBox}"
                                                                                      Visibility="{Binding Tag, ElementName=OfficesList, Converter={StaticResource UnbindModeToVisibility}}"
                                                                                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Checked="DeviceUnbindCheck_Changed" Unchecked="DeviceUnbindCheck_Changed"
                                                                                      ToolTip="Отметить для отвязки"/>
                                                                            <TextBlock Text="{Binding DeviceLabel}"
                                                                                       FontSize="11" FontWeight="SemiBold"
                                                                                       Foreground="{Binding Status, Converter={StaticResource OfficeStatusBadgeFg}}"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding Version}"
                                                                                       FontSize="11" FontWeight="SemiBold"
                                                                                       Foreground="{Binding Status, Converter={StaticResource OfficeStatusBadgeFg}}"
                                                                                       Margin="5,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding StatusGlyph}"
                                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                       FontSize="11" FontWeight="Bold"
                                                                                       Foreground="{Binding Status, Converter={StaticResource OfficeStatusBadgeFg}}"
                                                                                       Margin="5,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                            <TextBlock Text="{Binding LastSeenHint}"
                                                                                       FontSize="10.5"
                                                                                       Foreground="{Binding Status, Converter={StaticResource OfficeStatusBadgeFg}}"
                                                                                       Margin="6,0,0,0"
                                                                                       VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Пустое состояние -->
                            <StackPanel x:Name="UpdatesEmpty"
                                        Style="{DynamicResource EmptyState.Panel}"
                                        Visibility="Collapsed">
                                <TextBlock Text="&#xE8B7;"
                                           Style="{DynamicResource EmptyState.Icon}"/>
                                <TextBlock x:Name="UpdatesEmptyTitle" Text="Отчёты ещё не получены"
                                           Style="{DynamicResource EmptyState.Title}"/>
                                <TextBlock x:Name="UpdatesEmptyHint" Text="Запустите программу в каждом офисе — здесь появятся статусы."
                                           Style="{DynamicResource EmptyState.Hint}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ─── Статистика ─── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource FluentIconTab}" Foreground="{DynamicResource Accent}"/>
                        <TextBlock Text="Статистика"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Сводная карточка -->
                    <Border Grid.Row="0"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Lg}"
                            Padding="16,12"
                            Margin="4,8,4,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="&#xE8F1;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="22"
                                       Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatsTotal" Text="Всего заказов: …"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Данные обновляются автоматически, пока программа открыта."
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       x:Name="TxtStatsTotalBadge"
                                       Text=""
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="4,0,4,8">
                        <Grid>
                            <ItemsControl x:Name="StatsList" ItemsSource="{Binding StatsRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Surface}"
                                                BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Lg}"
                                                Margin="0,0,0,10"
                                                Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding LocationName}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource ChipBg}"
                                                                CornerRadius="{DynamicResource Radius.Md}" Padding="7,2"
                                                                Margin="10,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Prefix, StringFormat=Офис {0}}"
                                                                       FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource AccentLight}"
                                                                CornerRadius="{DynamicResource Radius.Md}" Padding="7,2"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="Collapsed">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrentOffice}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="этот офис"
                                                                       FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Accent}"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <!-- Кол-во устройств офиса -->
                                                        <Border Background="{DynamicResource ChipBg}"
                                                                CornerRadius="{DynamicResource Radius.Md}" Padding="7,2"
                                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                                Visibility="Visible">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DeviceCount}" Value="0">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding DeviceCountDisplay}"
                                                                       FontSize="10.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondary}"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <TextBlock Text="Отчёт:"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding LastReportDisplay}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondary}"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Большое число заказов справа -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="Заказы"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding OrderCountDisplay}"
                                                               FontSize="26" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="StatsEmpty"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="20,40,20,40">
                                <TextBlock Text="&#xE9F9;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="42"
                                           Foreground="{DynamicResource TextMuted}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Статистика появится после первого отчёта"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Center"
                                           Margin="0,10,0,4"/>
                                <TextBlock Text="Программа в офисе должна поработать хотя бы раз."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMuted}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="380"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
