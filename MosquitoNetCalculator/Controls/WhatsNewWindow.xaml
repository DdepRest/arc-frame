<Window x:Class="MosquitoNetCalculator.Controls.WhatsNewWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Что нового"
        Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Lg}"
            Margin="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Opacity="0.25"
                              Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="{DynamicResource Radius.CardHeader}"
                    Height="32"
                    Padding="14,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Что нового"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <!-- UX-14: shared DialogCloseButton (was a private 60-line copy) -->
                    <Button Grid.Column="1"
                            Width="40" Height="40"
                            Style="{DynamicResource DialogCloseButton}"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource Font.Icon}" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>
            <Border Grid.Row="1"
                    Background="{DynamicResource Accent}"
                    CornerRadius="{DynamicResource Radius.Md}"
                    Padding="12,5"
                    HorizontalAlignment="Left"
                    Margin="24,14,24,0">
                <TextBlock x:Name="VersionText"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource OnAccent}"/>
            </Border>

            <ScrollViewer x:Name="ChangelogScroll"
                          Grid.Row="2"
                          MaxHeight="220"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="24,14,24,0">
                <StackPanel x:Name="ChangelogPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="NoChangelogText"
                       Grid.Row="2"
                       Text="Список изменений недоступен."
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       FontStyle="Italic"
                       Margin="24,14,24,0"
                       Visibility="Collapsed"/>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,20,24,20">
                <!-- v3.51: переход в полную «Историю обновлений» -->
                <Button x:Name="BtnOpenHistory"
                        Content="Вся история →"
                        Style="{DynamicResource GhostButton}"
                        MinWidth="110"
                        Padding="14,7"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="{DynamicResource Gap.Inline}"
                        ToolTip="Открыть полную историю обновлений"
                        Click="BtnOpenHistory_Click"/>
                <Button x:Name="BtnOk"
                        Content="Понятно"
                        Style="{DynamicResource PrimaryButton}"
                        MinWidth="110"
                        Padding="16,7"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsDefault="True"
                        IsCancel="True"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
