<UserControl x:Class="MosquitoNetCalculator.Controls.QuickAddControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Anwis segmented control: shared segment styles -->
        <Style x:Key="SegText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Caption}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="SegBase" TargetType="Border">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="SegLeft" TargetType="Border" BasedOn="{StaticResource SegBase}">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.StripeLeft}"/>
        </Style>
        <Style x:Key="SegMid" TargetType="Border" BasedOn="{StaticResource SegBase}">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.None}"/>
        </Style>
        <Style x:Key="SegRight" TargetType="Border" BasedOn="{StaticResource SegBase}">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.StripeRight}"/>
        </Style>
    </UserControl.Resources>
    <Border x:Name="CardQuickAdd" Background="{DynamicResource QuickBg}" CornerRadius="{DynamicResource Radius.Card}"
            Padding="{DynamicResource Pad.Control}" Margin="{DynamicResource Gap.Section}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            Style="{DynamicResource Card}" Opacity="0">
        <StackPanel>
            <!-- Header bar: Title + Quick Search + Repeat (F2) -->
            <Grid Margin="{DynamicResource Gap.BlockSm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Быстрый ввод"
                           FontSize="{StaticResource Type.Body}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>

                <!-- Quick Search (Center-right aligned, compact, calm) -->
                <Grid Grid.Column="1" HorizontalAlignment="Right" Width="240" Margin="{DynamicResource Gap.InlineLg}" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;"
                               FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource Gap.InlineSm}"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="TxtQuickSearch" Style="{DynamicResource QuickInput}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TxtQuickSearch_TextChanged"
                                 KeyDown="TxtQuickSearch_KeyDown"
                                 GotFocus="TxtQuickSearch_GotFocus"
                                 LostFocus="TxtQuickSearch_LostFocus"
                                 ToolTip="Поиск типа сетки по каталогу"/>
                        <TextBlock Text="Поиск по каталогу..."
                                   Margin="{DynamicResource Gap.Left}"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource TextMuted}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtQuickSearch}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Popup x:Name="SearchPopup" AllowsTransparency="True" IsOpen="False"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=TxtQuickSearch}"
                               PopupAnimation="Slide" StaysOpen="True">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                    BorderThickness="1" CornerRadius="{DynamicResource Radius.Md}" Margin="{DynamicResource Gap.BlockTopSm}" Padding="{DynamicResource Pad.ControlSm}"
                                    SnapsToDevicePixels="True" MinWidth="220" MaxHeight="260">
                                <ListBox x:Name="SearchSuggestions" BorderThickness="0" Background="Transparent"
                                         SelectionChanged="SearchSuggestions_SelectionChanged"
                                         PreviewMouseDown="SearchSuggestions_PreviewMouseDown" FontSize="{StaticResource Type.Body}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            <Setter Property="Padding" Value="{DynamicResource Pad.ControlSm}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                BorderThickness="0" CornerRadius="{DynamicResource Radius.Sm}"
                                                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                            </Trigger>
                                                            <MultiTrigger>
                                                                <MultiTrigger.Conditions>
                                                                    <Condition Property="IsSelected" Value="True"/>
                                                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                                                </MultiTrigger.Conditions>
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                                            </MultiTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button x:Name="BtnClearQuickSearch" Grid.Column="2"
                            Style="{DynamicResource GhostButton}"
                            Content="&#xE711;" FontFamily="{DynamicResource Font.Icon}"
                            FontSize="{StaticResource Type.Caption}" Padding="{DynamicResource Pad.ControlSm}" Margin="{DynamicResource Gap.LeftSm}" Cursor="Hand"
                            Visibility="Collapsed"
                            Click="BtnClearQuickSearch_Click"
                            ToolTip="Очистить поиск"/>
                </Grid>

                <!-- Repeat button -->
                <Button x:Name="BtnRepeat" Grid.Column="2"
                        Style="{DynamicResource GhostButton}"
                        IsEnabled="False"
                        Padding="{DynamicResource Pad.Pill}" FontSize="{StaticResource Type.Caption}"
                        Click="BtnRepeat_Click"
                        ToolTip="Повторить последнюю позицию (F2)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B7;" FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="{StaticResource Type.Caption}" VerticalAlignment="Center" Margin="{DynamicResource Gap.InlineSm}"/>
                        <TextBlock Text="Повторить" VerticalAlignment="Center"/>
                        <TextBlock Text="F2" FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold" Margin="{DynamicResource Gap.Left}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontFamily="{DynamicResource Font.Mono}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Fields row -->
            <Grid Margin="{DynamicResource Gap.BlockSm}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- Group 1: Product (Тип + Цвет / Свой товар) -->
                    <ColumnDefinition Width="1.2*"/> <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.2*"/> <ColumnDefinition Width="16"/>
                    <!-- Group 2: Dimensions (Ширина + Высота) -->
                    <ColumnDefinition Width="1*"/> <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/> <ColumnDefinition Width="16"/>
                    <!-- Group 3: Qty + Price -->
                    <ColumnDefinition Width="0.6*"/> <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="0.9*"/> <ColumnDefinition Width="16"/>
                    <!-- Action: Add Button -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Group 1: Product -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Тип" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox x:Name="CmbQuickType" Style="{DynamicResource QuickCombo}"
                              SelectionChanged="CmbQuickType_SelectionChanged"/>
                </StackPanel>
                <!-- Custom name box — visible only when «Свой товар» is selected -->
                <StackPanel Grid.Row="0" Grid.Column="2" x:Name="PanelCustomName" Visibility="Collapsed">
                    <TextBlock Text="Название" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TxtCustomName" Style="{DynamicResource QuickInput}"
                             HorizontalContentAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" x:Name="PanelColor">
                    <TextBlock Text="Цвет" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox x:Name="CmbQuickColor" Style="{DynamicResource QuickCombo}"
                              SelectionChanged="CmbQuickColor_SelectionChanged"/>
                </StackPanel>

                <!-- Group 2: Dimensions -->
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="Ширина, мм" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TxtQuickWidth" Style="{DynamicResource QuickInput}"
                             TextChanged="QuickField_TextChanged"
                             KeyDown="QuickField_KeyDown"
                             GotFocus="QuickField_GotFocus"
                             LostFocus="QuickField_LostFocus"
                             HorizontalContentAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Text="Высота, мм" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TxtQuickHeight" Style="{DynamicResource QuickInput}"
                             TextChanged="QuickField_TextChanged"
                             KeyDown="QuickField_KeyDown"
                             GotFocus="QuickField_GotFocus"
                             LostFocus="QuickField_LostFocus"
                             HorizontalContentAlignment="Right"/>
                </StackPanel>

                <!-- Group 3: Qty & Price -->
                <StackPanel Grid.Row="0" Grid.Column="8">
                    <TextBlock Text="Кол-во" Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TxtQuickQty" Text="1" Style="{DynamicResource QuickInput}"
                             TextChanged="QuickField_TextChanged"
                             KeyDown="QuickField_KeyDown"
                             GotFocus="SelectAll_OnFocus"
                             LostFocus="QuickField_LostFocus"
                             HorizontalContentAlignment="Right"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="10">
                    <TextBlock Text="Цена, руб." Style="{DynamicResource FieldLabel}"/>
                    <TextBox x:Name="TxtQuickPrice" Style="{DynamicResource QuickInput}"
                             TextChanged="QuickField_TextChanged"
                             KeyDown="QuickField_KeyDown"
                             LostFocus="TxtQuickPrice_LostFocus"
                             GotFocus="SelectAll_OnFocus"
                             HorizontalContentAlignment="Right"/>
                </StackPanel>

                <!-- Add button aligned with inputs -->
                <Button x:Name="BtnAdd" Grid.Row="0" Grid.Column="12" Style="{DynamicResource CompactAddButton}"
                        Click="BtnQuickAdd_Click" ToolTip="Добавить в заказ (Enter)"
                        VerticalAlignment="Bottom" Height="32">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE710;"/>
                        <TextBlock Text="Добавить"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Anwis segmented control — dedicated row, visible only when applicable -->
            <StackPanel x:Name="PanelAnwisModes"
                        Orientation="Horizontal"
                        Visibility="Collapsed"
                        Opacity="0"
                        Margin="{DynamicResource Gap.Top}">
                <StackPanel.RenderTransform>
                    <TranslateTransform X="0" Y="0"/>
                </StackPanel.RenderTransform>
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Control}" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="PillBB60" Style="{DynamicResource SegLeft}" Cursor="Hand"
                                PreviewMouseLeftButtonDown="AnwisModePill_Click">
                            <TextBlock Text="ББ 60" Style="{DynamicResource SegText}"/>
                        </Border>
                        <Rectangle x:Name="Sep1" Width="1" Fill="{DynamicResource Border}"/>
                        <Border x:Name="PillBB70" Style="{DynamicResource SegMid}" Cursor="Hand"
                                PreviewMouseLeftButtonDown="AnwisModePill_Click">
                            <TextBlock Text="ББ 70" Style="{DynamicResource SegText}"/>
                        </Border>
                        <Rectangle x:Name="Sep2" Width="1" Fill="{DynamicResource Border}"/>
                        <Border x:Name="PillPP" Style="{DynamicResource SegMid}" Cursor="Hand"
                                PreviewMouseLeftButtonDown="AnwisModePill_Click">
                            <TextBlock Text="ПП" Style="{DynamicResource SegText}"/>
                        </Border>
                        <Rectangle x:Name="Sep3" Width="1" Fill="{DynamicResource Border}"/>
                        <Border x:Name="PillProem" Style="{DynamicResource SegMid}" Cursor="Hand"
                                PreviewMouseLeftButtonDown="AnwisModePill_Click">
                            <TextBlock Text="Проём" Style="{DynamicResource SegText}"/>
                        </Border>
                        <Rectangle x:Name="Sep4" Width="1" Fill="{DynamicResource Border}"/>
                        <Border x:Name="PillGab" Style="{DynamicResource SegRight}" Cursor="Hand"
                                PreviewMouseLeftButtonDown="AnwisModePill_Click">
                            <TextBlock Text="Габарит" Style="{DynamicResource SegText}"/>
                        </Border>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource Gap.Left}">
                    <TextBlock Text="&#xE946;" FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource Gap.InlineSm}"/>
                    <TextBlock x:Name="TxtAnwisModeHint" FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <!-- Modifiers & Live Preview Bar (2 zones: Modifiers on Left, Live Calc on Right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Anticat toggle -->
                <ToggleButton x:Name="TbtnAnticat" Grid.Column="0"
                              Content="Антикошка  +2000 ₽/м²"
                              FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="{DynamicResource Gap.Top}" Padding="{DynamicResource Pad.Row}"
                              Visibility="Collapsed"
                              Click="TbtnAnticat_Click">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="{DynamicResource Surface}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{DynamicResource Radius.Md}"
                                                Padding="{TemplateBinding Padding}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource Accent}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource OnAccent}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource AccentLight}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource Accent}"/>
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource AccentHover}"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <!-- Right Zone: Live Calculation Preview Chip -->
                <Border x:Name="PreviewChip" Grid.Column="2" Background="{DynamicResource ChipBg}"
                        CornerRadius="{DynamicResource Radius.Capsule}" Padding="{DynamicResource Pad.Row}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="{DynamicResource Gap.Top}" Visibility="Collapsed">
                    <TextBlock x:Name="TxtQuickPreview" FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource Accent}"/>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
