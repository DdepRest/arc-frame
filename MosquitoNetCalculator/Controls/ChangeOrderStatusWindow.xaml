<Window x:Class="MosquitoNetCalculator.Controls.ChangeOrderStatusWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:MosquitoNetCalculator.Models"
        Title=""
        Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Lg}"
            Margin="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Opacity="0.25"
                              Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="{DynamicResource Radius.CardHeader}"
                    Height="32"
                    Padding="14,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"
                               Text="Изменить статус заказа"/>
                    <!-- UX-14: shared DialogCloseButton (was a private 60-line copy) -->
                    <Button Grid.Column="1"
                            Width="40" Height="40"
                            Style="{DynamicResource DialogCloseButton}"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="{DynamicResource Font.Icon}"
                                   FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content: order header + status combo -->
            <StackPanel Grid.Row="1" Margin="24,20,24,12">
                <TextBlock x:Name="OrderHeaderText"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="{DynamicResource Gap.BlockLg}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="Новый статус:"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="StatusCombo"
                          ItemsSource="{x:Static models:OrderStatuses.All}"
                          FontSize="12"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="24,0,24,20">
                <Button x:Name="BtnCancel"
                        Style="{DynamicResource GhostButton}"
                        Content="Отмена"
                        MinWidth="90"
                        Padding="16,7"
                        Margin="{DynamicResource Gap.Inline}"
                        FontSize="12"
                        Click="BtnCancel_Click"
                        IsCancel="True"/>
                <Button x:Name="BtnSave"
                        Style="{DynamicResource PrimaryButton}"
                        Content="Сохранить"
                        MinWidth="90"
                        Padding="16,7"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Click="BtnSave_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
