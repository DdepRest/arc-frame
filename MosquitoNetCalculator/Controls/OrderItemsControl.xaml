<UserControl x:Class="MosquitoNetCalculator.Controls.OrderItemsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MosquitoNetCalculator.Converters">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- v3.50: таблица-шапка «Позиции заказа» + чип «Позиций: N» (prototype tbl-head).
             No Opacity=0 here: the entrance cascade (MainWindow.Animations) knows
             only its fixed card list — an unlisted element would stay invisible. -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Radius.CardHeader}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1,1,1,0"
                Padding="12,5"
                x:Name="TableHeadBar">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Позиции заказа" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Border x:Name="PosCountBadge" Background="{DynamicResource ChipBg}"
                        CornerRadius="{DynamicResource Radius.Capsule}" Padding="9,3" Margin="10,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="PosCountText" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"/>
                </Border>
                <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="14,0,0,0"
                           ToolTip="Заблокированные ячейки определяются типом товара">
                    <Run Text="&#xE72E;" FontFamily="{DynamicResource Font.Icon}" FontSize="11"/>
                    <Run Text=" заблокированные ячейки определяются типом товара"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border x:Name="CardTable" Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Radius.CardFooter}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1,0,1,1"
                Opacity="0"
                ClipToBounds="True">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,10000,10000" RadiusX="10" RadiusY="10"/>
            </Border.Clip>
            <DataGrid x:Name="OrderGrid"
                      ItemsSource="{Binding OrderItems}"
                      MouseDoubleClick="OrderGrid_MouseDoubleClick"
                      Margin="0"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource Border}"
                      VerticalGridLinesBrush="Transparent"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      CanUserReorderColumns="False"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.RowStyle>
                    <StaticResource ResourceKey="OrderRow"/>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <!-- Числовая клетка: справа текст прижат к своей границе (6px),
                         слева — воздух 14px, чтобы длинные числа (суммы в 5-6 знаков)
                         не слипались с числом соседней колонки. Замер по кадрам до
                         правки: между ЦЕНОЙ и СУММОЙ было 18px при самой длинной
                         сумме, между ПЛОЩ./ДЛ. и ЦЕНОЙ — 11px, а у остальных
                         колонок 26–36px (GOTCHAS §28). -->
                    <Style x:Key="RightCell" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="14,0,6,0"/>
                    </Style>
                    <Style x:Key="CenterCell" TargetType="TextBlock">
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                    <!-- v3.48.3: сумма монтажа под глифом в ячейке «Монтаж» -->
                    <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVis"/>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Вкл. -->
                    <!-- v3.43.4 (bugfix): IsReadOnly=True ОБЯЗАТЕЛЬНО — без него клик
                         по CheckBox уводит DataGrid в режим редактирования ячейки,
                         что вызывает BeginningEdit → PushUndo() и ломает штатный
                         two-way binding IsChecked↔IsActive (визуально checkbox не
                         переключается или проскакивает мимо). С IsReadOnly=True
                         DataGrid пропускает edit-lifecycle, и CheckBox сам
                         обрабатывает клик через свою штатную логику. -->
                    <DataGridTemplateColumn Header="" Width="54" IsReadOnly="True">
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" BorderThickness="0" SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" SnapsToDevicePixels="True"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- № -->
                    <DataGridTextColumn Header="&#x2116;" Width="Auto" MinWidth="32"
                                                            Binding="{Binding RowNumber}"
                                                            IsReadOnly="True"
                                                            ElementStyle="{DynamicResource CenterCell}"/>

                    <!-- Наименование (Anwis mode pill inline) -->
                    <DataGridTemplateColumn Header="Наименование" Width="*" MinWidth="80" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimary}" FontWeight="Medium"
                                               TextWrapping="Wrap"/>
                                    <Border Background="{DynamicResource AccentLight}" CornerRadius="{DynamicResource Radius.Md}"
                                            Padding="7,2" Margin="6,0,0,0" Cursor="Hand"
                                            Visibility="{Binding IsAnwis, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding AnwisSizeToolTip}"
                                            PreviewMouseLeftButtonDown="AnwisModePill_PreviewLeftClick"
                                            PreviewMouseRightButtonDown="AnwisModePill_PreviewRightClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding AnwisSizeShortLabel}"
                                                   FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                
                                <!-- ИМ — автоматический импост. Клик — тёмный попап с деталями. -->
                                <Border Background="{DynamicResource AccentLight}" CornerRadius="{DynamicResource Radius.Md}"
                                        Padding="7,2" Margin="6,0,0,0" Cursor="Hand"
                                        Visibility="{Binding HasImpost, Converter={StaticResource BoolToVis}}"
                                        PreviewMouseLeftButtonDown="BadgeInfo_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock Text="ИМ" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Тёмный попап по клику: детали импоста (закрывается кликом вне). -->
                                        <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource Surface}"
                                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource Radius.Md}" Padding="10,8" Margin="0,6,0,0" MaxWidth="340">
                                                <TextBlock Text="{Binding ImpostToolTip}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>

                                <!-- АК — антикошка. Клик — тёмный попап с деталями. -->
                                <Border Background="{DynamicResource AccentLight}" CornerRadius="{DynamicResource Radius.Md}"
                                        Padding="7,2" Margin="6,0,0,0" Cursor="Hand"
                                        Visibility="{Binding IsAnticat, Converter={StaticResource BoolToVis}}"
                                        PreviewMouseLeftButtonDown="BadgeInfo_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- UX-05: self-explanatory label instead of bare "АК" -->
                                        <TextBlock Text="{Binding AnticatBadgeLabel}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- Тёмный попап по клику: детали антикошки. -->
                                        <Popup Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="{DynamicResource Surface}"
                                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                    CornerRadius="{DynamicResource Radius.Md}" Padding="10,8" Margin="0,6,0,0" MaxWidth="340">
                                                <TextBlock Text="{Binding AnticatToolTip}" FontSize="12"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>

</StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Цвет -->
                    <DataGridTextColumn Header="Цвет" Width="Auto" MinWidth="55"
                                                            Binding="{Binding Color}"
                                                            IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>


                    <!-- Ширина (v3.37.2 (GOTCHAS#15): LostFocus — формула ББ60/ББ70 не срабатывает
                         на каждом нажатии клавиши. При PropertyChanged набор «1» → raw=1 →
                         max(0,1−30)=0 → reverse=30 → ячейка перезаписывается «30», следующий
                         символ дописывается → «301200». LostFocus применяет формулу один раз при уходе
                         из ячейки. Auto-width для 3-4 значных размеров не критичен.) -->
                    <DataGridTextColumn Header="Ширина" Width="Auto" MinWidth="70">
                        <DataGridTextColumn.Binding>
                            <Binding Path="ШиринаВвод" Converter="{StaticResource DimConv}" ConverterParameter=" мм" UpdateSourceTrigger="LostFocus"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                <Setter Property="Margin" Value="14,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <!-- v3.37.2 (GOTCHAS#14): synchronous SelectAll — see SelectAll_OnFocus comment. -->
                                <EventSetter Event="GotFocus" Handler="SelectAll_OnFocus"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Высота (v3.37.2 (GOTCHAS#15): LostFocus — см. комментарий на Ширине.) -->
                    <DataGridTextColumn Header="Высота" Width="Auto" MinWidth="70">
                        <DataGridTextColumn.Binding>
                            <Binding Path="ВысотаВвод" Converter="{StaticResource DimConv}" ConverterParameter=" мм" UpdateSourceTrigger="LostFocus"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                <Setter Property="Margin" Value="14,0,6,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <!-- v3.37.2 (GOTCHAS#14): synchronous SelectAll — see SelectAll_OnFocus comment. -->
                                <EventSetter Event="GotFocus" Handler="SelectAll_OnFocus"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Монтаж (toggle per row) -->
                    <DataGridTemplateColumn Header="Монтаж" Width="Auto" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- v3.47.1: FlatIconButton — без WPF-овского «хрома» (фон-кнопка),
                                     только глиф V/X/B. Не-applicable товары затемняются
                                     через IsEnabled=False в стиле. -->
                                <!-- v3.53.1: бейдж и сумма монтажа — ОДНОЙ строкой.
                                     Раньше сумма стояла подписью ПОД бейджем: высота
                                     клетки становилась 26+13 = 39px вместо 21px у
                                     остальных, и строка с монтажом выбивалась из
                                     ритма таблицы (39 против 32; замеры — GOTCHAS
                                     §25). В одну строку все позиции одной высоты.
                                     Height=20 подчинён компактной шкале: строку держит
                                     именно эта кнопка, а не текст 12px (7,2px). -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">
                                    <!-- UX-06: readable word badge instead of V/X/В glyph;
                                         auto-width so «Вкл»/«Без»/«ВК» are not clipped -->
                                    <Button Content="{Binding InstallationButtonLabel}"
                                            Style="{DynamicResource FlatIconButton}"
                                            FontSize="{StaticResource Type.Caption}"
                                            FontWeight="SemiBold"
                                            MinWidth="34"
                                            Padding="6,0"
                                            Height="20"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Foreground="{Binding InstallationForegroundColor}"
                                            Click="BtnToggleInstallation_Click"
                                            ToolTip="{Binding InstallationToolTip}"
                                            IsEnabled="{Binding IsInstallationApplicable}"/>
                                    <!-- v3.48.3: сумма монтажа за строку (скрыта для «—»
                                         и нулевой суммы) — теперь в строку с бейджем -->
                                    <TextBlock Text="{Binding InstallationAmountDisplay}"
                                               Visibility="{Binding InstallationAmountDisplay,
                                                                            Converter={StaticResource NonEmptyToVis}}"
                                               FontSize="{StaticResource Type.Caption}"
                                               Margin="5,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Кол-во (editable; hidden for amount-only products) -->
                    <DataGridTextColumn Header="Кол-во" Width="Auto" MinWidth="55">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Quantity" Converter="{StaticResource QtyConv}" UpdateSourceTrigger="PropertyChanged"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCell}">
                                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAmountOnly}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- «Свой товар» (IsCustomProduct) ALWAYS shows its qty cell:
                                         the qty is optional to TYPE in the add form, but once
                                         entered it must be visible in the row. Only catalog
                                         optional-qty products (Материал) keep hiding the cell. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsQuantityOptional}" Value="True"/>
                                            <Condition Binding="{Binding IsCustomProduct}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <EventSetter Event="GotFocus" Handler="SelectAll_OnFocus"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Площ./Дл. (hidden for amount-only products; «Свой товар» keeps it visible) -->
                    <DataGridTextColumn Header="Площ./Дл." Width="Auto" MinWidth="70"
                                                            Binding="{Binding CalculatedValueDisplay}"
                                                            IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAmountOnly}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsQuantityOptional}" Value="True"/>
                                            <Condition Binding="{Binding IsCustomProduct}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Цена (editable — user can override the unit price per row).
                         PropertyChanged (not LostFocus) — required for Width="Auto" to grow
                         while user types. See docs/arc/GOTCHAS.md#13. -->
                    <DataGridTextColumn Header="Цена" Width="Auto" MinWidth="70">
                        <DataGridTextColumn.Binding>
                            <Binding Path="Price" Converter="{StaticResource MoneyConv}" UpdateSourceTrigger="PropertyChanged"/>
                        </DataGridTextColumn.Binding>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                <Setter Property="Margin" Value="14,0,6,0"/>
                                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="{DynamicResource Surface}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <EventSetter Event="GotFocus" Handler="SelectAll_OnFocus"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- Сумма (read-only, auto-calculated) -->
                    <DataGridTextColumn Header="Сумма" Width="Auto" MinWidth="70"
                                                            Binding="{Binding TotalDisplay}"
                                                            IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RightCell}">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Margin" Value="14,0,6,0"/>
                                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- x Delete (v3.50: reveals on row hover — prototype .del) -->
                    <DataGridTemplateColumn MinWidth="32" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="DelBtn" Style="{DynamicResource DeleteRowButton}"
                                        Click="BtnDeleteRow_Click"
                                        ToolTip="Удалить"
                                        Opacity="0">
                                    <Path Data="M3,3 L9,9 M9,3 L3,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Empty state — Fluent illustration with clear action guidance.
             v3.50: MUST overlay the table (Grid.Row=1, same cell as CardTable) —
             without the explicit row it lands in Row 0 and pushes the grid
             headers below the illustration. -->
        <Border x:Name="EmptyState" Grid.Row="1"
                Opacity="0" Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource EmptyState.Card}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Visibility, RelativeSource={RelativeSource Self}}" Value="Visible">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1"
                                                         Duration="{StaticResource Motion.Emphasized}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Style="{DynamicResource EmptyState.Panel}" MaxWidth="700">
                <!-- Иконка + заголовок + подсказка — общие блоки состояния:
                     одно оформление на все шесть состояний пустоты в продукте. -->
                <TextBlock Text="&#xE8FD;"
                           Style="{DynamicResource EmptyState.Icon}"/>
                <TextBlock Text="Выберите товар"
                           Style="{DynamicResource EmptyState.Title}"/>
                <TextBlock Style="{DynamicResource EmptyState.Hint}">
                    <Run Text="Нажмите на товар — он появится в поле"/>
                    <Run Text=" «Тип»" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    <Run Text=" выше"/>
                </TextBlock>

                <!-- Product chips grid — populated from code-behind -->
                <ItemsControl x:Name="ProductChipsList" Margin="0,0,0,0" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource QuickBg}" CornerRadius="{DynamicResource Radius.Md}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    Padding="14,8" Margin="4,4" Cursor="Hand"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimary}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Subtle hint at bottom -->
                <TextBlock FontSize="11" Foreground="{DynamicResource TextPrimary}" Opacity="0.7"
                           HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Run Text="или используйте"/>
                    <Run Text=" поиск" Foreground="{DynamicResource Accent}"/>
                    <Run Text=" выше"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
