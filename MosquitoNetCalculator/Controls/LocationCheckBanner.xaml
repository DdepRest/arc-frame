<UserControl x:Class="MosquitoNetCalculator.Controls.LocationCheckBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <!-- Неназойливая проверка местоположения: одна строка под заголовком.
         Ничего не блокирует, не закрывается сама по таймеру (иначе её
         пропустят не читая) и не забирает фокус — окно остаётся рабочим. -->
    <Border Background="{DynamicResource SectionBg}"
            BorderBrush="{DynamicResource SubtleBorder}"
            BorderThickness="0,0,0,1"
            Padding="{DynamicResource Pad.DialogBanner}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Мягкий акцентный бейдж вместо голого 11px-глифа: полоса
                     получает ведущий якорь, как иконки в карточках панели. -->
                <Border Grid.Column="0"
                        Width="24" Height="24"
                        Background="{DynamicResource AccentLight}"
                        CornerRadius="{DynamicResource Radius.Pill}"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource Gap.Inline}">
                    <TextBlock Text="&#xE81D;"
                               FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource AccentText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1"
                           Text="Местоположение:"
                           FontSize="{StaticResource Type.Body}"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"
                           Margin="{DynamicResource Gap.InlineSm}"/>
                <!-- Звёздная колонка + TextTrimming: на узком окне ужимается
                     название офиса, а кнопки никогда не уезжают за край. -->
                <TextBlock x:Name="TxtLocation"
                           Grid.Column="2"
                           Text=""
                           FontSize="{StaticResource Type.Body}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center"/>
                <!-- Префикс — чип, как в админ-панели: число перестаёт быть
                     хвостом строки и читается отдельным фактом. -->
                <Border x:Name="PrefixChip"
                        Grid.Column="3"
                        Background="{DynamicResource ChipBg}"
                        CornerRadius="{DynamicResource Radius.Capsule}"
                        Padding="{DynamicResource Pad.Pill}"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource Gap.Left}">
                    <TextBlock x:Name="TxtPrefix"
                               Text=""
                               FontSize="{StaticResource Type.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource Gap.LeftLg}">
                <!-- Компактные кнопки (28px) вместо штатных 32+: напоминание
                     не должно выглядеть как главная панель действий. Подтверждение —
                     акцентный ghost, смена — тихая текстовая кнопка. -->
                <Button x:Name="BtnConfirm"
                        Content="Всё верно"
                        Style="{DynamicResource GhostButton}"
                        Foreground="{DynamicResource AccentText}"
                        Height="28"
                        Padding="{DynamicResource Pad.Pill}"
                        AutomationProperties.Name="Подтвердить местоположение"
                        ToolTip="Оставить текущее местоположение — напомним через 30 дней"
                        Margin="{DynamicResource Gap.InlineSm}"
                        Click="BtnConfirm_Click"/>
                <Button x:Name="BtnChange"
                        Content="Изменить"
                        Style="{DynamicResource SubtleActionButton}"
                        Height="28"
                        Padding="{DynamicResource Pad.Pill}"
                        AutomationProperties.Name="Изменить местоположение"
                        ToolTip="Открыть выбор местоположения"
                        Margin="{DynamicResource Gap.InlineSm}"
                        Click="BtnChange_Click"/>
                <!-- Крестик — в размер кнопок (24px) и с воздухом справа:
                     32px-кнопка в 38px-полосе прижималась к самому краю. -->
                <Button x:Name="BtnSnooze"
                        Width="24" Height="24"
                        Style="{DynamicResource DialogCloseButton}"
                        AutomationProperties.Name="Отложить проверку"
                        ToolTip="Напомнить через 3 дня"
                        Margin="{DynamicResource Gap.LeftSm}"
                        Click="BtnSnooze_Click">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{StaticResource Type.Caption}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource Gap.None}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
