<UserControl x:Class="MosquitoNetCalculator.Controls.OrdersHistoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBg}" Margin="{DynamicResource Gap.None}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Info panel -->
        <Border Grid.Row="0" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Radius.Card}"
                Padding="{DynamicResource Pad.Card}" Margin="{DynamicResource Gap.HistoryHeader}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                Style="{DynamicResource Card}"
                ClipToBounds="True">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ЗАКАЗЫ" FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline14}"/>
                    <Border Background="{DynamicResource ChipBg}" CornerRadius="{DynamicResource Radius.Capsule}"
                            Padding="{DynamicResource Pad.ButtonSm}" Margin="{DynamicResource Gap.Inline14}">
                        <TextBlock x:Name="TxtOrdersCount" Text="Заказов: 0"
                                   FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{DynamicResource GhostButton}"
                            Click="BtnImportOrders_Click" Margin="{DynamicResource Gap.Inline}"
                            ToolTip="Импортировать заказы из файла">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE8B5;"/>
                            <TextBlock Text="Импорт"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource GhostButton}"
                            Click="BtnExportOrders_Click" Margin="{DynamicResource Gap.Inline}"
                            ToolTip="Экспортировать заказы в файл">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE898;"/>
                            <TextBlock Text="Экспорт"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{DynamicResource GhostButton}"
                            Click="BtnRefreshOrders_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE72C;"/>
                            <TextBlock Text="Обновить"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search bar -->
        <Border Grid.Row="1" Margin="{DynamicResource Gap.HistoryBody}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;"
                           FontFamily="{DynamicResource Font.Icon}"
                           FontSize="{StaticResource Type.BodyLg}" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                <Grid Grid.Column="1">
                    <TextBox x:Name="TxtSearchOrders"
                             Style="{DynamicResource QuickInput}"
                             TextChanged="TxtSearchOrders_TextChanged"
                             GotKeyboardFocus="TxtSearchOrders_GotKeyboardFocus"
                             LostKeyboardFocus="TxtSearchOrders_LostKeyboardFocus"
                             ToolTip="Фильтр по № КП, адресу или телефону"/>
                    <!-- UX-09: ghost hint — visible only while empty and unfocused
                         (same rule as in the AI assistant input). -->
                    <TextBlock x:Name="OrdersSearchPlaceholder"
                               Text="Поиск: № КП, адрес или телефон"
                               Margin="{DynamicResource Gap.Left}"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Body}"
                               Foreground="{DynamicResource TextMuted}"
                               IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="BtnClearOrdersSearch" Grid.Column="2"
                        Style="{DynamicResource GhostButton}"
                        Content="&#xE711;" FontFamily="{DynamicResource Font.Icon}"
                        FontSize="{StaticResource Type.Caption}" Padding="{DynamicResource Pad.Tiny}" Margin="{DynamicResource Gap.LeftSm}" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="BtnClearOrdersSearch_Click"
                        ToolTip="Очистить поиск"/>
                <!-- v3.50: status filter (prototype .dr-tools .inp) — view-only filter
                     over the existing ItemsSource; no data changes -->
                <ComboBox x:Name="CmbStatusFilter" Grid.Column="3" Margin="{DynamicResource Gap.Left}" MinWidth="150"
                          Style="{DynamicResource QuickCombo}"
                          SelectionChanged="StatusFilter_SelectionChanged"
                          ToolTip="Фильтр по статусу заказа"/>
                <!-- v3.50: date filter — matches the exact contract date -->
                <DatePicker x:Name="DpDateFilter" Grid.Column="4" Margin="{DynamicResource Gap.Left}"
                            SelectedDateChanged="DateFilter_SelectionChanged"
                            ToolTip="Фильтр по дате договора"/>
            </Grid>
        </Border>

        <!-- Orders table -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Radius.Card}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="{DynamicResource Gap.TableBottom}"
                Style="{DynamicResource Card}"
                ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="OrdersList"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="Transparent"
                      AlternationCount="2"
                      RowBackground="{DynamicResource Surface}"
                      AlternatingRowBackground="{DynamicResource RowAlt}"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True"
                      Sorting="OrdersList_Sorting">
                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource {x:Type ContextMenu}}">
                        <MenuItem x:Name="CtxOpenMenu" Header="Открыть заказ" Click="CtxOpen_Click" Style="{StaticResource {x:Type MenuItem}}"/>
                        <MenuItem x:Name="CtxStatusMenu" Header="Изменить статус..." IsEnabled="False" Click="CtxStatus_Click" Style="{StaticResource {x:Type MenuItem}}"/>
                        <MenuItem x:Name="CtxExportMenu" Header="Экспорт заказа" IsEnabled="False" Click="CtxExport_Click" Style="{StaticResource {x:Type MenuItem}}"/>
                        <Separator Style="{StaticResource {x:Type Separator}}"/>
                        <MenuItem x:Name="CtxCopyMenu" Header="Копировать" IsEnabled="False" Click="CtxCopy_Click" Style="{StaticResource {x:Type MenuItem}}"/>
                        <Separator Style="{StaticResource {x:Type Separator}}"/>
                        <MenuItem x:Name="CtxDeleteMenu" Header="Удалить заказ" IsEnabled="False" Click="CtxDelete_Click" Foreground="{DynamicResource Danger}" Style="{StaticResource {x:Type MenuItem}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <StaticResource ResourceKey="OrdersRow"/>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№ КП"
                                        Binding="{Binding ContractNumber}"
                                        SortMemberPath="ContractNumberSortKey"
                                        Width="Auto" MinWidth="60"/>

                    <!-- Адрес — единственная колонка со звёздной шириной, и
                         обрезка с многоточием здесь недопустима: адрес нужен
                         ЦЕЛИКОМ (владелец). Поэтому перенос строк вместо
                         обрезки: строка таблицы растёт по высоте на длинных
                         адресах (MinRowHeight 26 остаётся для коротких),
                         тултип сохранён для скринридеров и на случай ещё
                         более узких окон. MinWidth 150: бюджет минимумов
                         колонок должен влезать в панель 800 минус паддинги
                         (~776 DIP) наряду с шестью Auto-соседями. -->
                    <DataGridTextColumn Header="Адрес"
                                        Binding="{Binding ClientAddress}"
                                        Width="*" MinWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Телефон"
                                        Binding="{Binding ClientPhone}"
                                        Width="Auto" MinWidth="100" MaxWidth="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <!-- Два номера в одной ячейке («+7… +7…») на одной
                                     строке задавали auto-ширину ~250px и выталкивали
                                     «Обновлено» за край панели: кап 150 ограничивает
                                     колонку, перенос делает оба номера читаемыми. -->
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Дата"
                                        Binding="{Binding ContractDate, StringFormat='dd.MM.yyyy'}"
                                        Width="Auto" MinWidth="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding ContractDate, StringFormat='dd.MM.yyyy'}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Сумма, руб."
                                        Binding="{Binding TotalAmount, Converter={StaticResource MoneyConv}}"
                                        Width="Auto" MinWidth="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="6,0"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
                                <Setter Property="ToolTip" Value="{Binding TotalAmount, Converter={StaticResource MoneyConv}}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Статус: Auto-колонка растягивается по самому длинному
                         бейджу («Отправлен на завод») и на узком окне съедает
                         ширину у адреса. MaxWidth + перенос в исключительных
                         случаях: бейдж остаётся капсулой, адрес не страдает. -->
                    <DataGridTemplateColumn Header="Статус"
                                            Width="Auto" MinWidth="100" MaxWidth="150"
                                            SortMemberPath="StatusRank">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="{DynamicResource Radius.Capsule}" Padding="{DynamicResource Pad.Chip}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{Binding Status, Converter={StaticResource StatusToBadgeBg}}">
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="{StaticResource Type.Caption}" FontWeight="Medium"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBadgeFg}}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Обновлено"
                                        Binding="{Binding UpdatedAt, StringFormat='dd.MM.yy HH:mm'}"
                                        Width="Auto" MinWidth="108">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="ToolTip" Value="{Binding UpdatedAt, StringFormat='dd.MM.yy HH:mm'}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

                <!-- Empty state — Fluent illustration with action button -->
                <StackPanel x:Name="OrdersEmptyState"
                            Style="{DynamicResource EmptyState.Panel}"
                            Visibility="{Binding IsEmpty, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="" Style="{DynamicResource EmptyState.Icon}"/>
                    <TextBlock Text="Заказов пока нет"
                               Style="{DynamicResource EmptyState.Title}"/>
                    <TextBlock Text="Создайте первый заказ на вкладке «Расчёт», заполните позиции и сохраните"
                               Style="{DynamicResource EmptyState.Hint}"/>
                    <Button Style="{DynamicResource EmptyState.Action}"
                            Click="BtnGoToCalculation_Click"
                            ToolTip="Вернуться к расчёту (Ctrl+1)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE1D0;"/>
                            <TextBlock Text="Перейти к расчёту"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- UX-09: search no-results state — orders exist, none match the filter.
                     The filtering happens in TxtSearchOrders_TextChanged, which also
                     maintains NoSearchResults; keep this mutually exclusive with IsEmpty. -->
                <StackPanel x:Name="OrdersNoResultsState"
                            Style="{DynamicResource EmptyState.Panel}"
                            IsHitTestVisible="False"
                            Visibility="{Binding NoSearchResults, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE721;"
                               Style="{DynamicResource EmptyState.Icon}"/>
                    <TextBlock Text="Ничего не найдено"
                               Style="{DynamicResource EmptyState.Title}"/>
                    <TextBlock Text="Попробуйте изменить запрос — поиск идёт по № КП, адресу и телефону"
                               Style="{DynamicResource EmptyState.Hint}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
