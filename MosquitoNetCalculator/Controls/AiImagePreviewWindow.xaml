<Window x:Class="MosquitoNetCalculator.Controls.AiImagePreviewWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр чертежа"
        Width="820" Height="680"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Grid>
        <!-- Shadow border -->
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}" Margin="{DynamicResource Gap.Window}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.3"
                                  Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
        </Border>

        <!-- Main container -->
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}"
                Margin="{DynamicResource Gap.Window}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBg}"
                        CornerRadius="{DynamicResource Radius.CardHeader}"
                        Padding="{DynamicResource Pad.InputH}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="📷 " FontSize="{StaticResource Type.Body}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtTitle" Text="Чертёж / Бланк замера"
                                   FontSize="{StaticResource Type.Body}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                        <!-- Zoom controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <Button Content="-" Width="26" Height="26" Click="BtnZoomOut_Click"
                                    Style="{StaticResource FlatIconButton}" ToolTip="Уменьшить (Колёсико мыши вниз)"/>
                            <TextBlock x:Name="TxtZoomPercent" Text="100%" FontSize="{StaticResource Type.Caption}"
                                       Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0"/>
                            <Button Content="+" Width="26" Height="26" Click="BtnZoomIn_Click"
                                    Style="{StaticResource FlatIconButton}" ToolTip="Увеличить (Колёсико мыши вверх)"/>
                            <Button Content="1:1" Width="30" Height="26" Click="BtnResetZoom_Click" Margin="6,0,0,0"
                                    Style="{StaticResource DialogOutlineButton}" FontSize="{StaticResource Type.Caption}" ToolTip="Сбросить масштаб"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="3" Width="28" Height="28" Click="BtnClose_Click"
                                Style="{DynamicResource DialogCloseButton}" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Caption}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Viewport for image with Zoom and Pan -->
                <ScrollViewer Grid.Row="1" x:Name="ImgScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#10000000"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="ScrollViewer_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="ScrollViewer_PreviewMouseMove"
                              PreviewMouseLeftButtonUp="ScrollViewer_PreviewMouseLeftButtonUp">
                    <Grid x:Name="ImgContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.LayoutTransform>
                                <ScaleTransform x:Name="ImageScale" ScaleX="1.0" ScaleY="1.0"/>
                            </Image.LayoutTransform>
                        </Image>
                    </Grid>
                </ScrollViewer>

                <!-- Bottom info footer -->
                <Border Grid.Row="2" Padding="12,8" Background="{DynamicResource SectionBg}"
                        BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock x:Name="TxtImageInfo" Text="Масштаб колесиком мыши · Перетаскивание зажатой левой кнопкой мыши"
                                   FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                        <Button Content="Закрыть (Esc)" HorizontalAlignment="Right" Click="BtnClose_Click"
                                Style="{StaticResource DialogOutlineButton}" Height="28" Padding="12,2" FontSize="{StaticResource Type.Caption}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
