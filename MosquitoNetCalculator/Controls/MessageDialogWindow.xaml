<Window x:Class="MosquitoNetCalculator.Controls.MessageDialogWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="8"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="2"
                              Opacity="0.25"
                              Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Message -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="12,12,0,0"
                    Height="32"
                    Padding="14,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis"/>
                    <!-- UX-14: shared DialogCloseButton (was a private 60-line copy).
                         DynamicResource — окно парсится и в тестах без App-тем. -->
                    <Button Grid.Column="1"
                            Width="40" Height="40"
                            Style="{DynamicResource DialogCloseButton}"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       Grid.Row="1"
                       FontSize="12"
                       Foreground="{DynamicResource TextPrimary}"
                       TextWrapping="Wrap"
                       Margin="24,20,24,20"/>

            <!-- Buttons -->
            <ItemsControl x:Name="ButtonsPanel"
                          Grid.Row="2"
                          Margin="24,0,24,20"
                          HorizontalAlignment="Right">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- v3.47.1: GhostButton — безхромовый дефолт (убирает WPF-хром в тёмной теме);
                             DialogButton_Loaded переопределяет button.Style (PrimaryButton/...)
                             и ставит FontWeight (SemiBold для IsDefault=true). Не дублируем
                             FontWeight в XAML — handler (DialogButton_Loaded) остаётся единым
                             источником для этого свойства; Style оставлен как GhostButton-дефолт
                             и при необходимости повышается тем же хендлером до PrimaryButton/... -->
                        <Button Content="{Binding Content}"
                                Style="{DynamicResource GhostButton}"
                                MinWidth="90"
                                Padding="16,7"
                                Margin="8,0,0,0"
                                FontSize="12"
                                Click="DialogButton_Click"
                                Loaded="DialogButton_Loaded"
                                Tag="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
