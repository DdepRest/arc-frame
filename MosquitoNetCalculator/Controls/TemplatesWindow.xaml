<Window x:Class="MosquitoNetCalculator.Controls.TemplatesWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шаблоны"
        Width="620" Height="700"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="false">
    <Window.Resources>
        <Storyboard x:Key="WindowOpenAnimation">
            <DoubleAnimation From="0.0" To="1.0" Duration="{StaticResource Motion.Slow}"
                             Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Карточка шаблона на витрине: hover как у пунктов меню печати. -->
        <Style x:Key="TemplateCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GhostBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Lg}" Margin="8" Opacity="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.10"
                              Color="{DynamicResource ShadowColor}"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="*"/>      <!-- View host -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- TITLE BAR                                          -->
            <!-- ══════════════════════════════════════════════════ -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="{DynamicResource Radius.CardHeader}" Height="38"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4"
                            Background="{DynamicResource Accent}"
                            CornerRadius="{DynamicResource Radius.StripeLeft}"
                            VerticalAlignment="Stretch"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="&#xE8A5;" FontSize="14"
                                   Style="{DynamicResource FluentIconSection}"
                                   VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                        <TextBlock Text="Шаблоны"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="BtnClose"
                            Width="40" Height="40"
                            Style="{DynamicResource DialogCloseButton}"
                            Click="BtnClose_Click"
                            AutomationProperties.Name="Закрыть">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource Font.Icon}" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Обе вьюхи живут в одном гриде; видимость переключает code-behind. -->
            <Grid Grid.Row="1">
                <!-- ══════════════════════════════════════════════ -->
                <!-- VIEW 1: витрина шаблонов                        -->
                <!-- ══════════════════════════════════════════════ -->
                <Grid x:Name="GalleryView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="Выберите шаблон — позиции добавятся в заказ одним набором"
                               FontSize="11" Foreground="{DynamicResource TextMuted}"
                               Margin="20,14,20,10" TextWrapping="Wrap"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GalleryPanel" Margin="20,0,20,16"/>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════════════════════════ -->
                <!-- VIEW 2: чек-лист выбранного шаблона             -->
                <!-- ══════════════════════════════════════════════ -->
                <Grid x:Name="ChecklistView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- back + title -->
                        <RowDefinition Height="*"/>      <!-- rows -->
                        <RowDefinition Height="Auto"/>   <!-- summary -->
                        <RowDefinition Height="Auto"/>   <!-- footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="20,12,20,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnBack" Style="{DynamicResource GhostButton}"
                                    Padding="8,4" FontSize="11"
                                    Click="BtnBack_Click"
                                    AutomationProperties.Name="К списку шаблонов">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="К шаблонам" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TxtChecklistTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="{DynamicResource Gap.LeftLg}"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChecklistPanel" Margin="20,4,20,8"/>
                    </ScrollViewer>

                    <!-- Живая сводка: что добавится и на какую сумму -->
                    <Border Grid.Row="2" Background="{DynamicResource SectionBg}"
                            BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0"
                            Padding="20,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSummaryCount" Grid.Column="0"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryTotal" Grid.Column="1"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="20,12,20,16">
                        <Button x:Name="BtnCancel"
                                Content="Отмена"
                                Style="{DynamicResource GhostButton}"
                                Click="BtnCancel_Click"
                                IsCancel="True"
                                FontSize="12" Padding="16,7"
                                Margin="0,0,10,0"/>
                        <Button x:Name="BtnApply" Style="{DynamicResource PrimaryButton}"
                                Click="BtnApply_Click"
                                FontSize="12" Padding="18,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontSize="14"
                                           FontFamily="{DynamicResource Font.Icon}"
                                           Margin="{DynamicResource Gap.Inline}" VerticalAlignment="Center"/>
                                <TextBlock Text="Добавить в заказ" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
