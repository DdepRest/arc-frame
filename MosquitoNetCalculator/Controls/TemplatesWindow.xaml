<Window x:Class="MosquitoNetCalculator.Controls.TemplatesWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шаблоны"
        Width="640"
        MinWidth="560" MinHeight="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="false">
    <Window.Resources>
        <Storyboard x:Key="WindowOpenAnimation">
            <DoubleAnimation From="0.0" To="1.0" Duration="{StaticResource Motion.Slow}"
                             Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Карточка шаблона на витрине: крупная, с иконкой товара,
             hover с подъёмом рамки (v3.53.1, улучшение UX по фидбеку владельца). -->
        <Style x:Key="TemplateCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GhostBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FluentFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Иконка товара в карточке: аккуратная подложка + векторная пиктограмма -->
        <Style x:Key="TemplateCardIcon" TargetType="Border">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}"/>
            <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- v3.53.1: тень — на отдельной пустой подложке (ниже, z-порядок по
         порядку объявления), RootBorder с текстом БЕЗ Effect: DropShadowEffect
         на корневом Border растрировал всё окно в текстуру и убивал ClearType
         («расплывшие» шрифты). Анимация открытия осталась на RootBorder.
         Подложка инлайн (не общий ресурс): у окна может быть владелец с тем же
         окном открытым дважды, а Border из ресурса нельзя класть в два места. -->
    <Grid>
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}" Margin="{DynamicResource Gap.Window}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.10"
                                  Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
        </Border>
        <Border x:Name="RootBorder" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}" Margin="{DynamicResource Gap.Window}" Opacity="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Title bar -->
                    <RowDefinition Height="*"/>      <!-- View host -->
                </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════ -->
            <!-- TITLE BAR                                          -->
            <!-- ══════════════════════════════════════════════════ -->
            <Border x:Name="TitleBar" Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="{DynamicResource Radius.CardHeader}" Height="38"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4"
                            Background="{DynamicResource Accent}"
                            CornerRadius="{DynamicResource Radius.StripeLeft}"
                            VerticalAlignment="Stretch"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="{DynamicResource Pad.TitleBar}">
                        <TextBlock Text="&#xE8A5;" FontSize="{StaticResource Type.BodyLg}"
                                   Style="{DynamicResource FluentIconSection}"
                                   VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                        <TextBlock Text="Шаблоны"
                                   FontSize="{StaticResource Type.Body}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="BtnClose"
                            Width="40" Height="40"
                            Style="{DynamicResource DialogCloseButton}"
                            Click="BtnClose_Click"
                            AutomationProperties.Name="Закрыть">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Caption}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Обе вьюхи живут в одном гриде; видимость переключает code-behind. -->
            <Grid Grid.Row="1">
                <!-- ══════════════════════════════════════════════ -->
                <!-- VIEW 1: витрина шаблонов                        -->
                <!-- ══════════════════════════════════════════════ -->
                <Grid x:Name="GalleryView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="{DynamicResource Gap.TemplatesHeader}">
                        <TextBlock Text="Что добавим в заказ"
                                   FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Шаблон подсказывает, что обычно входит в расчёт изделия, — и добавляет отмеченное в заказ одним набором"
                                   FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TextMuted}"
                                   Margin="{DynamicResource Gap.BlockTopSm}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="GalleryPanel" Margin="{DynamicResource Gap.TemplatesGallery}"/>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════════════════════════ -->
                <!-- VIEW 2: чек-лист выбранного шаблона             -->
                <!-- ══════════════════════════════════════════════ -->
                <Grid x:Name="ChecklistView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- back + title -->
                        <RowDefinition Height="*"/>      <!-- rows -->
                        <RowDefinition Height="Auto"/>   <!-- summary -->
                        <RowDefinition Height="Auto"/>   <!-- footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="{DynamicResource Gap.TemplatesControls}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnBack" Style="{DynamicResource GhostButton}"
                                    Padding="{DynamicResource Pad.Badge}" FontSize="{StaticResource Type.Caption}"
                                    Click="BtnBack_Click"
                                    AutomationProperties.Name="К списку шаблонов">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="{DynamicResource Font.Icon}"
                                               FontSize="{StaticResource Type.Caption}" VerticalAlignment="Center" Margin="{DynamicResource Gap.InlineSm}"/>
                                    <TextBlock Text="К шаблонам" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="{DynamicResource Gap.LeftLg}" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtChecklistTitle" FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtChecklistSubtitle" FontSize="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource TextMuted}" Margin="{DynamicResource Gap.Micro}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChecklistPanel" Margin="{DynamicResource Gap.TemplatesList}"/>
                    </ScrollViewer>

                    <!-- Живая сводка: что добавится и на какую сумму -->
                    <Border Grid.Row="2" Background="{DynamicResource SectionBg}"
                            BorderBrush="{DynamicResource SubtleBorder}" BorderThickness="0,1,0,0"
                            Padding="{DynamicResource Pad.TemplatesCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtSummaryCount" Grid.Column="0"
                                       FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtSummaryTotal" Grid.Column="1"
                                       FontSize="{StaticResource Type.Subtitle}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="{DynamicResource Gap.TemplatesFooter}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource TextMuted}"
                                   Text="Ctrl+Z откатит весь шаблон одним действием"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnCancel"
                                    Content="Отмена"
                                    Style="{DynamicResource GhostButton}"
                                    Click="BtnCancel_Click"
                                    IsCancel="True"
                                    FontSize="{StaticResource Type.Body}" Padding="{DynamicResource Pad.DialogBtn}"
                                    Margin="{DynamicResource Gap.Inline10}"/>
                            <Button x:Name="BtnApply" Style="{DynamicResource PrimaryButton}"
                                    Click="BtnApply_Click"
                                    AutomationProperties.Name="Добавить в заказ"
                                    FontSize="{StaticResource Type.Body}" Padding="{DynamicResource Pad.TemplatesApply}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontSize="{StaticResource Type.BodyLg}"
                                               FontFamily="{DynamicResource Font.Icon}"
                                               Margin="{DynamicResource Gap.Inline}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtApplyLabel" Text="Добавить в заказ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>
