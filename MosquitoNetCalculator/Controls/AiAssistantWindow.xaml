<Window x:Class="MosquitoNetCalculator.Controls.AiAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MosquitoNetCalculator.Controls"
        Title="AI Ассистент"
        Width="420" Height="700"
        MinWidth="320" MinHeight="400"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource AppBg}"
        Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header — same anatomy as the app's panel headers (cf. «Заказы»):
             icon + title + status chip on the LEFT, close button on the RIGHT. -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}"
                Padding="16,10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock Text="&#xE99A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="AI Ассистент" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button x:Name="BtnClose"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Width="32" Height="32"
                        Margin="4,0,0,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TextSecondary}"
                        Cursor="Hand"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="12"
                        Content="&#xE8BB;"
                        Click="BtnClose_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                CornerRadius="6" Width="32" Height="32">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLight}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <controls:AiAssistantControl x:Name="AiAssistantControl" Grid.Row="1" DataContext="{Binding}" />

        <!--
          Toast canvas overlay — anchors AI-scope toasts (e.g. "Скопировано")
          to the bottom-right of the docked window instead of the main window.
          Spans both rows. IsHitTestVisible=False so chat/prompts/input clicks pass through.
        -->
        <Grid x:Name="ToastCanvas"
              Grid.Row="0" Grid.RowSpan="2"
              IsHitTestVisible="False"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"/>
    </Grid>
</Window>
