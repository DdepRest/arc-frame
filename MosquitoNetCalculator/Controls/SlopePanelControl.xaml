<UserControl x:Class="MosquitoNetCalculator.Controls.SlopePanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MosquitoNetCalculator.Controls">
    <Grid Margin="{DynamicResource Gap.DialogHost}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- 2-COLUMN SPLIT WORKSPACE BODY                           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Window Parameters & Options -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="{DynamicResource Gap.Inline}">
                <StackPanel>

                    <!-- BETA warning banner -->
                    <Border x:Name="BetaBanner"
                            Background="{DynamicResource BadgeWarningBg}"
                            BorderBrush="{DynamicResource BadgeWarningFg}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Margin="{DynamicResource Gap.Section}"
                            Padding="{DynamicResource Pad.Card}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE7BA;"
                                       FontFamily="{DynamicResource Font.Icon}"
                                       FontSize="{StaticResource Type.Title}"
                                       Foreground="{DynamicResource BadgeWarningFg}"
                                       VerticalAlignment="Top"
                                       Margin="{DynamicResource Gap.InlineLg}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="BETA — Автопросчёт откосов"
                                           FontSize="{StaticResource Type.Body}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BadgeWarningFg}"/>
                                <TextBlock Text="Функция находится в стадии тестирования. Перепроверьте расчёт откоса вручную перед передачей заказа."
                                           FontSize="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           Margin="{DynamicResource Gap.BlockTop}"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    x:Name="BtnCloseBetaBanner"
                                    Click="BtnCloseBetaBanner_Click"
                                    Style="{DynamicResource GhostButton}"
                                    Width="24" Height="24"
                                    Padding="{DynamicResource Pad.None}"
                                    VerticalAlignment="Top"
                                    ToolTip="Скрыть предупреждение">
                                <TextBlock Text="&#xE8BB;"
                                           FontFamily="{DynamicResource Font.Icon}"
                                           FontSize="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource BadgeWarningFg}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- CARD 1: РАЗМЕРЫ ОКНА -->
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Margin="{DynamicResource Gap.Section}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Brand accent strip on left edge -->
                            <Border Width="4" HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    CornerRadius="{DynamicResource Radius.StripeLeft}"/>
                            <StackPanel Margin="{DynamicResource Gap.PanelSection}">
                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.BlockLg}">
                                    <TextBlock Text="&#xE7C5;"
                                               Style="{DynamicResource FluentIconSection}"
                                               FontSize="{StaticResource Type.BodyLg}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Размеры окна"
                                               FontSize="{StaticResource Type.Body}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Высота, мм" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="TxtHeight" Style="{DynamicResource QuickInput}"
                                                 TextChanged="Input_TextChanged"
                                                 HorizontalContentAlignment="Right"/>
                                        <TextBlock x:Name="TxtHeightHint" FontSize="{StaticResource Type.Caption}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="{DynamicResource Gap.BlockTopSm}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ширина, мм" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="TxtWidth" Style="{DynamicResource QuickInput}"
                                                 TextChanged="Input_TextChanged"
                                                 HorizontalContentAlignment="Right"/>
                                        <TextBlock x:Name="TxtWidthHint" FontSize="{StaticResource Type.Caption}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="{DynamicResource Gap.BlockTopSm}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Глубина" Style="{DynamicResource FieldLabel}"/>
                                        <TextBox x:Name="TxtDepth" Style="{DynamicResource QuickInput}"
                                                 TextChanged="Input_TextChanged"
                                                 HorizontalContentAlignment="Right"/>
                                        <TextBlock x:Name="TxtDepthHint" FontSize="{StaticResource Type.Caption}"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="{DynamicResource Gap.BlockTopSm}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="{DynamicResource Gap.BlockTopXl}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Кол-во откосов:"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Margin="{DynamicResource Gap.InlineLg}"/>
                                    <controls:NumericUpDownControl x:Name="NumWindowCount"
                                                                   Grid.Column="1"
                                                                   Value="1"
                                                                   ValueChanged="NumWindowCount_ValueChanged"
                                                                   Width="110"
                                                                   HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- CARD: ОПЦИИ И ПАРАМЕТРЫ -->
                    <Border Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Margin="{DynamicResource Gap.Section}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Border Width="4" HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}"
                                    CornerRadius="{DynamicResource Radius.StripeLeft}"/>
                            <StackPanel Margin="{DynamicResource Gap.PanelSection}">
                                <TextBlock Text="Опции"
                                           FontSize="{StaticResource Type.Body}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           Margin="{DynamicResource Gap.Block}"/>
                                <Button x:Name="BtnAddLaminatina"
                                        Style="{DynamicResource GhostButton}"
                                        Click="BtnAddLaminatina_Click"
                                        IsEnabled="False"
                                        Height="32"
                                        Margin="{DynamicResource Gap.BlockSm}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE710;"
                                                   Style="{DynamicResource FluentIconButton}"
                                                   FontSize="{StaticResource Type.BodyLg}"
                                                   VerticalAlignment="Center"
                                                   Margin="{DynamicResource Gap.Inline}"/>
                                        <TextBlock Text="Порог (Ламинат)"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <CheckBox x:Name="ChkApplyEconomy"
                                          IsChecked="True"
                                          Content="Применить экономию"
                                          FontSize="{StaticResource Type.Caption}"
                                          Foreground="{DynamicResource TextSecondary}"
                                          VerticalAlignment="Center"
                                          Margin="{DynamicResource Gap.BlockTopSm}"
                                          Checked="ChkApplyEconomy_Changed"
                                          Unchecked="ChkApplyEconomy_Changed"/>
                                <Button x:Name="BtnEconomyDetails"
                                        Style="{DynamicResource GhostButton}"
                                        Click="BtnEconomyDetails_Click"
                                        Margin="{DynamicResource Gap.BlockTopSm}"
                                        Padding="{DynamicResource Pad.Pill}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        ToolTip="Подробный расчёт экономии по всем откосам в заказе">
                                    <TextBlock Text="Детали экономии"
                                               FontSize="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource Accent}"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Materials BOM & Live Economics -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="{DynamicResource Gap.Left}">
                <StackPanel>

                <!-- CARD 2: МАТЕРИАЛЫ -->
                <Border Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Md}"
                        Margin="{DynamicResource Gap.Section}"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}"
                                CornerRadius="{DynamicResource Radius.StripeLeft}"/>
                        <StackPanel Margin="{DynamicResource Gap.PanelSection}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE82D;"
                                               Style="{DynamicResource FluentIconSection}"
                                               FontSize="{StaticResource Type.BodyLg}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Материалы"
                                               FontSize="{StaticResource Type.Body}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- v3.43.3: «Сбросить» снимает IsQuantityOverridden
                                     со всех материалов и возвращает авто-формулы. -->
                                <Button Grid.Column="1" x:Name="BtnRecalculate"
                                        Style="{DynamicResource GhostButton}"
                                        Click="BtnRecalculate_Click"
                                        ToolTip="Сбросить ручные правки и вернуть авто-формулы"
                                        Padding="{DynamicResource Pad.Pill}" Height="28">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;"
                                                   Style="{DynamicResource FluentIconButton}"
                                                   FontSize="{StaticResource Type.Body}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Сбросить"
                                                   FontSize="{StaticResource Type.Caption}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Table header -->
                            <Grid Margin="{DynamicResource Gap.TableHeader}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Позиция"
                                           Style="{DynamicResource SectionLabel}"
                                           Margin="{DynamicResource Gap.None}"/>
                                <TextBlock Grid.Column="1" Text="Кол-во"
                                           Style="{DynamicResource SectionLabel}"
                                           HorizontalAlignment="Right" Margin="{DynamicResource Gap.None}"/>
                                <TextBlock Grid.Column="2" Text="Цена"
                                           Style="{DynamicResource SectionLabel}"
                                           HorizontalAlignment="Right" Margin="{DynamicResource Gap.None}"/>
                                <TextBlock Grid.Column="3" Text="Сумма"
                                           Style="{DynamicResource SectionLabel}"
                                           HorizontalAlignment="Right" Margin="{DynamicResource Gap.None}"/>
                            </Grid>

                            <!-- v3.43.3 + v3.43.4: Кол-во/Цена редактируемые, чип "ручн." под названием строки
                                 при IsQuantityOverridden=true (виден через DataTrigger в ItemTemplate). -->
                            <ItemsControl x:Name="MaterialItems" Margin="{DynamicResource Gap.BlockSm}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{DynamicResource Gap.TableRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                                <ColumnDefinition Width="75"/>
                                                <ColumnDefinition Width="85"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="{StaticResource Type.Caption}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <!-- «ручн.» chip — auto-shows when user edited Qty/Price. -->
                                                <Border CornerRadius="{DynamicResource Radius.Sm}"
                                                        Background="{DynamicResource ChipBg}"
                                                        HorizontalAlignment="Left"
                                                        Padding="{DynamicResource Pad.Pill}"
                                                        Margin="{DynamicResource Gap.BlockTopSm}"
                                                        ToolTip="Пользователь изменил вручную — авто-пересчёт не перезапишет">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsQuantityOverridden}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="ручн."
                                                           FontSize="{StaticResource Type.Caption}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBox Grid.Column="1"
                                                     Tag="Quantity"
                                                     Style="{DynamicResource QuickInput}"
                                                     Text="{Binding Quantity, StringFormat=F2, UpdateSourceTrigger=LostFocus}"
                                                     LostFocus="MaterialField_LostFocus"
                                                     HorizontalContentAlignment="Right"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="{StaticResource Type.Caption}"
                                                     Margin="{DynamicResource Gap.InlineSm}"/>
                                            <TextBox Grid.Column="2"
                                                     Tag="Price"
                                                     Style="{DynamicResource QuickInput}"
                                                     Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}"
                                                     LostFocus="MaterialField_LostFocus"
                                                     HorizontalContentAlignment="Right"
                                                     VerticalContentAlignment="Center"
                                                     FontSize="{StaticResource Type.Caption}"
                                                     Margin="{DynamicResource Gap.InlineHSm}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Sum, StringFormat=N2}"
                                                       FontSize="{StaticResource Type.Caption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Opacity="0.3" Margin="{DynamicResource Gap.SeparatorBlock}"/>

                            <!-- Labor (special row — outside ItemsControl, bound via RelativeSource) -->
                            <Grid Margin="{DynamicResource Gap.TableRowSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Работа"
                                               FontSize="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <Border CornerRadius="{DynamicResource Radius.Sm}"
                                            Background="{DynamicResource ChipBg}"
                                            HorizontalAlignment="Left"
                                            Padding="{DynamicResource Pad.Pill}"
                                            Margin="{DynamicResource Gap.BlockTopSm}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Labor.IsQuantityOverridden, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="ручн."
                                                   FontSize="{StaticResource Type.Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         x:Name="TxtLaborQuantity"
                                         Tag="LaborQuantity"
                                         Style="{DynamicResource QuickInput}"
                                         Text="{Binding Labor.Quantity, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=F2, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         LostFocus="MaterialField_LostFocus"
                                         IsEnabled="{Binding HasCalculation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         FontSize="{StaticResource Type.Caption}"
                                         Margin="{DynamicResource Gap.InlineSm}"/>
                                <TextBox Grid.Column="2"
                                         x:Name="TxtLaborPrice"
                                         Tag="LaborPrice"
                                         Style="{DynamicResource QuickInput}"
                                         Text="{Binding Labor.Price, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=N2, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         LostFocus="MaterialField_LostFocus"
                                         IsEnabled="{Binding HasCalculation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         FontSize="{StaticResource Type.Caption}"
                                         Margin="{DynamicResource Gap.InlineHSm}"/>
                                <TextBlock Grid.Column="3"
                                           x:Name="TxtLaborSumRow"
                                           Text="0.00"
                                           FontSize="{StaticResource Type.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Laminatina labor (special row — outside ItemsControl, bound via RelativeSource) -->
                            <Grid Margin="{DynamicResource Gap.TableRowSm}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Работа за ламинатину"
                                               FontSize="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <Border CornerRadius="{DynamicResource Radius.Sm}"
                                            Background="{DynamicResource ChipBg}"
                                            HorizontalAlignment="Left"
                                            Padding="{DynamicResource Pad.Pill}"
                                            Margin="{DynamicResource Gap.BlockTopSm}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LaminatinaLabor.IsQuantityOverridden, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="ручн."
                                                   FontSize="{StaticResource Type.Caption}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         x:Name="TxtLaminatinaLaborQuantity"
                                         Tag="LaminatinaLaborQuantity"
                                         Style="{DynamicResource QuickInput}"
                                         Text="{Binding LaminatinaLabor.Quantity, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=F2, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         LostFocus="MaterialField_LostFocus"
                                         IsEnabled="{Binding HasCalculation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         FontSize="{StaticResource Type.Caption}"
                                         Margin="{DynamicResource Gap.InlineSm}"/>
                                <TextBox Grid.Column="2"
                                         x:Name="TxtLaminatinaLaborPrice"
                                         Tag="LaminatinaLaborPrice"
                                         Style="{DynamicResource QuickInput}"
                                         Text="{Binding LaminatinaLabor.Price, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=N2, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         LostFocus="MaterialField_LostFocus"
                                         IsEnabled="{Binding HasCalculation, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         FontSize="{StaticResource Type.Caption}"
                                         Margin="{DynamicResource Gap.InlineHSm}"/>
                                <TextBlock Grid.Column="3"
                                           x:Name="TxtLaminatinaLaborSumRow"
                                           Text="0.00"
                                           FontSize="{StaticResource Type.Caption}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CARD 3: ИТОГО МАТЕРИАЛОВ (на все откосы) -->
                <!-- v3.43.5: сводка общего расхода с экономией по каждому материалу. -->
                <Border x:Name="SummaryCard"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Md}"
                        Margin="{DynamicResource Gap.BlockLg}"
                        SnapsToDevicePixels="True"
                        Visibility="Collapsed">
                    <Grid>
                        <Border Width="4" HorizontalAlignment="Left"
                                Background="{DynamicResource Accent}"
                                CornerRadius="{DynamicResource Radius.StripeLeft}"/>
                        <StackPanel Margin="{DynamicResource Gap.PanelSection}">
                            <!-- Header -->
                            <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.BlockLg}">
                                <TextBlock Text="&#xE7B5;"
                                           Style="{DynamicResource FluentIconSection}"
                                           FontSize="{StaticResource Type.BodyLg}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SummaryTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontSize="{StaticResource Type.Body}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Summary rows -->
                            <ItemsControl x:Name="SummaryItems" Margin="{DynamicResource Gap.BlockSm}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{DynamicResource Gap.BlockSm}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto" MinWidth="75"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="{StaticResource Type.Caption}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{DynamicResource Gap.Left}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PerDetail}"
                                                           FontSize="{StaticResource Type.Caption}"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           VerticalAlignment="Center"/>
                                                <Border CornerRadius="{DynamicResource Radius.Sm}"
                                                        Background="{DynamicResource ChipBg}"
                                                        Padding="{DynamicResource Pad.Pill}"
                                                        Margin="{DynamicResource Gap.LeftSm}"
                                                        Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                                    <ToolTipService.ToolTip>
                                                        <TextBlock Text="{Binding EconomyTooltip}"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="280"/>
                                                    </ToolTipService.ToolTip>
                                                    <TextBlock Text="{Binding Note}"
                                                               FontSize="{StaticResource Type.Caption}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource EconomyGreen}"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TotalDisplay}"
                                                       FontSize="{StaticResource Type.Caption}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Hint when economy is enabled but nothing saved for these dimensions -->
                            <TextBlock x:Name="TxtNoSavingsHint"
                                       FontSize="{StaticResource Type.Caption}"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Margin="{DynamicResource Gap.BlockTop}"
                                       Visibility="Collapsed"
                                       Text="Для этих размеров общий раскрой не даёт дополнительной экономии материалов."/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- STICKY FOOTER — totals card + CTA                       -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <Border Grid.Row="1"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1,1,1,0"
            CornerRadius="{DynamicResource Radius.Top}"
            Margin="{DynamicResource Gap.None}"
            SnapsToDevicePixels="True">
        <Grid Margin="{DynamicResource Gap.PanelSection}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: stats & savings -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <!-- Без экономии -->
                <Grid x:Name="WithoutEconomyRow" Visibility="Collapsed" Margin="{DynamicResource Gap.BlockSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtWithoutEconomyLabel"
                               Grid.Column="0"
                               Text="Без экономии: "
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtWithoutEconomy"
                               Grid.Column="1"
                               Text="0.00"
                               FontSize="{StaticResource Type.Caption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource Gap.LeftSm}"/>
                </Grid>
                <!-- Общая экономия -->
                <Grid x:Name="TotalSavingsRow" Visibility="Collapsed" Margin="{DynamicResource Gap.BlockSm}">
                    <Grid.Resources>
                        <Storyboard x:Key="SavingsRowAppearStoryboard">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="1">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="8"/>
                                <EasingDoubleKeyFrame KeyTime="0:0:0.25" Value="0">
                                    <EasingDoubleKeyFrame.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </EasingDoubleKeyFrame.EasingFunction>
                                </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </Grid.Resources>
                    <Grid.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTotalSavingsLabel"
                               Grid.Column="0"
                               Text="Экономия:"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource Gap.LeftSm}">
                        <TextBlock x:Name="SavingsStarIcon"
                                   Text="&#xE1CF;"
                                   Style="{DynamicResource FluentIconButton}"
                                   FontSize="{StaticResource Type.Caption}"
                                   Foreground="{DynamicResource EconomyGreen}"
                                   VerticalAlignment="Center"
                                   Margin="{DynamicResource Gap.InlineSm}"/>
                        <TextBlock x:Name="TxtTotalSavings"
                                   Text="0.00"
                                   FontSize="{StaticResource Type.Caption}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource EconomyGreen}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                <!-- Средняя сумма за откос -->
                <TextBlock x:Name="TxtAvgWithEconomy"
                           Visibility="Collapsed"
                           FontSize="{StaticResource Type.Caption}"
                           Foreground="{DynamicResource EconomyGreen}"
                           Margin="{DynamicResource Gap.BlockSm}"
                           TextAlignment="Left"/>
            </StackPanel>

            <!-- Middle: Total with Economy Badge -->
            <Border x:Name="TotalAllRow" Grid.Column="1" Visibility="Collapsed"
                    Background="{DynamicResource EconomyGreenLight}"
                    CornerRadius="{DynamicResource Radius.Md}"
                    Padding="{DynamicResource Pad.Control}"
                    Margin="{DynamicResource Gap.InlineLg}"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTotalAllLabel"
                               Grid.Column="0"
                               Text=""
                               FontSize="{StaticResource Type.Body}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource EconomyGreen}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource Gap.Inline}"/>
                    <TextBlock x:Name="TxtTotalAll"
                               Grid.Column="1"
                               Text="0.00"
                               FontSize="{StaticResource Type.BodyLg}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource EconomyGreen}"
                               VerticalAlignment="Center"
                               MaxWidth="160"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- Right: Add to KP Button -->
            <Button x:Name="BtnAddToKp"
                    Grid.Column="2"
                    Style="{DynamicResource PrimaryButton}"
                    Click="BtnAddToKp_Click"
                    IsEnabled="False"
                    Height="40"
                    MinWidth="180"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="BtnIcon" Text="&#xE710;"
                               Style="{DynamicResource FluentIconButton}"
                               FontSize="{StaticResource Type.BodyLg}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource Gap.Inline}"/>
                    <TextBlock x:Name="BtnText" Text="Добавить в КП"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
    </Grid>
</UserControl>
