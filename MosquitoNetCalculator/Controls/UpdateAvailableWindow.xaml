<Window x:Class="MosquitoNetCalculator.Controls.UpdateAvailableWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступно обновление"
        Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        KeyDown="Window_KeyDown">
    <!-- Тень на пустой подложке, контент без Effect (ClearType-фикс). -->
    <Grid>
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}" Margin="{DynamicResource Gap.Window}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25"
                                  Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}"
                Margin="{DynamicResource Gap.Window}"
                SnapsToDevicePixels="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Version badge -->
                <RowDefinition Height="Auto"/>  <!-- Changelog -->
                <RowDefinition Height="Auto"/>  <!-- Hint -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="{DynamicResource Radius.CardHeader}"
                    Height="32"
                    Padding="{DynamicResource Pad.TitleBarH}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Доступно обновление"
                               FontSize="{StaticResource Type.Body}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <!-- UX-14: shared DialogCloseButton (was a private 60-line copy) -->
                    <Button Grid.Column="1"
                            Width="40" Height="40"
                            Style="{DynamicResource DialogCloseButton}"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Caption}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Version badge -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Accent}"
                    CornerRadius="{DynamicResource Radius.Md}"
                    Padding="{DynamicResource Pad.DialogBanner}"
                    HorizontalAlignment="Left"
                    Margin="{DynamicResource Gap.DialogBanner}">
                <TextBlock x:Name="VersionText"
                           FontSize="{StaticResource Type.BodyLg}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource OnAccent}"/>
            </Border>

            <!-- Changelog -->
            <ScrollViewer x:Name="ChangelogScroll"
                          Grid.Row="2"
                          MaxHeight="220"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="{DynamicResource Gap.DialogBanner}">
                <StackPanel x:Name="ChangelogPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="NoChangelogText"
                       Grid.Row="2"
                       Text="Список изменений недоступен."
                       FontSize="{StaticResource Type.Body}"
                       Foreground="{DynamicResource TextMuted}"
                       FontStyle="Italic"
                       Margin="{DynamicResource Gap.DialogBanner}"
                       Visibility="Collapsed"/>

            <!-- Hint -->
            <TextBlock Grid.Row="3"
                       Text="Приложение будет перезапущено после установки."
                       FontSize="{StaticResource Type.Body}"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap"
                       Margin="{DynamicResource Gap.EconomyDialog}"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource Gap.DialogFooterLg}">
                <Button x:Name="BtnCancel"
                        Content="Отмена"
                        Style="{DynamicResource GhostButton}"
                        MinWidth="90"
                        Padding="{DynamicResource Pad.DialogBtn}"
                        Margin="{DynamicResource Gap.Left}"
                        FontSize="{StaticResource Type.Body}"
                        FontWeight="Normal"
                        Cursor="Hand"
                        IsCancel="True"
                        Click="BtnCancel_Click"/>
                <StackPanel x:Name="DeferHintPanel"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            Margin="{DynamicResource Gap.LeftSm}"
                            Visibility="Collapsed">
                    <TextBlock Text="Не рекомендуется откладывать"
                               FontSize="{StaticResource Type.Caption}"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap"
                               MaxWidth="140"/>
                    <TextBlock Text="обновление надолго"
                               FontSize="{StaticResource Type.Caption}"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap"
                               MaxWidth="140"/>
                </StackPanel>
                <Button x:Name="BtnDownload"
                        Content="Скачать и установить"
                        Style="{DynamicResource SuccessButton}"
                        MinWidth="150"
                        Padding="{DynamicResource Pad.DialogBtn}"
                        Margin="{DynamicResource Gap.Left}"
                        FontSize="{StaticResource Type.Body}"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        IsDefault="True"
                        Click="BtnDownload_Click"/>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
