<Window x:Class="MosquitoNetCalculator.Controls.UpdateAvailableWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступно обновление"
        Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        KeyDown="Window_KeyDown">
    <!-- Тень на пустой подложке, контент без Effect (ClearType-фикс). -->
    <Grid>
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}" Margin="{DynamicResource Gap.Window}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.25"
                                  Color="{DynamicResource ShadowColor}"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}"
                Margin="{DynamicResource Gap.Window}"
                SnapsToDevicePixels="True">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="Auto"/>  <!-- Forced update badge -->
                <RowDefinition Height="Auto"/>  <!-- Version badge -->
                <RowDefinition Height="Auto"/>  <!-- Changelog -->
                <RowDefinition Height="Auto"/>  <!-- Manual update block -->
                <RowDefinition Height="Auto"/>  <!-- Hint -->
                <RowDefinition Height="Auto"/>  <!-- Buttons & Deferral chips -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="{DynamicResource Radius.CardHeader}"
                    Height="32"
                    Padding="{DynamicResource Pad.TitleBarH}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Доступно обновление"
                               FontSize="{StaticResource Type.Body}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <Button x:Name="BtnClose"
                            Grid.Column="1"
                            Width="32" Height="32"
                            Style="{DynamicResource DialogCloseButton}"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Caption}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Forced warning badge -->
            <Border x:Name="ForcedBadge"
                    Grid.Row="1"
                    Background="{DynamicResource BadgeDangerBg}"
                    BorderBrush="{DynamicResource Danger}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Md}"
                    Padding="{DynamicResource Pad.DialogBanner}"
                    HorizontalAlignment="Stretch"
                    Margin="{DynamicResource Gap.DialogBanner}"
                    Visibility="Collapsed">
                <TextBlock Text="🔒 Обязательное обновление: лимит откладываний (3 из 3) исчерпан. Для продолжения работы требуется установка обновления."
                           FontSize="{StaticResource Type.Caption}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Danger}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Version badge -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Accent}"
                    CornerRadius="{DynamicResource Radius.Md}"
                    Padding="{DynamicResource Pad.DialogBanner}"
                    HorizontalAlignment="Left"
                    Margin="{DynamicResource Gap.DialogBanner}">
                <TextBlock x:Name="VersionText"
                           FontSize="{StaticResource Type.BodyLg}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource OnAccent}"/>
            </Border>

            <!-- Changelog -->
            <ScrollViewer x:Name="ChangelogScroll"
                          Grid.Row="3"
                          MaxHeight="220"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="{DynamicResource Gap.DialogBanner}">
                <StackPanel x:Name="ChangelogPanel"/>
            </ScrollViewer>

            <TextBlock x:Name="NoChangelogText"
                       Grid.Row="3"
                       Text="Список изменений недоступен."
                       FontSize="{StaticResource Type.Body}"
                       Foreground="{DynamicResource TextMuted}"
                       FontStyle="Italic"
                       Margin="{DynamicResource Gap.DialogBanner}"
                       Visibility="Collapsed"/>

            <!-- Manual update block -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource Gap.DialogBanner}">
                <Button x:Name="BtnManualArchive"
                        Content="Выбрать ZIP-архив вручную..."
                        Style="{DynamicResource GhostButton}"
                        Padding="{DynamicResource Pad.DialogBtn}"
                        FontSize="{StaticResource Type.Caption}"
                        FontWeight="Normal"
                        Cursor="Hand"
                        Click="BtnManualArchive_Click"/>
                <TextBlock VerticalAlignment="Center" Margin="{DynamicResource Gap.Left}">
                    <Hyperlink x:Name="LnkGitHubReleases"
                               Foreground="{DynamicResource AccentText}"
                               FontSize="{StaticResource Type.Caption}"
                               Click="LnkGitHubReleases_Click">
                        GitHub Releases
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Hint -->
            <TextBlock Grid.Row="5"
                       Text="Приложение будет перезапущено после установки."
                       FontSize="{StaticResource Type.Body}"
                       Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap"
                       Margin="{DynamicResource Gap.EconomyDialog}"/>

            <!-- Buttons & Deferral Indicator -->
            <Grid Grid.Row="6" Margin="{DynamicResource Gap.DialogFooterLg}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Deferral Chips & Warning Text -->
                <StackPanel x:Name="DeferralPanel"
                            Grid.Column="0"
                            Orientation="Vertical"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            ToolTip="Обновление можно отложить не более 3 раз. На 4-й раз установка станет обязательной."
                            Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.BlockSm}">
                        <Border x:Name="Chip1" Width="24" Height="6"
                                CornerRadius="{DynamicResource Radius.CapsuleSm}"
                                Background="{DynamicResource SubtleBorder}"
                                Margin="{DynamicResource Gap.RightSm}"/>
                        <Border x:Name="Chip2" Width="24" Height="6"
                                CornerRadius="{DynamicResource Radius.CapsuleSm}"
                                Background="{DynamicResource SubtleBorder}"
                                Margin="{DynamicResource Gap.RightSm}"/>
                        <Border x:Name="Chip3" Width="24" Height="6"
                                CornerRadius="{DynamicResource Radius.CapsuleSm}"
                                Background="{DynamicResource SubtleBorder}"/>
                    </StackPanel>
                    <TextBlock x:Name="DeferralText"
                               Text="Отложено: 0 из 3. Осталось 3"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnCancel"
                            Content="Отложить"
                            Style="{DynamicResource GhostButton}"
                            MinWidth="90"
                            Padding="{DynamicResource Pad.DialogBtn}"
                            Margin="{DynamicResource Gap.Left}"
                            FontSize="{StaticResource Type.Body}"
                            FontWeight="Normal"
                            Cursor="Hand"
                            ToolTip="Обновление можно отложить не более 3 раз. На 4-й раз установка станет обязательной."
                            IsCancel="True"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnDownload"
                            Content="Скачать и установить"
                            Style="{DynamicResource SuccessButton}"
                            MinWidth="150"
                            Padding="{DynamicResource Pad.DialogBtn}"
                            Margin="{DynamicResource Gap.Left}"
                            FontSize="{StaticResource Type.Body}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            IsDefault="True"
                            Click="BtnDownload_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</Window>