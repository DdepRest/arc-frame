<UserControl x:Class="MosquitoNetCalculator.Controls.UpdatesTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MosquitoNetCalculator.Converters">
    <UserControl.Resources>
        <conv:ChangePartConverter x:Key="ChangePartConv"/>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- КАРТОЧКА ОБНОВЛЕНИЯ                                     -->
        <!-- v3.51: без анимации Loaded — список виртуализирован,      -->
        <!-- Storyboard переигрывался бы на каждом скролле.           -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Style x:Key="UpdateCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentLight}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Чип-фильтр типа (Все / Новинки / Улучшения / Исправления).
             Текст НЕактивного чипа — TextSecondary, не TextMuted: на ChipBg
             (светлая #EBF3FC / тёмная #26384C) muted даёт ≈4.3:1 — ниже AA
             для 11.5px; secondary держит ≥5.5:1 в обеих темах. -->
        <Style x:Key="ChipToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Lg}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bullet glyph for changes list.
             "•" (U+2022) sits at the visual centre of the line — unlike "—"
             (em-dash), which rests on the text baseline and looks like an
             underscore when the row is taller than one line. -->
        <Style x:Key="ChangeBulletStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>

        <!-- Change line text -->
        <Style x:Key="ChangeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Type.Body}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <!-- Заголовок годовой группы («2026») — пилюля на HeaderBg:
             структурирует список, в тёмной теме меньше «монотонной каши» -->
        <DataTemplate x:Key="YearGroupHeaderTemplate">
            <Border Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Md}"
                    Padding="{DynamicResource Pad.Pill}"
                    HorizontalAlignment="Left"
                    Margin="{DynamicResource Gap.BlockSm}">
                <TextBlock Text="{Binding Name}"
                           FontSize="{StaticResource Type.Body}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ШАПКА РАЗДЕЛА                                          -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="{DynamicResource Pad.DialogBody}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="История обновлений"
                           FontSize="{StaticResource Type.TitleLg}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="Все важные изменения в одном месте"
                           FontSize="{StaticResource Type.Body}"
                           Foreground="{DynamicResource TextMuted}"
                           Margin="{DynamicResource Gap.BlockTopSm}"/>
            </StackPanel>

            <!-- Диагностика связи: проверяет доступность каналов обновлений и показывает точные причины сбоя -->
            <Button x:Name="BtnDiagnostics"
                    Grid.Column="1"
                    Style="{StaticResource GhostButton}"
                    Margin="{DynamicResource Gap.InlineLg}"
                    VerticalAlignment="Center"
                    ToolTip="Проверить доступность каналов обновлений и показать точные причины сбоя"
                    Click="BtnDiagnostics_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE968;" FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{StaticResource Type.Body}" VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                    <TextBlock Text="Диагностика связи" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Счётчик версий справа: «N версий», при фильтре «N из M версий» -->
            <Border Grid.Column="2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ChipBg}"
                    CornerRadius="{DynamicResource Radius.Lg}"
                    Padding="{DynamicResource Pad.Row}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{DynamicResource Font.Icon}"
                               Text="&#xE81C;"
                               FontSize="{StaticResource Type.Caption}"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"
                               Margin="{DynamicResource Gap.Inline}"/>
                    <TextBlock x:Name="TxtUpdatesCount" Text="0 версий"
                               FontSize="{StaticResource Type.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- ФИЛЬТРЫ: чипы типа + поиск (v3.51)                     -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="{DynamicResource Pad.DialogBody}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="ChipFilterAll"
                              Style="{StaticResource ChipToggleStyle}"
                              IsChecked="True"
                              Content="Все"
                              ToolTip="Показать все версии"
                              Click="ChipTypeFilter_Click"/>
                <ToggleButton x:Name="ChipFilterNovelty"
                              Style="{StaticResource ChipToggleStyle}"
                              Content="Новинки"
                              ToolTip="Только «Новинка»"
                              Click="ChipTypeFilter_Click"/>
                <ToggleButton x:Name="ChipFilterImprovement"
                              Style="{StaticResource ChipToggleStyle}"
                              Content="Улучшения"
                              ToolTip="Только «Улучшение»"
                              Click="ChipTypeFilter_Click"/>
                <ToggleButton x:Name="ChipFilterFix"
                              Style="{StaticResource ChipToggleStyle}"
                              Content="Исправления"
                              ToolTip="Только «Исправление»"
                              Click="ChipTypeFilter_Click"/>
            </StackPanel>

            <Grid Grid.Column="1" MaxWidth="420" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;"
                           FontFamily="{DynamicResource Font.Icon}"
                           FontSize="{StaticResource Type.Body}" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                <Grid Grid.Column="1">
                    <!-- v3.51 hotfix: фон Surface (элeвированный, а не синеватый ChipBg —
                         в тёмной теме поле сливалось с карточками), без локального Padding:
                         он сдвигал реальный курсор (маржа шаблона 10 + padding) относительно
                         плейсхолдера — «палочка не в начале строки». Плейсхолдер выровнен
                         под контент-хост шаблона (10 маржа + 1 рамка = 11). -->
                    <TextBox x:Name="TxtUpdatesSearch"
                             Height="28" FontSize="{StaticResource Type.Body}"
                             Background="{DynamicResource Surface}"
                             BorderBrush="{DynamicResource Border}"
                             Foreground="{DynamicResource TextPrimary}"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtUpdatesSearch_TextChanged"
                             ToolTip="Поиск по номеру версии или тексту изменений"/>
                    <TextBlock x:Name="UpdatesSearchPlaceholder"
                               Text="Поиск: версия или текст"
                               Margin="{DynamicResource Gap.Left}"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource Type.Body}"
                               Foreground="{DynamicResource TextMuted}"
                               IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="BtnClearUpdatesSearch" Grid.Column="2"
                        Style="{DynamicResource GhostButton}"
                        Content="&#xE711;" FontFamily="{DynamicResource Font.Icon}"
                        FontSize="{StaticResource Type.Caption}" Padding="{DynamicResource Pad.ControlSm}" Margin="{DynamicResource Gap.LeftSm}" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="BtnClearUpdatesSearch_Click"
                        ToolTip="Очистить поиск"/>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- СПИСОК ВЕРСИЙ (виртуализированный, с группами по годам)  -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="UpdatesScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="{DynamicResource Pad.DialogBody}"
                          CanContentScroll="True"
                          ScrollChanged="UpdatesScroll_ScrollChanged">
                <!-- ItemsControl — прямой ребёнок ScrollViewer c CanContentScroll=True
                     для физической виртуализации карточек через VirtualizingStackPanel. -->
                <ItemsControl x:Name="UpdatesList"
                              ItemsSource="{Binding Updates}"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource YearGroupHeaderTemplate}"/>
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                  v3.51: карточка = всегда видимая компактная строка
                                  (тип · версия · заголовок · дата) + разворачиваемое
                                  тело. Первые 5 карточек раскрыты (UpdatesListLogic),
                                  остальные свёрнуты — длинная история не простыня.
                                -->
                                <Border Style="{StaticResource UpdateCardStyle}">
                                    <!-- Цветная полоса статуса слева — тип версии
                                         (Новинка/Улучшение/Исправление).
                                         v3.52.0 (владелец): полоса рисуется ЛЕВОЙ ГРАНИЦЕЙ
                                         внутреннего Border, а не отдельным прямоугольником
                                         Width=4: рамка Border обводит скруглённый контур, поэтому
                                         полоса повторяет радиус карточки. Квадратный
                                         прямоугольник торчал в скруглённом углу и выбивался из
                                         скруглённого дизайна (регрессия — CardStripeCornerTests).
                                         CornerRadius 11 = 12 (радиус карточки) минус 1px её рамки. -->
                                    <Border BorderThickness="4,0,0,0"
                                            CornerRadius="{DynamicResource Radius.StripeInner}">
                                        <Border.BorderBrush>
                                            <MultiBinding Converter="{StaticResource UpdateTypeBrush}" ConverterParameter="strong">
                                                <Binding Path="."/>
                                                <Binding Path="."/>
                                            </MultiBinding>
                                        </Border.BorderBrush>
                                    <StackPanel Margin="{DynamicResource Gap.PanelSection}">

                                        <!-- ─── Компактная строка (клик — разворот) ─── -->
                                        <Grid Cursor="Hand"
                                              MouseLeftButtonUp="CardHeader_Click"
                                              Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Бейдж типа (компактный): Type может быть
                                                 композитом («Новинка + Исправление») — ItemsControl
                                                 рисует по бейджу на каждый тип записи. -->
                                            <ItemsControl Grid.Column="0" VerticalAlignment="Center"
                                                          ItemsSource="{Binding Types}"
                                                          Focusable="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="{DynamicResource Radius.Md}"
                                                                Padding="{DynamicResource Pad.Pill}"
                                                                BorderThickness="0,0,6,0" BorderBrush="Transparent"
                                                                Background="{Binding Converter={StaticResource UpdateTypeBrush}, ConverterParameter=soft}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Converter={StaticResource UpdateTypeIcon}}"
                                                                           FontFamily="{DynamicResource Font.Icon}"
                                                                           FontSize="{StaticResource Type.Caption}"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding Converter={StaticResource UpdateTypeBrush}, ConverterParameter=fg}"/>
                                                                <TextBlock Text="{Binding}"
                                                                           FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Margin="{DynamicResource Gap.LeftSm}"
                                                                           Foreground="{Binding Converter={StaticResource UpdateTypeBrush}, ConverterParameter=fg}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Версия -->
                                            <TextBlock Grid.Column="1"
                                                       Margin="{DynamicResource Gap.Left}"
                                                       VerticalAlignment="Center">
                                                <Run Text="v" FontSize="{StaticResource Type.Caption}"
                                                     Foreground="{DynamicResource TextMuted}"/><Run Text="{Binding Version, Mode=OneWay}" FontSize="{StaticResource Type.BodyLg}" FontWeight="Bold"
                                                     Foreground="{Binding Type, Converter={StaticResource UpdateTypeBrush}, ConverterParameter=fg}"/>
                                            </TextBlock>

                                            <!-- Бейджи «Новейшая» и «Ваша версия» — видны в шапке карточки
                                                 как в свёрнутом, так и в развёрнутом виде -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center"
                                                        Margin="{DynamicResource Gap.Left}">
                                                <!-- Бейдж «Новейшая» — property-based, через IsLatest -->
                                                <Border CornerRadius="{DynamicResource Radius.Md}"
                                                        Padding="{DynamicResource Pad.Pill}"
                                                        Background="{DynamicResource AccentLight}"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE735;"
                                                                   FontFamily="{DynamicResource Font.Icon}"
                                                                   FontSize="{StaticResource Type.Caption}"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="{DynamicResource Gap.InlineSm}"/>
                                                        <TextBlock Text="Новейшая"
                                                                   FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Бейдж «Ваша версия» — совпадает с версией запущенного приложения -->
                                                <Border CornerRadius="{DynamicResource Radius.Md}"
                                                        Padding="{DynamicResource Pad.Pill}"
                                                        Background="{DynamicResource ChipBg}"
                                                        BorderBrush="{DynamicResource Border}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center"
                                                        Margin="{DynamicResource Gap.Left}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Version, Converter={StaticResource IsMyVersion}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE7C9;"
                                                                   FontFamily="{DynamicResource Font.Icon}"
                                                                   FontSize="{StaticResource Type.Caption}"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="{DynamicResource Gap.InlineSm}"/>
                                                        <TextBlock Text="Ваша версия"
                                                                   FontSize="{StaticResource Type.Caption}" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Заголовок (обрезается). В раскрытой карточке
                                                 скрывается — иначе заголовок видно дважды:
                                                 здесь и крупным шрифтом в теле. -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Title}"
                                                       FontSize="{StaticResource Type.Body}"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center"
                                                       Margin="{DynamicResource Gap.InlineH}"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Дата -->
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding Date, Converter={StaticResource RussianDateConv}}"
                                                       FontSize="{StaticResource Type.Caption}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Шеврон разворота -->
                                            <TextBlock Grid.Column="5"
                                                       Text="&#xE70D;"
                                                       FontFamily="{DynamicResource Font.Icon}"
                                                       FontSize="{StaticResource Type.Caption}"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       VerticalAlignment="Center"
                                                       Margin="{DynamicResource Gap.Left}"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform/>
                                                </TextBlock.RenderTransform>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>

                                        <!-- ─── Развёрнутое тело ─── -->
                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                    Margin="{DynamicResource Gap.BlockTopLg}">
                                            <!-- Заголовок полностью -->
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{StaticResource Type.BodyLg}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextWrapping="Wrap"
                                                       LineHeight="20"
                                                       Margin="{DynamicResource Gap.BlockLg}"/>

                                            <!-- ─── Список изменений: разделительная линия над телом
                                                 карточки — отделяет контент от шапки (меньше «каши») ─── -->
                                            <Border Height="1" Background="{DynamicResource Border}"
                                                    Opacity="0.6" Margin="{DynamicResource Gap.BlockLg}"/>
                                            <ItemsControl ItemsSource="{Binding Changes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- Микро-карточка изменения: подложка SectionBg, рамка,
                                                             скругление Radius.Control, акцентный маркер и
                                                             структурированный заголовок темы -->
                                                        <Border Background="{DynamicResource SectionBg}"
                                                                BorderBrush="{DynamicResource Border}"
                                                                BorderThickness="1"
                                                                CornerRadius="{DynamicResource Radius.Control}"
                                                                Padding="{DynamicResource Pad.Row}"
                                                                Margin="{DynamicResource Gap.Block}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Акцентный маркер по верхнему краю первой строки -->
                                                                <Border Grid.Column="0"
                                                                        Width="6" Height="6"
                                                                        CornerRadius="{DynamicResource Radius.CapsuleSm}"
                                                                        Background="{DynamicResource Accent}"
                                                                        VerticalAlignment="Top"
                                                                        Margin="{DynamicResource Gap.Inline}"/>

                                                                <!-- Текст изменения: выделенный полужирный заголовок темы + подробное описание -->
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Converter={StaticResource ChangePartConv}, ConverterParameter=topic}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="{StaticResource Type.Body}"
                                                                               Foreground="{DynamicResource TextPrimary}"
                                                                               Visibility="{Binding Converter={StaticResource ChangePartConv}, ConverterParameter=hasTopic}"
                                                                               Margin="{DynamicResource Gap.BlockSm}"/>
                                                                    <TextBlock Text="{Binding Converter={StaticResource ChangePartConv}, ConverterParameter=body}"
                                                                               FontSize="{StaticResource Type.Body}"
                                                                               Foreground="{DynamicResource TextSecondary}"
                                                                               TextWrapping="Wrap"
                                                                               LineHeight="20"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Скопировать карточку (для пересылки в чат) -->
                                            <Button Style="{DynamicResource GhostButton}"
                                                    HorizontalAlignment="Right"
                                                    Margin="{DynamicResource Gap.BlockTop}"
                                                    Padding="{DynamicResource Pad.Pill}"
                                                    FontSize="{StaticResource Type.Caption}"
                                                    Cursor="Hand"
                                                    ToolTip="Скопировать текст карточки — для пересылки в чат"
                                                    Click="CopyCard_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8C8;"
                                                               FontFamily="{DynamicResource Font.Icon}"
                                                               FontSize="{StaticResource Type.Caption}" VerticalAlignment="Center"
                                                               Margin="{DynamicResource Gap.Inline}"/>
                                                    <TextBlock Text="Скопировать" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
        </ScrollViewer>

        <!-- Пустой результат фильтра/поиска — поверх списка,
             вне ScrollViewer (контент ScrollViewer — ровно один элемент) -->
        <Border x:Name="UpdatesEmptyState"
                Style="{DynamicResource EmptyState.Card}"
                Padding="{DynamicResource Pad.EmptyPanel}"
                Margin="{DynamicResource Pad.DialogBody}"
                Visibility="Collapsed">
            <StackPanel Style="{DynamicResource EmptyState.Panel}" Margin="{DynamicResource Gap.None}">
                <TextBlock Text="&#xE721;"
                           Style="{DynamicResource EmptyState.IconSm}"/>
                <TextBlock Text="Ничего не найдено"
                           Style="{DynamicResource EmptyState.Title}"/>
                <TextBlock Text="Измените фильтр или очистите поиск"
                           Style="{DynamicResource EmptyState.Hint}"/>
            </StackPanel>
        </Border>

        <!-- Кнопка «Наверх»: видна после прокрутки примерно на экран -->
        <Button x:Name="BtnScrollTop"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="{DynamicResource Gap.UpdateFab}"
                    Style="{DynamicResource GhostButton}"
                    Padding="{DynamicResource Pad.Pill}"
                    FontSize="{StaticResource Type.Caption}"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    ToolTip="Наверх к новейшим версиям"
                    Click="BtnScrollTop_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74A;"
                               FontFamily="{DynamicResource Font.Icon}"
                               FontSize="{StaticResource Type.Caption}" VerticalAlignment="Center"
                               Margin="{DynamicResource Gap.InlineSm}"/>
                    <TextBlock Text="Наверх" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
