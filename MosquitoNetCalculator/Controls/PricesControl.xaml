<UserControl x:Class="MosquitoNetCalculator.Controls.PricesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource AppBg}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search bar -->
        <Border Grid.Row="0" Margin="8,8,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;"
                           FontFamily="{DynamicResource Font.Icon}"
                           FontSize="14" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="{DynamicResource Gap.Inline}"/>
                <TextBox x:Name="TxtSearchPrices" Grid.Column="1"
                         Style="{DynamicResource QuickInput}"
                         TextChanged="TxtSearchPrices_TextChanged"
                         ToolTip="Фильтр по наименованию или цвету"/>
                <Button x:Name="BtnClearPricesSearch" Grid.Column="2"
                        Style="{DynamicResource GhostButton}"
                        Content="&#xE711;" FontFamily="{DynamicResource Font.Icon}"
                        FontSize="11" Padding="4,2" Margin="{DynamicResource Gap.LeftSm}" Cursor="Hand"
                        Visibility="Collapsed"
                        Click="BtnClearPricesSearch_Click"
                        ToolTip="Очистить поиск"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource Radius.Card}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="8,0,8,6"
                Style="{DynamicResource Card}">
            <Grid>
                <DataGrid x:Name="PriceGrid"
                          ItemsSource="{Binding Prices}"
                          AlternationCount="2"
                          RowBackground="{DynamicResource Surface}"
                          AlternatingRowBackground="{DynamicResource RowAlt}"
                          Margin="2"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <DataGrid.RowStyle>
                        <StaticResource ResourceKey="PriceRow"/>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Width="*" MinWidth="100"
                                            Binding="{Binding Name}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Цвет" Width="Auto" MinWidth="65"
                                            Binding="{Binding Color}" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Цена, руб." Width="Auto" MinWidth="75"
                                            Binding="{Binding Price, Converter={StaticResource MoneyConv}, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state for prices list -->
                <StackPanel x:Name="PricesEmptyState"
                            Style="{DynamicResource EmptyState.Panel}"
                            Visibility="{Binding IsEmpty, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="" Style="{DynamicResource EmptyState.Icon}"/>
                    <!-- UX-08: readable title + actionable CTA instead of
                         description-only empty state. -->
                    <TextBlock Text="Справочник цен пуст"
                               Style="{DynamicResource EmptyState.Title}"/>
                    <TextBlock Text="Добавьте позиции в prices.json — или верните стандартный набор одной кнопкой"
                               Style="{DynamicResource EmptyState.Hint}"/>
                    <Button Style="{DynamicResource EmptyState.Action}"
                            Content="Восстановить стандартные цены"
                            Click="BtnResetPrices_Click"
                            ToolTip="Возвращает заводской прайс; текущие цены будут перезаписаны"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,0,8,8">
            <Button Style="{DynamicResource SuccessButton}"
                    Click="BtnSavePrices_Click" Margin="{DynamicResource Gap.Inline}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE74E;"/>
                    <TextBlock Text="Сохранить цены"/>
                </StackPanel>
            </Button>
            <!-- UX-08: reset is a secondary destructive action — DangerGhost
                 keeps it discoverable but doesn't compete with «Сохранить цены»
                 (the primary action of this toolbar) for attention. -->
            <Button Style="{DynamicResource DangerGhostButton}"
                    Click="BtnResetPrices_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{DynamicResource FluentIconButton}" Text="&#xE777;"/>
                    <TextBlock Text="Сбросить по умолчанию"/>
                </StackPanel>
            </Button>
            <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" Text="prices.json"/>
        </StackPanel>
    </Grid>
</UserControl>
