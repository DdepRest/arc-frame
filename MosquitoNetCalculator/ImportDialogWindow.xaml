<Window x:Class="MosquitoNetCalculator.ImportDialogWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выберите заказы для импорта"
        Width="550" Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="false"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        >
    <Border Background="{DynamicResource Surface}" ClipToBounds="True"
            BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Lg}" Padding="4" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="2" Opacity="0.12"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border x:Name="TitleBarBorder" Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="{DynamicResource Radius.CardHeader}"
                    Height="32"
                    Padding="14,0,0,0"
                    MouseLeftButtonDown="TitleBarBorder_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button Grid.Column="1"
                            Width="40" Height="40"
                            Style="{DynamicResource DialogCloseButton}"
                            ToolTip="Закрыть"
                            Click="BtnClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="16">
                <TextBlock x:Name="HeaderText"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="BtnSelectAll"
                            Content="Выбрать все"
                            Style="{DynamicResource GhostButton}"
                            FontSize="11"
                            Margin="0,0,8,0"/>
                    <Button x:Name="BtnDeselectAll"
                            Content="Снять все"
                            Style="{DynamicResource GhostButton}"
                            FontSize="11"/>
                </StackPanel>

                <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListStack"/>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="BtnCancel"
                            Content="Отмена"
                            Style="{DynamicResource GhostButton}"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnOk"
                            Content="Импортировать"
                            Style="{DynamicResource PrimaryButton}"
                            IsDefault="True"
                            Click="BtnOk_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
