<Window x:Class="MosquitoNetCalculator.ImportDialogWindow"
        Style="{DynamicResource Window.Shared}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выберите заказы для импорта"
        Width="550" Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="false"
        Icon="pack://application:,,,/Resources/app_icon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        >
    <!-- Тень на подложке, контент без Effect (ClearType-фикс, см. MiscStyles). -->
    <Grid>
        <Border Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}" Margin="{DynamicResource Gap.Window}">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="20" ShadowDepth="2" Opacity="0.12"/>
            </Border.Effect>
        </Border>
        <Border Background="{DynamicResource Surface}" ClipToBounds="True"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Lg}" Padding="{DynamicResource Pad.ControlSm}" Margin="{DynamicResource Gap.Window}">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border x:Name="TitleBarBorder" Grid.Row="0"
                    Background="{DynamicResource HeaderBg}"
                    CornerRadius="{DynamicResource Radius.CardHeader}"
                    Height="32"
                    Padding="{DynamicResource Pad.TitleBar}"
                    MouseLeftButtonDown="TitleBarBorder_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               FontSize="{StaticResource Type.Body}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button Grid.Column="1"
                            Width="40" Height="40"
                            Style="{DynamicResource DialogCloseButton}"
                            ToolTip="Закрыть"
                            Click="BtnClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource Font.Icon}" FontSize="{StaticResource Type.Caption}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Row="1" Margin="{DynamicResource Gap.Panel}">
                <TextBlock x:Name="HeaderText"
                           FontSize="{StaticResource Type.Body}"
                           Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap"
                           Margin="{DynamicResource Gap.Block10}"/>

                <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.Block}">
                    <Button x:Name="BtnSelectAll"
                            Content="Выбрать все"
                            Style="{DynamicResource GhostButton}"
                            FontSize="{StaticResource Type.Caption}"
                            Margin="{DynamicResource Gap.Inline}"/>
                    <Button x:Name="BtnDeselectAll"
                            Content="Снять все"
                            Style="{DynamicResource GhostButton}"
                            FontSize="{StaticResource Type.Caption}"/>
                </StackPanel>

                <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ListStack"/>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{DynamicResource Gap.BlockTopLg}">
                    <Button x:Name="BtnCancel"
                            Content="Отмена"
                            Style="{DynamicResource GhostButton}"
                            Margin="{DynamicResource Gap.Inline}"
                            IsCancel="True"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnOk"
                            Content="Импортировать"
                            Style="{DynamicResource PrimaryButton}"
                            IsDefault="True"
                            Click="BtnOk_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
