<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <!-- Mirror of the main project's TreatWarningsAsErrors=true. Test code
         is included by InternalsVisibleTo, so any test-side warning would
         otherwise slip past CI silently. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="xunit" Version="2.7.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MosquitoNetCalculator\MosquitoNetCalculator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden offline AI regression suite (real manager phrases + recorded model responses). -->
    <None Update="AI\golden-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Fixture for the bundled-Tesseract OCR smoke test (rendered text). -->
    <None Update="fixtures\ocr-fixture.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
